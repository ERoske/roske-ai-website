    --ac-muted: #b8ac93;
    --ac-line: #3a3128;
    --ac-accent: #f0a63a;
    --ac-second: #86e0cb;
    --ac-texture: radial-gradient(ellipse at 20% 0%, rgba(240, 166, 58, 0.07) 0%, rgba(240, 166, 58, 0) 55%);
  }
  [data-theme="light"] {
    --ac-bg: #f2e9d5;
    --ac-surface: #fbf6ea;
    --ac-band: #e8dcc2;
    --ac-ink: #1d1711;
    --ac-muted: #584c3b;
    --ac-line: #d3c4a3;
    --ac-accent: #9b1c1c;
    --ac-second: #1f3864;
    --ac-texture: repeating-linear-gradient(0deg, rgba(29, 23, 17, 0.022) 0 1px, transparent 1px 4px);
  }

  .ac-wrap { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; position: relative; }
  .ac-section { padding: 5.5rem 0; background: var(--ac-bg); color: var(--ac-ink); position: relative; }
  .ac-section::before { content: ''; position: absolute; inset: 0; background: var(--ac-texture); pointer-events: none; }
  .ac-band { background: var(--ac-band); }
  .ac-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---------- type ---------- */
  .ac-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ac-accent);
