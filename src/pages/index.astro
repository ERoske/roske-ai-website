      var el = document.querySelector('[data-ycs-type]');
      if (!el) return;
      var cmd = el.getAttribute('data-cmd') || '';
      var out = el.getAttribute('data-out') || '';
      var cmdEl = el.querySelector('.ycs-type-cmd');
      var outEl = el.querySelector('.ycs-type-out');
      if (!cmdEl || !outEl) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) {
        cmdEl.textContent = cmd;
        outEl.textContent = out;
        el.classList.add('done');
        return;
      }
      var i = 0;
      var j = 0;
      function typeOut() {
        if (j <= out.length) {
          outEl.textContent = out.slice(0, j);
          j += 1;
          setTimeout(typeOut, 12);
        } else {
          el.classList.add('done');
        }
      }
      function typeCmd() {
        if (i <= cmd.length) {
          cmdEl.textContent = cmd.slice(0, i);
          i += 1;
          setTimeout(typeCmd, 34);
        } else {
          setTimeout(typeOut, 450);
        }
      }
      setTimeout(typeCmd, 400);
