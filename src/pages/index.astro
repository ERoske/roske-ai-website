  }
  [data-theme="dark"] .br-h1-script { color: var(--br-neon); text-shadow: 0 0 14px rgba(255, 111, 138, 0.5); }

  .br-hero-sub {
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    font-weight: 700;
    color: var(--br-text);
    margin: 0 0 1rem;
    line-height: 1.4;
  }
  .br-hero-desc {
    color: var(--br-muted);
    line-height: 1.75;
    font-size: 1.02rem;
    margin: 0 0 1.8rem;
    max-width: 62ch;
  }
  .br-hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  .br-hero-fig { margin: 0; }
  .br-frame-hero { transform: rotate(1deg); }
  .br-hero-rosette { position: absolute; top: -26px; right: -18px; transform: rotate(10deg); z-index: 3; }
  .br-hero-cap {
    font-family: var(--br-hand);
    font-size: 1.25rem;
    line-height: 1.35;
    color: var(--br-muted);
    margin: 1.2rem 0 0 0.4rem;
    max-width: 52ch;
  }

  .br-stubs {
    list-style: none;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .br-stub {
    position: relative;
    background: var(--br-gold);
    color: #1b1a2e;
    padding: 1rem 1.2rem 1rem 1.6rem;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    /* ticket notches */
    -webkit-mask: radial-gradient(circle 9px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 9px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
            mask: radial-gradient(circle 9px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 9px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
  }
  .br-stub::after {
    content: '';
    position: absolute;
    top: 10px; bottom: 10px; right: 26%;
    border-right: 2px dashed rgba(27, 26, 46, 0.35);
  }
  .br-stub-v { font-family: var(--font-heading); font-size: 2.1rem; line-height: 1; }
  .br-stub-k { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; max-width: 70%; }

  /* ---------- the judging ---------- */
  .br-judging {
    padding: 5rem 0 5.5rem;
    background-color: var(--br-peg);
    background-image: radial-gradient(var(--br-peg-dot) 2.2px, transparent 2.6px);
    background-size: 26px 26px;
    border-top: 6px solid var(--br-blue);
  }
  .br-judging-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 3rem;
    align-items: start;
    margin-bottom: 3rem;
  }
  .br-rules {
    background: var(--br-paper);
