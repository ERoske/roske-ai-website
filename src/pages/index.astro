    text-transform: uppercase;
    color: #9fb3ad;
    white-space: nowrap;
    line-height: 2;
  }
  .er-strip-mark { color: var(--er-amber); }

  /* ---------- hero ---------- */
  .er-hero {
    position: relative;
    background: var(--er-bg);
    padding: clamp(3rem, 7vw, 6rem) 1.5rem clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }
  .er-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--er-lamp), var(--er-wood);
  }
  .er-hero-grid {
    position: relative;
    max-width: 84rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
