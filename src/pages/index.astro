---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// ---------------------------------------------------------------------------
// T-MINUS ZERO (2026-11-07). Godzilla Minus Zero opened Friday, November 6.
// Every monster movie has a committee meeting in it, held while the monster
// is already in the harbor. Edward tries the 5 ways companies keep dealing
// with AI, fails at all 5, then lays out the civilian plan and a readiness
// check that hands you a verdict. No companies are named. The monster is
// generic and AI-drawn, never the film's.
// ---------------------------------------------------------------------------

const IMG = '/images/t-minus-zero';
const CAL = 'https://calendar.app.google/udtTerQwcX9Z7QQt7';
const POST = '/blog/is-your-ai-task-force-still-meeting/';
const WTI = 'https://blogs.microsoft.com/blog/2024/05/08/microsoft-and-linkedin-release-the-2024-work-trend-index-on-the-state-of-ai-at-work/';
const SHADOW = 'https://fortune.com/2025/08/19/shadow-ai-economy-mit-study-genai-divide-llm-chatbots/';
const BOXOFFICE = 'https://deadline.com/2026/11/box-office-godzilla-minus-zero-cat-in-the-hat-1237215161/';

// The 4 standing numbers. Same every week.
const stats = [
  { v: '80+', k: 'Countries visited' },
  { v: '50+', k: 'Countries spoken in' },
  { v: '15', k: 'Books' },
  { v: '25', k: 'Years running interRel' },
];

// The 5 attempts. Each one failed. The third line is the real point.
type Attempt = {
  name: string;
  img: string;
  w: number;
  h: number;
  shape: 'wide' | 'tall';
  alt: string;
  did: string;
  happened: string;
  really: string;
  link?: { href: string; text: string };
};

const attempts: Attempt[] = [
  {
    name: 'Form a task force',
    img: 'committee.jpg',
    w: 1600,
    h: 1195,
    shape: 'wide',
    alt: 'Edward in his blue fedora stands at the head of a long boardroom table with a laser pointer, presenting a projected slide that reads "AI Task Force: Phase 1 Scoping" to a room of empty leather chairs and coffee cups, while an enormous glowing monster eye fills the rain-streaked window behind him. He hasn\'t noticed.',
    did: 'Formed an AI task force, booked the big conference room, and opened with Phase 1 Scoping.',
    happened: 'Phase 1 Scoping ran 6 weeks. The eye in the window attended every session and never once took a note (it didn\'t need to, it\'s seen this movie before, several times, going back to 1954).',
    really: 'Microsoft and LinkedIn found that by 2024, 75% of knowledge workers were already using AI at work, and 78% of those people were bringing their own tools. The task force is scoping something that started 2 years ago.',
    link: { href: WTI, text: 'Microsoft and LinkedIn found' },
  },
  {
    name: 'Ban it',
    img: 'policy.jpg',
    w: 1195,
    h: 1600,
    shape: 'tall',
    alt: 'On a rain-soaked pier at night, Edward in his blue fedora hammers a hand-painted wooden sign onto a post that reads "No monsters beyond this point, per Policy 4.2," looking pleased with himself, while a giant scaled monster rises out of the churning water right behind him.',
    did: 'Wrote Policy 4.2, painted it on a sign, and nailed it to the pier myself.',
    happened: 'The sign went up at 9:14 PM. The monster came by at 9:15 (for the record, the sign is still standing, which is more than I can say for the pier).',
    really: 'An MIT study in 2025 found workers at more than 90% of companies using personal chatbot accounts for daily tasks, while only 40% of companies had official subscriptions. A ban mostly moves the AI onto people\'s phones, where nobody can see what goes into it.',
    link: { href: SHADOW, text: 'An MIT study in 2025' },
  },
  {
    name: 'Wait for version 2',
    img: 'wait.jpg',
    w: 1600,
    h: 1195,
    shape: 'wide',
    alt: 'Edward in his blue fedora relaxes in a striped beach chair on an empty beach with binoculars and a thermos, a paperback titled "Wait for Version 2" on his lap, while a towering wave curls in and a giant monster wades ashore under searchlights behind him.',
    did: 'Set up a beach chair, a thermos, and a good book, and waited for the technology to mature.',
    happened: 'Version 2 came out while I was on chapter 1. So did 2.5, and then something that made 2.5 look quaint, all before the thermos got cold (it\'s a very good thermos, and it was the only part of this plan that worked).',
    really: 'Something better ships every few months, so if you\'re waiting for the good one, bring a bigger thermos. The people getting value started with whatever was on the shelf and swapped in the newer model when it showed up.',
  },
  {
    name: 'Commission a study',
    img: 'study.jpg',
    w: 1195,
    h: 1600,
    shape: 'tall',
    alt: 'On a wrecked, rainy city street at night, Edward in a white lab coat and his blue fedora kneels at the edge of a gigantic three-toed footprint pressed into the asphalt, holding out a small tape measure and a clipboard, next to a crumpled yellow taxi.',
    did: 'Put on a lab coat and commissioned a 90-page readiness assessment, starting with the footprint.',
    happened: 'My tape measure is 25 feet long. The footprint is not (I measured it 31 times and got 31 different numbers, which the final report rounds to "large").',
    really: 'One small real project teaches you more in 30 days than a readiness assessment does in 90, and you can still write the binder afterward if anybody asks for one.',
  },
  {
    name: 'Issue a statement',
    img: 'broadcast.jpg',
    w: 1600,
    h: 893,
    shape: 'wide',
    alt: 'In a cramped broadcast studio under a glowing red On Air sign, Edward in his blue fedora reads a sheet titled "Statement" into a vintage chrome microphone, a hand-drawn harbor map with a red X behind him, while a giant scaled monster strides past the rain-streaked studio window.',
    did: 'Went on air with a prepared statement announcing our AI strategy.',
    happened: 'The statement said we were closely monitoring the situation. The situation walked past the studio window during paragraph 2 and didn\'t stop to listen.',
    really: 'A press release about your AI strategy is fine to have. It just helps to also have somebody in the building whose actual workday changed because of it.',
  },
];

// The civilian plan. This is the part people screenshot.
const plan = [
  {
    step: 'Find out who\'s already using it.',
    note: 'Ask, and don\'t punish anybody for the answer. The people with personal ChatGPT accounts are your scouts, and they already know which jobs it\'s good at.',
  },
  {
    step: 'Give everyone a safe tool this month.',
    note: 'An approved tool with sensible rules about what data goes in beats a ban that sends everything to personal phones.',
  },
  {
    step: 'Pick 1 real problem with a number on it.',
    note: 'Something you already measure (hours, errors, turnaround time, tickets per week), so in 30 days you\'ll know whether it worked.',
  },
  {
    step: 'Put the people who do the work in charge.',
    note: 'The person who does the job every day knows which part of it is worth automating (it\'s usually the part they complain about at lunch).',
  },
  {
    step: 'Connect it to your real data.',
    note: 'An AI working from memory will give you a number that sounds about right. One that can read your actual systems can give you the actual number.',
  },
  {
    step: 'Set a date and a verdict.',
    note: 'Keep it or kill it based on the number from step 3, and roll it out wider if the number\'s good (whoever liked the demo most gets exactly 1 vote, same as everybody else).',
  },
];

// The readiness check. One box per step of the plan.
const checks = [
  'We know who\'s already using AI, and nobody got in trouble for saying so.',
  'There\'s an approved AI tool, and people actually use it.',
  'We have at least 1 AI project with a number attached to it.',
  'The people who do the work every day are the ones running it.',
  'It can read our real systems, so it answers with our actual numbers.',
  'There\'s a date on the calendar to look at the number and keep it or kill it.',
];

const levels = [
  { min: 0, max: 1, name: 'Still in the committee meeting', note: 'The eye is in the window. Turn around (slowly).' },
  { min: 2, max: 3, name: 'Boats in the water', note: 'You\'ve started. Give it a number and a date and you\'re most of the way there.' },
  { min: 4, max: 5, name: 'Organized civilians', note: 'This is what the people who save the city look like in every one of these movies.' },
  { min: 6, max: 6, name: 'Monster heading back out to sea', note: 'You should be the one giving this talk. Write me and tell me how you did it.' },
];

// Still standing: the 6 projects. Same 6 every week, restyled.
const projects = [
  {
    name: 'MCP Servers for Enterprise Finance',
    status: 'Shipping',
    note: `Plumbing so an AI reads the real number out of Oracle Essbase and EPM instead of remembering one that sounds about right. Essbase and EPM Planning have shipped, and Financial Close and Consolidations is in beta.`,
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    name: 'Caribbean AI Summit',
    status: 'Happened, October 9 and 10',
    note: `Co-chaired it: 800+ people, 17 countries, 44 speakers, and 6 fire extinguishers Dawn bought at Walmart at 7:30 in the morning. The whole story is on the blog.`,
    href: '/blog/how-many-fire-extinguishers-does-an-ai-summit-need/',
    external: false,
    cta: 'Read the recap',
  },
  {
    name: 'Caprus',
    status: 'Investor',
    note: `I'm an investor, and that's the whole job. Lillian Buziak runs it, and they sell and support AgentCube (the first card on this row), which spares everybody from having me do it.`,
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    name: 'Everest Base Camp',
    status: 'Done, April 2026',
    note: `2 weeks on foot to 18,571 feet with Dawn. The trail log is on the blog, including the last 400 feet of Kala Patthar.`,
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    name: "AI Dungeon Master's Screen",
    status: 'Quiet build',
    note: `A prototype screen for running 5e: lore lookups and improvisation help for the person behind the cardboard. It isn't public yet, and so far the only customer is me (and my players, who didn't get a vote).`,
    href: null,
    external: false,
    cta: 'No public link (take my word for it)',
  },
  {
    name: 'Puerto Rico AI Community',
    status: 'Every other month',
    note: `President of the island's AI community (unpaid, obviously), now past 1,000 different people through the door. Bi-monthly, free, both languages, and the reason the summit exists at all.`,
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title="Roske.AI | T-Minus Zero"
  description="Godzilla Minus Zero week on roske.ai: Edward Roske tries the 5 ways companies keep dealing with AI (task force, ban, wait, study, statement), fails at all 5, then lays out the 6-step civilian plan that actually works, plus a readiness check."
>
  <WeeklyAnimation />

  <!-- ================= EMERGENCY TICKER ================= -->
  <div class="tm-ticker" role="note" aria-label="Emergency broadcast">
    <div class="tm-wrap tm-ticker-inner">
      <span class="tm-ticker-dot" aria-hidden="true"></span>
      <span>Emergency broadcast</span>
      <span>Saturday, November 7, 2026</span>
      <span>San Juan</span>
      <span>This is not a drill (it's a website)</span>
    </div>
  </div>

  <!-- ================= HERO: THE HARBOR ================= -->
  <section class="tm-hero" aria-labelledby="tm-title">
    <figure class="tm-hero-fig">
      <img
        class="tm-hero-img"
        src={`/images/${theme.hero.heroImage}`}
        alt={theme.hero.imageAlt}
        width="1600"
        height="893"
        fetchpriority="high"
        decoding="async"
      />
      <div class="tm-hero-shade" aria-hidden="true"></div>
      <div class="tm-wrap tm-hero-over">
        <p class="tm-hero-label">Sighting No. 1 | The harbor, 11:52 PM</p>
        <p class="tm-hero-quote">&ldquo;Have a safe trip!&rdquo;</p>
        <h1 class="tm-title" id="tm-title">T-minus <span>zero</span></h1>
      </div>
    </figure>

    <div class="tm-wrap tm-hero-grid">
      <div class="tm-hero-copy">
        <p class="tm-kicker">
          Godzilla Minus Zero opened Friday (Edward, the movie is called Minus Zero, not T-minus zero, and you know
          that. Yes, and I'm choosing to hear it my way, because it's my website).
        </p>
        <p class="tm-sub">{theme.hero.subtitle}</p>
        <p class="tm-lede">
          So I spent the week trying the 5 ways companies keep trying to deal with AI, from forming a task force to
          nailing a policy to a pier, and I wrote up every attempt so you don't have to repeat any of them (the
          monster was unimpressed by all 5, and in fairness, so was I). Then I wrote down what actually saves the city
          in every one of these movies, which is ordinary people with a plan.
        </p>
        <div class="tm-ctas">
          <a class="tm-btn tm-btn-red" href={theme.hero.ctaLink}>{theme.hero.ctaText}</a>
          <a class="tm-btn tm-btn-ghost" href="#plan">Skip to what works</a>
        </div>
      </div>

      <aside class="tm-clock" aria-label="Countdown">
        <p class="tm-clock-label">Time left to prepare</p>
        <p class="tm-clock-digits" aria-hidden="true">00:00:00</p>
        <p class="tm-clock-note">
          It ran out on November 30, 2022, the day ChatGPT launched (give or take a press release), and it's been
          sitting at 00:00:00 ever since, which I realize makes it less of a countdown and more of a very dramatic broken
          clock.
        </p>
      </aside>
    </div>
  </section>

  <!-- ================= STATS: DAMAGE REPORT ================= -->
  <div class="tm-stats-wrap">
    <ul class="tm-wrap tm-stats" aria-label="On the record">
      {stats.map((s) => (
        <li><span class="tm-stat-v">{s.v}</span><span class="tm-stat-k">{s.k}</span></li>
      ))}
    </ul>
  </div>

  <!-- ================= DISPATCHES ================= -->
  <LatestContent
    eyebrow="Dispatches from the shoreline"
    heading="New <em>this week.</em>"
    deck="This week's writing and video, newest first, including today's post on what to do if your AI task force is still meeting (it probably is)."
  />

  <!-- ================= THE 5 ATTEMPTS ================= -->
  <section class="tm-section tm-attempts" id="attempts" aria-labelledby="tm-attempts-title">
    <div class="tm-wrap">
      <header class="tm-head">
        <p class="tm-eyebrow">Field reports</p>
        <h2 class="tm-h2" id="tm-attempts-title">5 attempts and 1 very patient monster.</h2>
        <p class="tm-deck">
          Every one of these is something companies are really doing about AI right now, and you can probably name one
          that's done at least 2 of them before lunch (I'm not naming any, partly because I'd like to keep getting
          invited to things, and mostly because it's a lot of them).
        </p>
      </header>

      <ol class="tm-reports">
        {attempts.map((a, i) => (
          <li class={`tm-report tm-report-${a.shape} ${i % 2 ? 'tm-report-flip' : ''}`}>
            <figure class="tm-report-fig">
              <img src={`${IMG}/${a.img}`} alt={a.alt} width={a.w} height={a.h} loading="lazy" decoding="async" />
              <span class="tm-stamp" aria-hidden="true">Failed</span>
            </figure>
            <div class="tm-report-body">
              <p class="tm-report-no">Attempt {pad(i + 1)}</p>
              <h3 class="tm-report-name">{a.name}</h3>
              <dl class="tm-report-dl">
                <div>
                  <dt>What I did</dt>
                  <dd>{a.did}</dd>
                </div>
                <div>
                  <dt>What happened</dt>
                  <dd>{a.happened}</dd>
                </div>
                <div class="tm-report-real">
                  <dt>What's really going on out there</dt>
                  <dd>
                    {a.link ? (
                      <>
                        {a.really.slice(0, a.really.indexOf(a.link.text))}
                        <a href={a.link.href} target="_blank" rel="noopener noreferrer">{a.link.text}</a>
                        {a.really.slice(a.really.indexOf(a.link.text) + a.link.text.length)}
                      </>
                    ) : (
                      a.really
                    )}
                  </dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= BOOK EDWARD ================= -->
  <SpeakerCTA eyebrow="Bring in somebody who's been stepped on before" />

  <!-- ================= THE CIVILIAN PLAN ================= -->
  <section class="tm-plan" id="plan" aria-labelledby="tm-plan-title">
    <figure class="tm-plan-fig">
      <img
        src={`${IMG}/civilians.jpg`}
        alt="On a rainy harbor dock at first light, Edward in his blue fedora stands on a concrete ledge with a megaphone, directing a crew of ordinary people below (fishermen in overalls, an office worker in a dress shirt) who are hauling ropes and steering small boats, while the giant monster looms in the mist just offshore."
        width="1600"
        height="893"
        loading="lazy"
        decoding="async"
      />
      <figcaption>It hadn't left yet, but for the first time all week there was a plan (and a megaphone, which helps more than you'd think).</figcaption>
    </figure>

    <div class="tm-wrap">
      <header class="tm-head tm-plan-head">
        <p class="tm-eyebrow tm-eyebrow-dawn">The civilian plan</p>
        <h2 class="tm-h2 tm-h2-dawn" id="tm-plan-title">So what actually saves the city?</h2>
        <p class="tm-deck tm-deck-dawn">
          In the good monster movies, it's a handful of ordinary people with the right skills (somebody who knows boats,
          and somebody stubborn enough to keep asking questions in the meeting) who get organized around 1 specific job
          and go do it, usually while the committee is still in the conference room. I've been around for 4 of these
          landfalls in my career, client-server, the web, the cloud, and now this one, which is the biggest by a mile,
          and every time, the people who came out fine were the ones who got organized around a real problem.
        </p>
      </header>

      <ol class="tm-steps">
        {plan.map((p, i) => (
          <li class="tm-step">
            <span class="tm-step-no" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="tm-step-name">{p.step}</h3>
            <p class="tm-step-note">{p.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= THREAT ASSESSMENT ================= -->
  <section class="tm-check" id="check" aria-labelledby="tm-check-title" data-tm-check>
    <div class="tm-wrap tm-check-grid">
      <div class="tm-check-main">
        <p class="tm-eyebrow tm-eyebrow-pinned">Threat assessment</p>
        <h2 class="tm-h2 tm-h2-pinned" id="tm-check-title">What's your T-minus?</h2>
        <p class="tm-check-intro">
          Check the ones that are true at your company today. Be honest (the checkboxes don't send anything anywhere,
          I made sure of it, so the only person who'll know is you).
        </p>
        <ul class="tm-boxes">
          {checks.map((c, i) => (
            <li>
              <label class="tm-box">
                <input type="checkbox" data-tm-box />
                <span class="tm-box-mark" aria-hidden="true"></span>
                <span class="tm-box-text"><span class="tm-box-no">{pad(i + 1)}</span> {c}</span>
              </label>
            </li>
          ))}
        </ul>
      </div>

      <div class="tm-board">
        <p class="tm-board-score"><span data-tm-score>0</span> of 6</p>
        <ol class="tm-levels">
          {levels.map((l, i) => (
            <li class={`tm-level ${i === 0 ? 'is-on' : ''}`} data-min={l.min} data-max={l.max}>
              <span class="tm-level-range">{l.min === l.max ? l.min : `${l.min} to ${l.max}`}</span>
              <span class="tm-level-name">{l.name}</span>
              <span class="tm-level-note">{l.note}</span>
            </li>
          ))}
        </ol>
        <p class="tm-board-live" aria-live="polite" data-tm-live></p>
      </div>
    </div>
  </section>

  <!-- ================= STILL STANDING ================= -->
  <section class="tm-section tm-band" id="building" aria-labelledby="tm-real-title">
    <div class="tm-wrap">
      <header class="tm-head">
        <p class="tm-eyebrow">Still standing</p>
        <h2 class="tm-h2" id="tm-real-title">What I'm building (all 6 survived the landfall).</h2>
        <p class="tm-deck">
          Same 6 projects as every week. The footprint missed every one of them, which I'll take as a compliment, and 5 of the 6 have a link you can check (the 6th is a D&amp;D tool you'll have to take my word
          for).
        </p>
      </header>
      <ul class="tm-projects">
        {projects.map((p, i) => (
          <li class="tm-project">
            <div class="tm-project-top">
              <span class="tm-project-no">Structure {pad(i + 1)}</span>
              <span class="tm-project-dmg">Damage: none</span>
            </div>
            <h3 class="tm-project-name">{p.name}</h3>
            <p class="tm-project-status">{p.status}</p>
            <p class="tm-project-note">{p.note}</p>
            {p.href ? (
              <a
                class="tm-project-link"
                href={p.href}
                {...(p.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {p.cta}
              </a>
            ) : (
              <span class="tm-project-link tm-project-link-off">{p.cta}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= OTHER SIGHTINGS ================= -->
  <WhatsNew
    eyebrow="Other sightings"
    heading="Reported <em>elsewhere.</em>"
    deck="Interviews, press, and posts from around the web, for anyone who'd like a second eyewitness."
  />

  <!-- ================= THIS WEEK'S QUESTION ================= -->
  <section class="tm-section tm-question" aria-labelledby="tm-q-title">
    <div class="tm-wrap tm-question-inner">
      <p class="tm-eyebrow">This week's question</p>
      <h2 class="tm-h2 tm-h2-big" id="tm-q-title">Is your AI task force still meeting?</h2>
      <p class="tm-copy">
        Godzilla Minus Zero opened in North America on Friday after
        <a href={BOXOFFICE} target="_blank" rel="noopener noreferrer">$6.7 million in Thursday previews</a>,
        which tells me a lot of people still want to watch a city deal with something enormous, even when (especially
        when) the city's handling it badly for the first hour. I saw it in London at the BFI IMAX, the biggest screen
        in the United Kingdom, and it's quite good: amazing battle scenes, and it really captures a Japanese perspective
        on the disaster-horror movie that you don't get to see very often (I'd recommend it, whether or not you currently
        run a task force).
      </p>
      <p class="tm-copy">
        The longer version, for whoever has to sit in that conference room on Monday, is <a href={POST}>on the blog</a>
        today (I tried to keep the monster out of it and lasted about 1 sentence).
      </p>
    </div>
  </section>

  <!-- ================= CALL IT IN ================= -->
  <section class="tm-door" aria-labelledby="tm-door-title">
    <div class="tm-wrap tm-door-inner">
      <p class="tm-eyebrow tm-eyebrow-pinned">Call it in</p>
      <h2 class="tm-h2 tm-h2-pinned" id="tm-door-title">Need somebody who's been stepped on before?</h2>
      <p class="tm-copy-pinned">
        If you'd like the civilian plan explained out loud to your leadership team, by a man in a fedora who's been
        flattened by 4 of these and got up every time (slightly flatter, but upright, and the fedora never came off),
        that's the speaking page, with keynotes from $15,000. If you'd rather just talk, 13 minutes on my calendar is
        free! Or write me at Edward@Roske.AI and tell me what your task force is scoping this week.
      </p>
      <div class="tm-ctas">
        <a class="tm-btn tm-btn-red" href="/speaking/">Book the talk</a>
        <a class="tm-btn tm-btn-ghost-pinned" href={CAL} target="_blank" rel="noopener noreferrer">Book 13 minutes</a>
        <a class="tm-btn tm-btn-ghost-pinned" href="/contact/">Write me</a>
      </div>
      <p class="tm-disclaimer">
        Every image of Edward on this page is AI-generated from his real headshot (without glasses this week, since he
        doesn't wear them and the AI had been adding them anyway). The monster was drawn by an AI that has obviously
        seen a few movies, and nothing here is affiliated with Godzilla Minus Zero, Toho, or anybody's actual harbor.
        No companies are named on this page, on purpose, and no task forces were harmed (they're still meeting).
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-tm-check]');
      if (!root) return;
      var boxes = root.querySelectorAll('[data-tm-box]');
      var levels = root.querySelectorAll('.tm-level');
      var score = root.querySelector('[data-tm-score]');
      var live = root.querySelector('[data-tm-live]');
      function update(announce) {
        var n = 0;
        boxes.forEach(function (b) { if (b.checked) n++; });
        score.textContent = n;
        var name = '';
        levels.forEach(function (l) {
          var on = n >= +l.dataset.min && n <= +l.dataset.max;
          l.classList.toggle('is-on', on);
          if (on) name = l.querySelector('.tm-level-name').textContent;
        });
        if (announce) live.textContent = n + ' of 6: ' + name + '.';
      }
      boxes.forEach(function (b) { b.addEventListener('change', function () { update(true); }); });
      update(false);
    })();
  </script>
</BaseLayout>

