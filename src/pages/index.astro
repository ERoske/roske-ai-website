  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .hero-fig { margin: 0; }
  .hero-frame {
    position: relative; border: 3px solid; overflow: hidden;
  }
  :global([data-theme="dark"]) .hero-frame { border-color: var(--color-border); background: var(--color-surface); }
