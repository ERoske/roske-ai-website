    transition: transform 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }
  .br-btn-solid {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border: 2px solid var(--color-accent);
    box-shadow: 3px 3px 0 var(--br-red);
  }
  .br-btn-solid:hover { background: var(--color-accent-hover); transform: translate(-1px, -1px); }
  .br-btn-line {
    background: transparent;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
  }
  .br-btn-line:hover { transform: translate(-1px, -1px); }
  .br-btn-line-dark { color: var(--br-gold); border-color: var(--br-gold); }

  /* ---------- admission strip ---------- */
  .br-strip {
    background: var(--br-red);
    color: #fffaf0;
    border-bottom: 3px dashed rgba(255, 250, 240, 0.55);
    overflow: hidden;
  }
  .br-strip-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0.55rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .br-strip-item { white-space: nowrap; }
  .br-strip-item + .br-strip-item::before { content: '\2605'; margin-right: 1.4rem; opacity: 0.7; }
  .br-strip-mark { font-weight: 500; }

  /* ---------- bunting ---------- */
  .br-bunting {
    height: 34px;
    background-image: var(--br-bunting-img);
    background-repeat: repeat-x;
    background-size: 150px 34px;
  }

  /* ---------- rosettes ---------- */
  .br-rosette {
    --c: #1c4a96;
    --c2: #143a7a;
    --face-ink: #23201c;
    position: relative;
    display: inline-block;
    width: 92px;
    height: 132px;
    flex: none;
  }
  .br-rosette-disc {
    position: absolute;
    top: 0; left: 0;
    width: 92px; height: 92px;
    border-radius: 50%;
    background: repeating-conic-gradient(from 0deg, var(--c) 0 7deg, var(--c2) 7deg 14deg);
    display: grid;
    place-items: center;
    box-shadow: 0 6px 14px -6px rgba(0, 0, 0, 0.55);
    z-index: 2;
  }
  .br-rosette-face {
    width: 58%; height: 58%;
    border-radius: 50%;
    background: #fffaf0;
    border: 3px solid var(--c);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--face-ink);
    line-height: 1;
  }
  .br-rosette::before,
  .br-rosette::after {
    content: '';
    position: absolute;
    top: 60px;
    width: 28px;
    height: 70px;
    background: var(--c);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 84%, 0 100%);
    z-index: 1;
  }
  .br-rosette::before { left: 18px; transform: rotate(9deg); }
  .br-rosette::after { right: 18px; transform: rotate(-9deg); background: var(--c2); }

  .br-rosette-blue { --c: #1c4a96; --c2: #143a7a; }
  .br-rosette-red { --c: #b52a24; --c2: #8c1f1a; }
  .br-rosette-yellow { --c: #e8b830; --c2: #c9971a; }
  .br-rosette-white { --c: #efe9dc; --c2: #d4ccbb; }
  .br-rosette-purple { --c: #6b3fa0; --c2: #52307c; }
  .br-rosette-green { --c: #2f7a3d; --c2: #225c2d; }
  .br-rosette-gold { --c: #d9a520; --c2: #1c4a96; }
  .br-rosette-blank { --c: #8d93ab; --c2: #6e748c; }

  .br-rosette-sm { width: 70px; height: 100px; }
  .br-rosette-sm .br-rosette-disc { width: 70px; height: 70px; }
  .br-rosette-sm .br-rosette-face { font-size: 0.78rem; }
  .br-rosette-sm::before, .br-rosette-sm::after { top: 46px; width: 22px; height: 54px; }
  .br-rosette-sm::before { left: 13px; }
  .br-rosette-sm::after { right: 13px; }

  .br-rosette-xs { width: 52px; height: 74px; }
  .br-rosette-xs .br-rosette-disc { width: 52px; height: 52px; }
  .br-rosette-xs::before, .br-rosette-xs::after { top: 34px; width: 16px; height: 40px; }
  .br-rosette-xs::before { left: 10px; }
  .br-rosette-xs::after { right: 10px; }

  /* ---------- frames ---------- */
  .br-frame {
    position: relative;
