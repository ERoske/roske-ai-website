---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// The collector's record. All real, set as field data.
const collectorRecord = [
  { value: '80+', label: 'Countries surveyed' },
  { value: '50+', label: 'Nations spoken in' },
  { value: '15', label: 'Books published' },
  { value: '25+', label: 'Years running companies' },
];

// ---------------------------------------------------------------------------
// THE TEN PLATES. One entry per agent that actually runs a piece of Edward's
// week. The `stack` line names real software on purpose: the credibility of
// the whole guide depends on a technical reader being able to check it.
// Everything here is observed as of August 2026 and will date, which is what
// the edition line at the top of the page is for.
// ---------------------------------------------------------------------------
const plates = [
  {
    plate: 'I',
    binomial: 'Chronographa matutina',
    common: 'The Morning Brief',
    stack: 'Claude Code, the gws Google Workspace CLI, reading Calendar and Tasks',
    habitat: 'First light. A terminal window I never open.',
    range: "Every weekday. San Juan (Atlantic time, so my 6 AM is most people's bedtime).",
    call: "One message before 6 AM: who I'm seeing today, and why.",
    feeding: 'Calendar entries, task lists, and whatever it can find on the people already on the invite.',
    markings: 'Refuses to editorialize. States the day and stops.',
    status: 'Abundant',
    tone: 'good',
    notes: `It's the base of the whole food web, which took me the better part of a year to notice. Everything downstream inherits its mistakes, so a meeting it mislabels at 5 AM is a meeting I'm still wrong about at 4 PM. (I've asked it to be blunter about which days are stupid. No progress so far.)`,
  },
  {
    plate: 'II',
    binomial: 'Vespa epistolaris',
    common: 'The Inbox Wasp',
    stack: 'An email triage skill plus a response drafter, both hitting Gmail through gws',
    habitat: 'The inbox, which is less a habitat than a weather system.',
    range: 'Continuous. No off season.',
    call: 'Sorts, drafts, flags. Silent otherwise.',
    feeding: 'About 200 messages a day, most of which deserve none of my attention.',
    markings: 'Confident on speaking inquiries. Hopeless at family email.',
    status: 'Vulnerable',
    tone: 'warn',
    notes: `It's never sent a message on its own and it never will. The day I hand it send authority is the day it apologizes to a client, warmly and at length, for something that didn't happen.`,
  },
  {
    plate: 'III',
    binomial: 'Forficula vocalis',
    common: 'The Cutting-Room Earwig',
    stack: 'Descript over MCP, then a YouTube helper pushing the cut through the Data API',
    habitat: 'Asking Good Questions, in the gap between recording and release.',
    range: 'Weekly.',
    call: 'Strips filler words at a rate no human editor would tolerate being paid for.',
    feeding: 'Raw audio, transcripts, chapter markers, thumbnails.',
    markings: 'Cannot tell a thinking pause from a mistake.',
    status: 'Stable',
    tone: 'good',
    notes: `It once cut 4 seconds of silence where a guest was genuinely thinking. Technically a correct edit, and it deleted the best moment in the episode. I put the silence back by hand and wrote a rule about it (the rule is that silence is content, which I have since started applying to meetings).`,
  },
  {
    plate: 'IV',
    binomial: 'Corvus interrogans',
    common: 'The Research Crow',
    stack: 'A fan-out of research subagents, web search, and Gemini Notebook over MCP',
    habitat: 'Open tabs. Hundreds of them, none of them mine.',
    range: "Anywhere I'm about to make a claim on a stage.",
    call: 'Comes back with sources, and with shiny things nobody asked for.',
    feeding: "Filings, transcripts, vendor documentation, other people's slide decks.",
    markings: 'Hoards. Returns 40 sources when 6 would have done the job.',
    status: 'Abundant',
    tone: 'good',
    notes: `It feeds 4 other specimens, which is exactly why it gets checked hardest. A bad source here shows up in a keynote 6 weeks later with my name on it, in front of 400 people who paid to be in the room.`,
  },
  {
    plate: 'V',
    binomial: 'Scriptor nocturnus',
    common: 'The Night Writer',
    stack: 'A drafting skill, then a voice checker that grades the draft against my real sentences',
    habitat: "Drafts, written at hours I'm not awake for.",
    range: 'Weekly, usually Friday.',
    call: "Writes something. A second agent then tells it that it doesn't sound like me.",
    feeding: "Research output, everything I've published on this site, and a voice spec I keep adding rules to.",
    markings: 'Reaches for the em dash constantly. Gets it removed constantly.',
    status: 'Under review',
    tone: 'warn',
    notes: `The voice checker rejects more drafts than it passes, and that ratio is about right. Anything that reads smoothly while saying nothing goes back. (It rejected this sentence twice.)`,
  },
  {
    plate: 'VI',
    binomial: 'Ptilonorhynchus hebdomadalis',
    common: 'The Saturday Bowerbird',
    stack: 'Windows Task Scheduler into PowerShell into Claude Code, building Astro, deployed by GitHub Actions',
    habitat: 'This page.',
    range: 'Saturdays, 5 AM Atlantic.',
    call: "None. It works while I'm asleep.",
    feeding: "Podcast RSS, the YouTube channel, my weekly questionnaire, and whatever's topical.",
    markings: "The only specimen in this guide that builds the habitat you're standing in.",
    status: 'Abundant',
    tone: 'good',
    notes: `It chose this theme, wrote this sentence, and made the photograph of me crouching in a shrub. I found out when you did. (Edward, you built an observation hide for your own software, gave the software a Latin name, and then wrote a field guide about the thing that wrote the field guide. Somewhere there's a version of you who just uses a to-do list and he is outside right now.) It also once hung for 72 hours waiting on a yes-or-no prompt inside a window I had deliberately made invisible, which is the dumbest 3 days I have spent in years, so now anything that runs unattended gets its stdin taken away.)`,
  },
  {
    plate: 'VII',
    binomial: 'Accipiter mercatorius',
    common: 'The Monday Hawk',
    stack: 'A scheduled pitch engine working call-for-speakers pages, keeping its own pipeline file',
    habitat: 'Event sites, conference programs, and submission deadlines.',
    range: 'Mondays.',
    call: 'A ranked list: event, date, deadline, and one line on why I fit.',
    feeding: 'Event calendars, past programs, and the tracker it maintains itself.',
    markings: 'Will pitch me for anything with a stage and a microphone.',
    status: 'Introduced',
    tone: 'warn',
    notes: `Newest specimen in the collection, and the only one with a revenue number attached to it. It doesn't send either. It finds and it drafts, and deciding who's actually worth writing to stays my job (the part I'd keep even if it got good at it).`,
  },
  {
    plate: 'VIII',
    binomial: 'Chamaeleo confabulans',
    common: 'The Plate Painter',
    stack: 'Gemini image models, flash for drafts and pro for finals, always fed my real headshot',
    habitat: 'Every picture of me on this website.',
    range: '6 to 12 images a week.',
    call: 'Silent. Simply produces.',
    feeding: 'A prompt, a reference photograph, and a fedora rule it violates about 1 time in 8 (baseball caps, mostly).',
    markings: 'Hallucinates in the field: spare fingers, wrong hat, occasionally a second me in the background.',
    status: 'Invasive',
    tone: 'bad',
    notes: `The specimen I check hardest, because it's the only one whose mistakes are visible to strangers. Every image on this page got looked at by a human first. The rejects were worse than you're imagining, and one of them gave me 3 hands.`,
  },
  {
    plate: 'IX',
    binomial: 'Suricata praeparans',
    common: 'The Sentry',
    stack: 'A pre-meeting research brief skill, reading public filings, press, and prior threads',
    habitat: 'The 30 minutes before a call.',
    range: "Whenever the calendar produces a name it doesn't recognize.",
    call: "One page: who they are, what they've shipped, and what they'll probably ask.",
    feeding: 'Public filings, professional profiles, press, and everything we have said to each other before.',
    markings: 'Confuses people who share a name. Twice now.',
    status: 'Near threatened',
    tone: 'warn',
    notes: `It sits directly downstream of the calendar agent, so it inherits every mislabeled invite. I've walked into a call briefed thoroughly, confidently, and completely on the wrong person, which is a design failure, and the design is mine.`,
  },
  {
    plate: 'X',
    binomial: 'Chimaera fabulatrix',
    common: "The Dungeon Master's Familiar",
    stack: 'An adventure-writing skill feeding a DM screen prototype I am still building',
    habitat: "An Eberron campaign, and a screen that isn't finished.",
    range: 'Monthly, and never during business hours.',
    call: "Lore lookups, tavern names, and a stat block for whatever the party found in the room I didn't prepare.",
    feeding: "Session notes, rules text, and whatever my players did that I didn't plan for.",
    markings: "Occupies no position in the food web at all. Feeds nothing, earns nothing, and I'd keep it over half the others.",
    status: 'Least concern',
    tone: 'good',
    notes: `It's in the guide because I use it every month and it costs me nothing but a Saturday. A catalog of only the profitable species is a pitch deck with a nicer cover. Last month my party asked whether they could bribe a dragon with a quarterly forecast, and I allowed it.`,
  },
];

// ---------------------------------------------------------------------------
// COMMONLY CONFUSED WITH. The similar-species section, aimed at a buyer who
// has already been sold one of the lookalikes.
// ---------------------------------------------------------------------------
const lookalikes = [
  {
    name: 'The chatbot on a cron job',
    tell: 'It runs on a schedule and produces the same shape of output every time, regardless of what it found.',
    test: 'Feed it a week where nothing happened. A real agent says so and stops. This one files its usual report, on time, at the usual length.',
  },
  {
    name: 'The macro in a new coat',
    tell: 'Identical from a distance, and genuinely useful, right up until a button moves.',
    test: 'Change one thing about the input. If it breaks instead of adapting, you bought a macro at agent prices.',
  },
  {
    name: 'The vendor demo',
    tell: 'Only ever observed in captivity, in a curated environment, on data the vendor prepared himself.',
    test: 'Ask to run it on your own closing numbers, live, with your own messy chart of accounts. Watch what happens next (something always happens next).',
  },
  {
    name: 'The sidebar assistant',
    tell: 'Waits to be asked. Answers well. Then goes back to sleep and forgets you.',
    test: 'Do nothing for a day. If nothing arrived without you asking, what you have is a tool. Tools are great. You were just sold the other thing.',
  },
];

// ---------------------------------------------------------------------------
// UNSURVEYED TERRITORY. The range map has to show the wilderness or it is
// marketing. These are the parts of the week no agent touches.
// ---------------------------------------------------------------------------
const wilderness = [
  {
    zone: 'Deciding what is worth building',
    note: '10 agents will execute any bad idea at full speed, on schedule, and beautifully formatted.',
  },
  {
    zone: 'The room',
    note: 'Nothing in this guide has ever stood in front of 400 finance people and read the temperature of the room at minute 9.',
  },
  {
    zone: 'Telling someone something they do not want to hear',
    note: "It'll draft the message just fine. Sitting across from somebody while they read it isn't a thing I'd hand off.",
  },
  {
    zone: 'Knowing a number is wrong',
    note: "A number can look wrong to me before I've checked any of it. I can't explain that to a model, because I can't explain it to myself. 25 years and I've got nothing better than that.",
  },
  {
    zone: 'What Dawn thinks of the idea',
    note: "Unsurveyed and unsurveyable, and she's right more often than the agents are.",
  },
];

// ---------------------------------------------------------------------------
// APPENDIX B: FIELD STATIONS. The six real projects, kept every week.
// ---------------------------------------------------------------------------
const stations = [
  {
    ref: 'B-01',
    kind: 'Instrumentation',
    name: 'MCP Servers for Enterprise Finance',
    note: `The plumbing that lets an agent work inside a real finance system rather than beside it. Oracle Essbase and EPM Planning are shipping, and Financial Close and Consolidations is in beta. None of this matters if the agent can't reach the actual system.`,
    tag: 'ORACLE EPM / MCP',
    status: 'SHIPPING',
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    ref: 'B-02',
    kind: 'Annual gathering',
    name: 'Caribbean AI Summit',
    note: `Co-chairing the largest AI conference Puerto Rico has ever hosted, October 9 and 10 at the Convention Center. Confirmed so far: Kay Firth-Butterfield, MIT's Fabio Duarte, and EU Parliament AI advisor Idoia Salazar, with more still signing. (Co-chairing is 10% stagecraft and 90% email.)`,
    tag: '9-10 OCT 2026',
    status: 'CALL FOR SPEAKERS OPEN',
    href: 'https://www.caribbeansummit.ai/en/speakers/submit',
    external: true,
    cta: 'Submit a speaker',
  },
  {
    ref: 'B-03',
    kind: 'Breeding program',
    name: 'Caprus',
    note: `Investor and contributor at the AI software and services firm building faster operations for finance teams. They do the engineering. I show up and point at things.`,
    tag: 'AI / FINANCE',
    status: 'RUNNING',
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    ref: 'B-04',
    kind: 'Expedition record',
    name: 'Everest Base Camp',
    note: `This spring Dawn and I walked to the foot of Everest: 2 weeks, 18,571 feet, and every question I could think of asked of the guides. The full report is on the blog, including the parts that went badly.`,
    tag: 'NEPAL / 2026',
    status: 'REPORT FILED',
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    ref: 'B-05',
    kind: 'Captive specimen',
    name: "AI Dungeon Master's Screen",
    note: `A prototype screen for running D&D 5e: lore lookups and improvisation help for the person behind the cardboard. See Plate X. It isn't finished and I'm in no hurry.`,
    tag: 'D&D / 5E',
    status: 'IN DEVELOPMENT',
    href: null,
    external: false,
    cta: 'Quiet build',
  },
  {
    ref: 'B-06',
    kind: 'Local population',
    name: 'Puerto Rico AI Community',
    note: `President of the island's AI community, now past 1,000 different people through the door. We meet every other month and argue in 2 languages about what AI means for Puerto Rico until something useful falls out. Come to one!`,
    tag: '1,000+ ATTENDEES',
    status: 'RUNNING',
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];

// Food-web nodes, laid out by trophic level for the diagram below.
const webLevels = [
  {
    tier: 'Substrate',
    caption: 'My calendar, my inbox, my files. Everything above this eats it.',
    nodes: [{ id: 'raw', label: 'The raw day' }],
  },
  {
    tier: 'Producers',
    caption: 'They convert the mess into something the others can eat.',
    nodes: [
      { id: 'cal', label: 'I. Morning Brief' },
      { id: 'mail', label: 'II. Inbox Wasp' },
      { id: 'res', label: 'IV. Research Crow' },
    ],
  },
  {
    tier: 'Primary consumers',
    caption: 'None of these can survive without something on the tier below.',
    nodes: [
      { id: 'prep', label: 'IX. Sentry' },
      { id: 'write', label: 'V. Night Writer' },
      { id: 'img', label: 'VIII. Plate Painter' },
    ],
  },
  {
    tier: 'Secondary consumers',
    caption: 'The visible output. Also the last place a mistake is cheap to catch.',
    nodes: [
      { id: 'pod', label: 'III. Cutting Room' },
      { id: 'site', label: 'VI. Bowerbird' },
      { id: 'pitch', label: 'VII. Monday Hawk' },
    ],
  },
  {
    tier: 'Outside the web',
    caption: 'Feeds nothing, earns nothing, stays in the guide anyway.',
    detached: true,
    nodes: [{ id: 'dnd', label: 'X. Familiar' }],
  },
];
---

<BaseLayout>
  <WeeklyAnimation />

  <!-- ================= EDITION STRIP ================= -->
  <div class="ed" role="presentation">
    <div class="ed-inner">
      <span class="ed-item">A Field Guide to the Ten Agents</span>
      <span class="ed-item ed-mid">First edition</span>
      <span class="ed-item">Observed as of August 2026</span>
    </div>
  </div>

  <!-- ================= HERO / FRONTISPIECE ================= -->
  <section class="hero">
    <div class="hero-inner">
      <figure class="hero-fig">
        <div class="hero-frame">
          <span class="hero-plate">Frontispiece</span>
          <img
            src={`/images/${theme.hero.heroImage}`}
            alt={theme.hero.imageAlt}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
            class="hero-img"
          />
        </div>
        <figcaption class="hero-cap">
          The author in the field, observing a specimen at close range. The specimen is aware of this
          and has factored it in.
        </figcaption>
      </figure>

      <div class="hero-copy">
        <p class="hero-kicker">Roske.AI | Natural history of a working week</p>
        <h1 class="hero-h1">A Field Guide<br /><span class="hero-h1-sub">to the</span><br />Ten Agents</h1>
        <p class="hero-binomial">Being a complete account of ten species of working software, their habitats, their feeding behavior, and which of them bite.</p>
        <div class="hero-rule" aria-hidden="true"></div>
        <p class="hero-sub">{theme.hero.subtitle}</p>
        <p class="hero-desc">{theme.hero.description}</p>
        <div class="hero-cta">
          <a href={theme.hero.ctaLink} class="btn-solid">{theme.hero.ctaText}</a>
          <a href="/question/" target="_blank" rel="noopener" class="btn-line">Book 13 minutes</a>
        </div>
      </div>
    </div>

    <div class="record" aria-label="Collector's record">
      <div class="record-inner">
        <span class="record-head">Collector's record</span>
        {collectorRecord.map(s => (
          <span class="record-stat">
            <span class="record-value">{s.value}</span>
            <span class="record-label">{s.label}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= LATEST CONTENT (permanent) ================= -->
  <LatestContent
    eyebrow="Recent sightings"
    heading="Logged <em>this month.</em>"
    deck="New writing and new video briefs, in the order they were recorded."
  />

  <!-- ================= BOOK EDWARD (permanent) ================= -->
  <div class="author-frame">
    <p class="author-plate">About the author</p>
    <SpeakerCTA eyebrow="From the back cover" />
  </div>

  <!-- ================= THE PLATES ================= -->
  <section class="plates" id="plates">
    <div class="plates-head">
      <p class="sec-eyebrow">Part one</p>
      <h2 class="sec-h2">The Specimens</h2>
      <p class="sec-deck">
        10 agents run my week. Each one is a process that produces real work while I'm doing
        something else, and each entry below names the actual software, because I don't trust a
        guide that won't tell you what it's looking at. All of this will be wrong by spring, which
        is exactly why a real guide prints the year on its cover.
      </p>
      <p class="sec-margin">Observed Aug 2026. Ranges shift. 2 of these didn't exist in January.</p>
    </div>

    <div class="plate-grid">
      {plates.map(p => (
        <article class="plate">
          <header class="plate-head">
            <span class="plate-no">Plate {p.plate}</span>
            <span class={`plate-status status-${p.tone}`}>{p.status}</span>
          </header>
          <h3 class="plate-binomial">{p.binomial}</h3>
          <p class="plate-common">{p.common}</p>
          <p class="plate-stack">{p.stack}</p>
          <dl class="plate-data">
            <div class="pd-row"><dt>Habitat</dt><dd>{p.habitat}</dd></div>
            <div class="pd-row"><dt>Range</dt><dd>{p.range}</dd></div>
            <div class="pd-row"><dt>Call</dt><dd>{p.call}</dd></div>
            <div class="pd-row"><dt>Feeding</dt><dd>{p.feeding}</dd></div>
            <div class="pd-row"><dt>Markings</dt><dd>{p.markings}</dd></div>
          </dl>
          <p class="plate-notes"><span class="pn-label">Field notes.</span> {p.notes}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= THE FOOD WEB ================= -->
  <section class="web" id="food-web">
    <div class="web-head">
      <p class="sec-eyebrow">Part two</p>
      <h2 class="sec-h2">The Food Web</h2>
      <p class="sec-deck">
        Here's the part a specimen list can't show you. These 10 things form a stack with
        dependencies: they eat each other's output, they inherit each other's mistakes at machine
        speed, and the failure that actually costs you money is almost never in the animal you were
        watching, it's 2 tiers down in something boring that happened 4 hours earlier while you were
        in a meeting about something else.
      </p>
    </div>

    <div class="web-body">
      <figure class="web-fig">
        <img src="/images/field-guide/hide.jpg" width="1600" height="893" loading="lazy" decoding="async"
          alt="Edward Roske in his blue fedora, seen from behind inside a wooden birdwatching hide, taking notes in pencil while watching a scattering of old beige computer monitors standing in the moss and ferns of a misty dawn clearing." />
        <figcaption>Observation blind, built after the third time I found out about a failure from a customer instead of a log.</figcaption>
      </figure>

      <div class="web-diagram" role="img" aria-label="Food web diagram: the raw day feeds the Morning Brief, Inbox Wasp and Research Crow; those feed the Sentry, Night Writer and Plate Painter; those feed the Cutting Room, Saturday Bowerbird and Monday Hawk. The Dungeon Master's Familiar sits outside the web and feeds nothing.">
        {webLevels.map((lvl, i) => (
          <div class={`web-tier ${lvl.detached ? 'web-tier-detached' : ''}`}>
            <div class="web-tier-label">
              <span class="wt-name">{lvl.tier}</span>
              <span class="wt-cap">{lvl.caption}</span>
            </div>
            <div class="web-nodes">
              {lvl.nodes.map(n => (
                <span class={`web-node ${n.id === 'dnd' ? 'web-node-loose' : ''}`}>{n.label}</span>
              ))}
            </div>
            {!webLevels[i + 1]?.detached && i < webLevels.length - 1 && (
              <div class="web-arrows" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <p class="web-punch">
      Every consulting engagement I've ever walked into wanted to fix the top tier. The problem was in
      the substrate, in a field somebody typed wrong in 2019, and the agents at the top were doing
      exactly what they were built to do with it.
    </p>
  </section>

  <!-- ================= WHAT'S NEW (permanent) ================= -->
  <WhatsNew
    eyebrow="Sightings by others"
    heading="Recorded <em>elsewhere.</em>"
    deck="Independent observations: press, interviews, and whatever I posted that turned out to be worth keeping."
  />

  <!-- ================= COMMONLY CONFUSED WITH ================= -->
  <section class="confused">
    <div class="confused-inner">
      <div class="confused-copy">
        <p class="sec-eyebrow">Part three</p>
        <h2 class="sec-h2">Commonly Confused With</h2>
        <p class="sec-deck">
          Every real field guide has this section, because the expensive mistakes are always the
          lookalikes. 4 things get sold as agents around here, and 3 of them are perfectly good
          software wearing somebody else's label (I've bought at least 2 of them myself, at list
          price, with a completely straight face). Here's how to tell them apart before you sign.
        </p>

        <ol class="conf-list">
          {lookalikes.map((l, i) => (
            <li class="conf-item">
              <span class="conf-no">{String(i + 1).padStart(2, '0')}</span>
              <div class="conf-body">
                <h3 class="conf-name">{l.name}</h3>
                <p class="conf-tell"><span class="conf-lbl">In the field.</span> {l.tell}</p>
                <p class="conf-test"><span class="conf-lbl">How to tell.</span> {l.test}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <figure class="confused-fig">
        <img src="/images/field-guide/confused.jpg" width="1195" height="1600" loading="lazy" decoding="async"
          alt="Edward Roske in his blue fedora at a field workbench, holding two nearly identical glass specimen jars up to the light and comparing them with a skeptical squint." />
        <figcaption>Two specimens, one afternoon, and a difference of about $400,000 over three years.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ================= WHICH ONES BITE ================= -->
  <section class="bite">
    <div class="bite-inner">
      <figure class="bite-fig">
        <img src="/images/field-guide/bite.jpg" width="1600" height="1195" loading="lazy" decoding="async"
          alt="Edward Roske in his blue fedora sitting on a mossy fallen log in a sunlit forest, calmly holding up his bandaged right hand, with an open laptop sitting in the tall grass at his feet." />
      </figure>
      <div class="bite-copy">
        <p class="sec-eyebrow">Part four</p>
        <h2 class="sec-h2">Which Ones Bite</h2>
        <p class="sec-deck">
          Here's what has gone wrong, which is the part the brochures leave out. The site rebuild once
          ran for 72 hours because it sat waiting on a keystroke inside a window I had deliberately
          made invisible (I spent 2 of those days convinced GitHub was down). The image generator puts
          me in the wrong hat about 1 time in 8. The meeting brief has confidently, thoroughly prepared
          me for the wrong human being, twice, and both times I worked it out during the handshake.
        </p>
        <p class="sec-deck">
          None of that made me stop using them, and none of it should. It's a reason to know which one
          you're holding. The honest failure rate across the whole collection sits somewhere near 1 in
          10, which sounds disqualifying right up until you price the alternative, and which is exactly
          why nothing in this guide has send authority.
        </p>
        <p class="bite-margin">Bandage is real. So is the log. The laptop was fine, which is more than I can say for the hand.</p>
      </div>
    </div>
  </section>

  <!-- ================= RANGE MAP / WILDERNESS ================= -->
  <section class="range">
    <div class="range-head">
      <p class="sec-eyebrow">Part five</p>
      <h2 class="sec-h2">Range Map</h2>
      <p class="sec-deck">
        Here's where none of them go. These are the parts of my week where no specimen in this guide
        has ever been observed, and where I've stopped waiting for one to turn up.
      </p>
    </div>

    <div class="range-body">
      <ul class="range-list">
        {wilderness.map(w => (
          <li class="range-item">
            <span class="range-tag">Unsurveyed</span>
            <h3 class="range-zone">{w.zone}</h3>
            <p class="range-note">{w.note}</p>
          </li>
        ))}
      </ul>

      <figure class="range-fig">
        <img src="/images/field-guide/range.jpg" width="1600" height="893" loading="lazy" decoding="async"
          alt="Edward Roske in his blue fedora on a high ridge at first light, holding a large unfolded paper survey map open in both hands, looking out past it over a wide valley of forest, cliffs and drifting cloud." />
        <figcaption>The surveyed portion is smaller than the brochure suggests.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ================= APPENDIX B: FIELD STATIONS ================= -->
  <section class="stations">
    <div class="stations-head">
      <p class="sec-eyebrow">Appendix B</p>
      <h2 class="sec-h2">Field Stations</h2>
      <p class="sec-deck">6 places the observation actually happens, and what's running at each one right now.</p>
    </div>

    <div class="station-grid">
      {stations.map(s => (
        <article class="station">
          <div class="station-top">
            <span class="station-ref">{s.ref}</span>
            <span class="station-kind">{s.kind}</span>
          </div>
          <h3 class="station-name">{s.name}</h3>
          <p class="station-note">{s.note}</p>
          <div class="station-foot">
            <span class="station-tag">{s.tag}</span>
            <span class="station-status">{s.status}</span>
          </div>
          {s.href ? (
            <a
              class="station-cta"
              href={s.href}
              target={s.external ? '_blank' : undefined}
              rel={s.external ? 'noopener noreferrer' : undefined}
            >{s.cta}</a>
          ) : (
            <span class="station-cta station-cta-off">{s.cta}</span>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- ================= CORRESPONDENCE (CTA) ================= -->
  <section class="corr">
    <div class="corr-inner">
      <figure class="corr-fig">
        <img src="/images/field-guide/desk.jpg" width="1195" height="1600" loading="lazy" decoding="async"
          alt="Edward Roske in his blue fedora working at night inside a canvas field tent by the light of a brass oil lamp, pinning a specimen card to a corkboard already covered with dozens of them." />
      </figure>
      <div class="corr-copy">
        <p class="sec-eyebrow">Correspondence</p>
        <h2 class="corr-h2">Write to the author.</h2>
        <p class="corr-deck">
          If your organization is somewhere in this guide and you're not sure which plate you're on,
          that's a good 13 minutes. I'll tell you which specimen you actually have, and whether it's
          worth keeping.
        </p>
        <div class="corr-cta">
          <a href="/question/" target="_blank" rel="noopener" class="btn-solid">Book 13 minutes</a>
          <a href="/contact/" class="btn-line">Send a letter</a>
          <a href="/speaking/" class="btn-line">Book the keynote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= COLOPHON ================= -->
  <div class="colophon">
    <p class="colo-line">
      Printed weekly at 5 AM Atlantic by Plate VI, which also selected this week's subject, wrote
      most of these captions, and painted every illustration. Species names are invented. The software
      is real. No vendor paid to appear in this guide, and at least 2 of them would like a word.
    </p>
  </div>
</BaseLayout>

<style>
  /* ============================================================
     A FIELD GUIDE TO THE TEN AGENTS - week of 2026-08-15
     Plate-book typography on aged paper, read by headlamp in dark
