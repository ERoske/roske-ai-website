---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// ---------------------------------------------------------------------------
// THE CARIBBEAN AI SUMMIT (2026-10-03). The one week that plays it straight.
// Every speaker, session, time, room, price, and sponsor below is copied from
// the summit's own site (caribbeansummit.ai, agenda "last updated September
// 2026"). Nothing here is invented, and nothing here is generated: the photos
// are the speakers' real headshots and the summit's own venue art.
//
// TENSE: the copy lives through 3 states (upcoming Oct 3-8, live Oct 9-10,
// over Oct 11). Every forward-looking spot carries a SUMMIT-FORWARD marker
// so the October 11 takedown can find it with one grep.
// ---------------------------------------------------------------------------

const SUMMIT = 'https://www.caribbeansummit.ai/';
// SUMMIT-FORWARD: the ticket link. Swap every use for a recap link on Oct 11.
const TICKETS = 'https://787tickets.com/carrito/boleteria/evento/caribbean-ai-summit-2026';

// The numbers strip under the hero. Program facts only.
const facts = [
  { v: '2', k: 'Days, October 9 and 10' },
  { v: '3', k: 'Tracks, running in parallel' },
  { v: '30+', k: 'Speakers' },
  { v: 'EN/ES', k: 'Live subtitles, every session' },
  { v: '$10K', k: 'Hackathon prize pool' },
];

// ---------------------------------------------------------------------------
// THE LINEUP. The 3 names the summit led with, then the wider program.
// ---------------------------------------------------------------------------
const headliners = [
  {
    name: 'Kay Firth-Butterfield',
    role: 'Former Head of AI, World Economic Forum',
    slot: 'Day 2 | 4:45 PM | Closing keynote, Technical',
    talk: `The Global State of AI: Governance, Risk & What's Next`,
    note: `CEO of Good Tech Advisory, and her latest book, Coexisting With AI, came out in January. If you've ever been asked who's accountable when the model gets it wrong, her talk is the one to catch.`,
    img: '/images/caribbean-ai-summit/kay.jpg',
    alt: 'Kay Firth-Butterfield speaking at a podium in a red dress, a TIME100 Impact Awards AI sign beside her.',
  },
  {
    name: 'Fabio Duarte',
    role: 'Principal Research Scientist, MIT Senseable City Lab',
    slot: 'Day 1 | 9:00 AM | Opening keynote, Business',
    talk: 'AI for Urban Biodiversity',
    note: `His lab builds vision models that count insects in city gardens on low-power hardware, which is one of the most practical uses of AI I've seen on any program (and the only talk this year where the bugs are the point).`,
    img: '/images/caribbean-ai-summit/fabio-duarte.jpg',
    alt: 'Fabio Duarte in round glasses and an olive shirt, smiling, in front of a dark wall with white MIT lettering.',
  },
  {
    name: 'Idoia Salazar',
    role: 'President, OdiseIA | AI advisor to the EU Parliament',
    slot: 'Day 2 | 4:45 PM | Closing keynote, Business',
    talk: 'Ethics & EU Regulation: the Global Playbook',
    note: `She sits on the expert team for AI regulation at the European Parliament's AI Observatory and works on Spain's AI regulatory sandbox, so when she tells you what the AI Act will actually ask of you, she's describing her week.`,
    img: '/images/caribbean-ai-summit/idoia.jpg',
    alt: 'Idoia Salazar in a pink blouse, smiling, against a pale grey background.',
  },
];

const program = [
  { name: 'Stephen Smith', org: 'Carnegie Mellon | AAAI President', talk: 'AI for Smart Cities & Urban Mobility', img: 'stephen-smith' },
  { name: 'Pablo José Hernández Rivera', org: 'Resident Commissioner of Puerto Rico', talk: 'Fireside Chat: AI in Puerto Rico and Beyond', img: 'pablo-jose-hernandez' },
  { name: 'Tim Berglund', org: 'Confluent', talk: 'A Brief History of Artificial Intelligence', img: 'tim-berglund' },
  { name: 'Gauthier Vasseur', org: 'UC Berkeley | Fisher Center', talk: 'Beyond AI: Building AI-Capable Organizations', img: 'gauthier-vasseur' },
  { name: 'René Vidal', org: 'University of Pennsylvania', talk: 'Engineering Trustworthy AI Systems', img: 'rene-vidal' },
  { name: 'Giselle Zeno', org: 'MIT Lincoln Laboratory', talk: `Do's and Don'ts in the Agentic AI Era`, img: 'giselle-zeno' },
  { name: 'Julian Duque', org: 'Salesforce | MuleSoft', talk: 'So You Have 50 Agents. Now What?', img: 'julian-duque' },
  { name: 'Dash Desai', org: 'Snowflake', talk: 'Building on Cortex AI', img: 'dash-desai' },
  { name: 'Gary Crisci', org: 'Caprus AI', talk: 'Smart Models, Naive Systems: Context Engineering for the Enterprise', img: 'gary-crisci' },
  { name: 'Bivin Sadler', org: 'Southern Methodist University', talk: 'AI-Powered Oral Exams', img: 'bivin-sadler' },
];

// ---------------------------------------------------------------------------
// THE PROGRAMME. Both days, all 3 rooms, as published. route = on my
// suggested path for finance leaders (my opinion, not the summit's).
// ---------------------------------------------------------------------------
interface Sess {
  who: string;
  title: string;
  kind?: string;
  route?: boolean;
}
interface Row {
  time: string;
  label?: string;
  heading?: string;
  plenary?: Sess[];
  b?: Sess;
  t?: Sess;
  s?: Sess;
}

const tracks = [
  { key: 'b', name: 'Business', room: 'Ballroom B' },
  { key: 't', name: 'Technical', room: 'Room 209' },
  { key: 's', name: 'Society', room: 'Room 208' },
] as const;

const days: { id: string; day: string; date: string; rows: Row[] }[] = [
  {
    id: 'day-1',
    day: 'Day 1',
    date: 'Friday, October 9',
    rows: [
      { time: '8:00 AM', label: 'Registration and coffee | Sponsor expo opens' },
      {
        time: '9:00 AM',
        heading: 'Opening keynotes',
        plenary: [
          { who: 'JD Torres & Edward Roske, Puerto Rico AI Community', title: 'Welcome', kind: '9:00' },
          { who: 'Jose Oyola-Cabello, HPE', title: 'AI & How It Impacts the Enterprise', kind: 'Opening keynote' },
          { who: 'Pablo José Hernández Rivera, Resident Commissioner of Puerto Rico', title: 'Fireside Chat: AI in Puerto Rico and Beyond', kind: 'Keynote' },
          { who: 'Fabio Duarte, MIT Senseable City Lab', title: 'AI for Urban Biodiversity', kind: 'Business' },
          { who: 'Stephen Smith, Carnegie Mellon | AAAI President', title: 'AI for Smart Cities & Urban Mobility', kind: 'Technical' },
          { who: `Carlos 'Johnny' Méndez Núñez, Speaker of the Puerto Rico House`, title: 'Remarks', kind: 'Special address' },
        ],
      },
      {
        time: '10:45 AM',
        b: { who: 'To be announced', title: 'Special AI Presentation' },
        t: { who: 'Julian Duque, Salesforce | MuleSoft', title: 'So You Have 50 Agents. Now What?' },
        s: { who: 'Bivin Sadler, Southern Methodist University', title: 'AI-Powered Oral Exams' },
      },
      {
        time: '11:45 AM',
        b: { who: 'Jose Carlos Sariol + Guillermo Caicedo, Microsoft', title: 'Why Your AI Pilot Never Made It to Production', route: true },
        t: { who: 'Giselle Zeno, MIT Lincoln Laboratory', title: `Do's and Don'ts in the Agentic AI Era` },
        s: { who: 'Silvino Díaz, Starving Artists', title: 'AI, IP & Machine Creativity' },
      },
      { time: '12:30 PM', label: 'Lunch | Sponsor expo' },
      {
        time: '1:45 PM',
        heading: 'Keynotes',
        b: { who: 'Tim Berglund, Confluent', title: 'A Brief History of Artificial Intelligence' },
        t: { who: 'Dash Desai, Snowflake', title: 'Building on Cortex AI' },
      },
      {
        time: '3:00 PM',
        b: { who: 'Damián Fernández, DFX5', title: 'Modernizing Customer Experience for the Agentic Era', kind: 'DFX5 & AWS sponsor session' },
        t: { who: 'Michael Oguike, Amazon Web Services', title: 'Customizing AI Models for Real Business ROI', route: true },
        s: { who: 'Frances Heredia, Wilfredo De Jesús-Monge, Asra Ali', title: 'AI in Healthcare & Life Sciences', kind: 'Panel' },
      },
      {
        time: '4:15 PM',
        b: { who: 'Miguel F. Marrero (moderator), Julybeth Alicea, Alberto Estrella', title: 'Legal Panel', kind: 'Panel', route: true },
        t: { who: 'Andrés Andreu + Aury Curbelo', title: 'AI Cybersecurity: Offense vs. Defense' },
        s: { who: 'Luis Antonio Díaz, OfferioAI', title: `Sovereign AI: The Caribbean's Advantage` },
      },
      { time: '5:00 PM', label: 'Networking reception | Sponsor expo' },
      { time: '6:00 PM', label: 'Hackathon mentorship sessions (48 hours, $10K in prizes)' },
    ],
  },
  {
    id: 'day-2',
    day: 'Day 2',
    date: 'Saturday, October 10',
    rows: [
      { time: '8:00 AM', label: 'Registration | Hackathon build continues' },
      {
        time: '9:00 AM',
        heading: `Keynotes | Puerto Rico's AI Moment`,
        b: { who: 'Juan Carlos Pedreira, SBH Digital', title: 'AI for Humans: How a Small Business Out-Competes a Fortune 500' },
        t: { who: 'David Bartolomei, Monitorea.ai', title: 'Signal in the Noise: AI Hype vs. Real Business Value', route: true },
      },
      {
        time: '10:15 AM',
        b: { who: 'Bhavesh Chandraprakash + Jammy Chan, HPE', title: 'AI-Native Networking: Transforming Enterprise Network Operations', kind: 'Sponsor session' },
        t: { who: 'Bring your laptop', title: 'Hands-On: Getting AI Agents Up and Running with OpenAI and Anthropic', kind: 'Workshop' },
        s: { who: 'Gerardo Lebrón, then Nesty Delgado', title: 'The Right to Stay Human: Neural Privacy & BCIs, then 2026: The Year AI Works With You... or Without You' },
      },
      {
        time: '11:30 AM',
        b: { who: 'Elsa del Pino, WAW PR', title: 'The AI-Powered Creative: Do More, Look Bigger, Stay Human' },
        t: { who: 'Filomeno González, Databricks', title: 'Ship a Production AI App in Two Weeks', route: true },
        s: { who: 'René Vidal, University of Pennsylvania', title: 'Engineering Trustworthy AI Systems' },
      },
      { time: '12:15 PM', label: 'Lunch | Sponsor expo | Hackathon judging' },
      {
        time: '2:15 PM',
        heading: 'Keynote & Business AI Panel | Ballroom B',
        plenary: [
          { who: 'Senator Wilmer Reyes Berríos, Chair, Senate Committee on Science, Technology & AI', title: 'Remarks', kind: '2:15' },
          { who: 'Gauthier Vasseur, UC Berkeley | Fisher Center for AI', title: 'Beyond AI: Building AI-Capable Organizations', kind: '2:35', route: true },
          { who: 'Gauthier Vasseur (moderator) with Sai Ramamoorthy, HPE, and Gary Crisci, Caprus AI', title: 'Business AI Panel', kind: '2:55', route: true },
        ],
      },
      {
        time: '3:30 PM',
        b: { who: 'Emceed by Pedro Cruz, Hackathon Lead', title: 'Hackathon Finalist Demos', kind: 'Main stage' },
        t: { who: 'Gary Crisci, Caprus AI', title: 'Smart Models, Naive Systems: Context Engineering for the Enterprise', route: true },
        s: { who: 'Carlos Montañez, CPA (moderator), Alexander Pazo, Alan Taveras, Andreica Maldonado', title: 'Economic Development & AI', kind: 'Panel' },
      },
      { time: '4:15 PM', label: 'Coffee and networking | Move to Ballroom B' },
      {
        time: '4:45 PM',
        heading: 'Closing keynotes, plus the hackathon awards',
        b: { who: 'Idoia Salazar, OdiseIA | AI advisor to the EU Parliament', title: 'Ethics & EU Regulation: the Global Playbook', route: true },
        t: { who: 'Kay Firth-Butterfield, former Head of AI, World Economic Forum', title: `The Global State of AI: Governance, Risk & What's Next`, route: true },
      },
    ],
  },
];

// ---------------------------------------------------------------------------
// GETTING HERE. Venue logistics, straight from the summit.
// ---------------------------------------------------------------------------
const logistics = [
  { k: 'Venue', v: 'Puerto Rico Convention Center, 100 Bulevar Saint John, Isla Grande, San Juan, PR 00907' },
  { k: 'Hours', v: 'October 9 and 10, 9:00 AM to 6:00 PM (doors at 8:45)' },
  { k: 'From SJU airport', v: 'About 10 minutes, roughly $20 by rideshare or taxi' },
  { k: 'From Condado', v: '5 minutes' },
  { k: 'From Old San Juan', v: '15 minutes' },
  { k: 'Flights', v: '3.5 hours from New York, 2.5 from Miami' },
  { k: 'Passport', v: 'Not needed for US citizens, and no currency change either' },
  { k: 'Parking', v: 'Valet at the Convention Center, $18 a day' },
  { k: 'Language', v: 'Spanish and English, with live subtitles in both. No headsets.' },
  { k: 'Age', v: '18 and up' },
];

// ---------------------------------------------------------------------------
// TICKETS. SUMMIT-FORWARD: this entire block comes down on October 11.
// ---------------------------------------------------------------------------
const passes = [
  {
    name: 'General Admission',
    price: '$449',
    tag: 'Most popular',
    lines: [
      'Both days, October 9 and 10',
      'All 3 tracks and every keynote',
      '20+ parallel sessions',
      'Networking and the sponsor expo',
      'Live bilingual subtitles',
      'Coffee and networking breaks, both days',
    ],
    cta: 'Get General Admission',
  },
  {
    name: 'Inner Circle',
    price: '$999',
    tag: 'Premium',
    lines: [
      'Everything in General Admission',
      'Preferred keynote seating',
      'The Inner Circle lounge',
      'Curated networking with the C-suite and the speakers',
      'Private lunch with the speakers, both days',
      'Express check-in',
    ],
    cta: 'Get Inner Circle',
  },
];

// ---------------------------------------------------------------------------
// WITH THANKS. Sponsors as listed by the summit, set as type (no logos).
// ---------------------------------------------------------------------------
const sponsors = [
  { tier: 'Title', names: ['Liberty Business (this is CAIS by Liberty)'] },
  { tier: 'Gold', names: ['HPE', 'dfx5 with AWS', 'Hello Media'] },
  { tier: 'Silver', names: ['JetBrains', 'W@W', 'Pharos Solutions', 'Municipality of San Juan', 'Rizq'] },
  { tier: 'Bronze', names: ['Fusionworks', 'Estrella, LLC', 'Om Aura Media'] },
  { tier: 'Hackathon', names: ['CUD Puerto Rico'] },
];

// ---------------------------------------------------------------------------
// THE REST OF THE DESK. The 6 project cards, restyled, never removed.
// ---------------------------------------------------------------------------
const desk = [
  {
    no: '01',
    name: 'MCP Servers for Enterprise Finance',
    state: 'Shipping',
    note: `Plumbing so an AI reads the real number out of Essbase and Oracle EPM instead of remembering one that sounds about right. Essbase and EPM Planning have shipped, Financial Close and Consolidations is in beta (beta meaning it works and I'm not ready to say that out loud yet).`,
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    no: '02',
    name: 'Caribbean AI Summit',
    // SUMMIT-FORWARD: state + note + cta are upcoming-tense.
    state: 'October 9 and 10',
    note: `Co-chairing it, and you're standing in the lobby. Scroll up, the whole program's on this page, including a $10,000 hackathon running underneath it.`,
    href: '#program',
    external: false,
    cta: 'Read the program',
  },
  {
    no: '03',
    name: 'Caprus',
    state: 'Investor',
    note: `I'm an investor, and that's the whole job. Lillian Buziak runs it, and they sell and support AgentCube (the MCP servers above), which spares everybody from having me do it.`,
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    no: '04',
    name: 'Everest Base Camp',
    state: 'Done, April 2026',
    note: `Two weeks on foot to 18,571 feet with Dawn. The trail log is on the blog, including the last 400 feet of Kala Patthar, which were the hardest 400 feet of the trip.`,
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    no: '05',
    name: "AI Dungeon Master's Screen",
    state: 'Quiet build',
    note: `A prototype screen for running 5e: lore lookups and improvisation help for the person behind the cardboard. It hasn't earned a dollar and it isn't finished, which is about what you'd expect from a project whose main customer is me.`,
    href: null,
    external: false,
    cta: 'Not public yet',
  },
  {
    no: '06',
    name: 'Puerto Rico AI Community',
    state: 'Every other month',
    note: `President of the island's AI community (unpaid, obviously), now past 1,000 different people through the door. Bi-monthly, free, both languages, and the reason the summit exists at all.`,
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];

const stats = [
  { v: '80+', k: 'Countries visited' },
  { v: '50+', k: 'Countries spoken in' },
  { v: '15', k: 'Books' },
  { v: '25', k: 'Years running interRel' },
];
---

<BaseLayout>
  <WeeklyAnimation />

  <!-- ================= HERO: THE FRONT DOOR ================= -->
  <section class="cs-hero" aria-labelledby="cs-hero-title">
    <img
      src={`/images/${theme.hero.heroImage}`}
      alt={theme.hero.imageAlt}
      width="1600"
      height="593"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="cs-hero-img"
    />
    <div class="cs-hero-shade" aria-hidden="true"></div>
    <div class="cs-wrap cs-hero-inner">
      <p class="cs-kicker">
        <span>Roske.AI | Program edition | Week of October 3, 2026</span>
        {/* SUMMIT-FORWARD: status chip. The inline script below rewrites it to a countdown (Oct 3-8) or "happening now" (Oct 9-10). Remove the chip and script on Oct 11. */}
        <span class="cs-status" data-cs-status>October 9-10, 2026</span>
      </p>
      <h1 class="cs-h1" id="cs-hero-title">
        <span class="cs-h1-small">The</span>
        Caribbean <span class="cs-h1-ai">AI</span> Summit
      </h1>
      {/* SUMMIT-FORWARD: subtitle, description, and the ticket CTA come from theme-config hero */}
      <p class="cs-hero-sub">{theme.hero.subtitle}</p>
      <p class="cs-hero-desc">{theme.hero.description}</p>
      <div class="cs-hero-cta">
        {/* SUMMIT-FORWARD: registration CTA */}
        <a class="cs-btn cs-btn-coral" href={theme.hero.ctaLink} target="_blank" rel="noopener noreferrer">
          {theme.hero.ctaText}
        </a>
        <a class="cs-btn cs-btn-ghost" href="#program">See the program</a>
      </div>
      <p class="cs-hero-credit">Venue art: Caribbean AI Summit</p>
    </div>
  </section>

  <!-- ================= THE NUMBERS ================= -->
  <div class="cs-facts-wrap">
    <ul class="cs-facts" aria-label="The summit in numbers">
      {facts.map((f) => (
        <li class="cs-fact">
          <span class="cs-fact-v">{f.v}</span>
          <span class="cs-fact-k">{f.k}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- ================= 01 THE LINEUP ================= -->
  <section class="cs-section" id="lineup" aria-labelledby="cs-lineup-title">
    <div class="cs-wrap">
      <header class="cs-head">
        <p class="cs-num">01 | The lineup</p>
        <h2 class="cs-h2" id="cs-lineup-title">Who's flying in.</h2>
        {/* SUMMIT-FORWARD: "will be in San Juan" */}
        <p class="cs-deck">
          The 3 people the summit led with are the World Economic Forum's former Head of AI, a principal
          research scientist from MIT's Senseable City Lab, and an AI advisor to the European Parliament, and
          all 3 will be in San Juan on October 9 and 10 along with more than 30 other speakers. I'm going to
          let that list make the case for Puerto Rico instead of making it myself (Edward, you live here, so
          nobody should take your word for it, and frankly you'd oversell it).
        </p>
      </header>

      <div class="cs-headliners">
        {headliners.map((h, i) => (
          <article class={`cs-headliner cs-headliner-${i + 1}`}>
            <div class="cs-headliner-photo">
              <img src={h.img} alt={h.alt} width="480" height="600" loading="lazy" decoding="async" />
            </div>
            <div class="cs-headliner-body">
              <p class="cs-slot">{h.slot}</p>
              <h3 class="cs-h3">{h.name}</h3>
              <p class="cs-role">{h.role}</p>
              <p class="cs-talk">{h.talk}</p>
              <p class="cs-note">{h.note}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="cs-program">
        <div class="cs-program-head">
          <h3 class="cs-h3 cs-h3-sm">Also on the program</h3>
          <p class="cs-program-deck">
            AI faculty from MIT, Carnegie Mellon, UC Berkeley, Penn, and SMU (where I got my data science
            degree, so I'm biased and I'll be in the front row), plus people building this for a living at
            Microsoft, Salesforce, Snowflake, Databricks, AWS, HPE, and a bunch more. Full list at{' '}
            <a class="cs-inline" href={SUMMIT} target="_blank" rel="noopener noreferrer">caribbeansummit.ai</a>.
          </p>
        </div>
        <ul class="cs-roster">
          {program.map((p) => (
            <li class="cs-person">
              <img
                src={`/images/caribbean-ai-summit/${p.img}.jpg`}
                alt={`${p.name}, headshot`}
                width="480"
                height="600"
                loading="lazy"
                decoding="async"
              />
              <div>
                <p class="cs-person-name">{p.name}</p>
                <p class="cs-person-org">{p.org}</p>
                <p class="cs-person-talk">{p.talk}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="cs-fineprint">
          Gary Crisci works at Caprus AI, where I'm an investor, so weigh my enthusiasm for his session
          accordingly. Headshots courtesy of the Caribbean AI Summit.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= LATEST DISPATCHES ================= -->
  {/* SUMMIT-FORWARD: LatestContent deck ("is actually going to disagree about") */}
  <LatestContent
    eyebrow="Between sessions"
    heading="Fresh <em>this week.</em>"
    deck="Writing and video, newest first, including this week's post on what a WEF, MIT, and EU Parliament lineup is actually going to disagree about."
  />

  <!-- ================= 02 THE PROGRAMME ================= -->
  <section class="cs-section cs-section-band" id="program" aria-labelledby="cs-program-title">
    <div class="cs-wrap">
      <header class="cs-head">
        <p class="cs-num">02 | The program</p>
        <h2 class="cs-h2" id="cs-program-title">2 days, 3 rooms.</h2>
        <p class="cs-deck">
          Business is in Ballroom B, Technical in Room 209, and Society in Room 208, all running at once, so
          you'll have to choose. If you run finance and you only have the patience for about 10 sessions,
          I've marked my route through both days (it isn't official, and I reserve the right to wander into
          the healthcare panel instead).
        </p>
      </header>

      <nav class="cs-daynav" aria-label="Jump to a day">
        {days.map((d) => (
          <a href={`#${d.id}`}>{d.day} | {d.date}</a>
        ))}
        <span class="cs-legend"><span class="cs-route-chip">Finance route</span> = on my route</span>
      </nav>

      {days.map((d) => (
        <div class="cs-day" id={d.id}>
          <h3 class="cs-day-title">
            <span class="cs-day-n">{d.day}</span>
            <span class="cs-day-d">{d.date}</span>
          </h3>

          <div class="cs-grid-head" aria-hidden="true">
            <span></span>
            {tracks.map((t) => (
              <span>{t.name} <em>{t.room}</em></span>
            ))}
          </div>

          <ol class="cs-rows">
            {d.rows.map((r) => (
              <li class={`cs-row${r.label ? ' cs-row-label' : ''}`}>
                <span class="cs-time">{r.time}</span>
                {r.label && <span class="cs-label">{r.label}</span>}
                {!r.label && (
                  <div class="cs-row-body">
                    {r.heading && <p class="cs-row-heading">{r.heading}</p>}
                    {r.plenary && (
                      <ul class="cs-plenary">
                        {r.plenary.map((p) => (
                          <li class={`cs-cell${p.route ? ' cs-route' : ''}`}>
                            {p.kind && <span class="cs-kind">{p.kind}</span>}
                            <span class="cs-title">{p.title}</span>
                            <span class="cs-who">{p.who}</span>
                            {p.route && <span class="cs-route-chip">Finance route</span>}
                          </li>
                        ))}
                      </ul>
                    )}
                    {!r.plenary && (
                      <div class="cs-tracks">
                        {tracks.map((t) => {
                          const sess = r[t.key];
                          return sess ? (
