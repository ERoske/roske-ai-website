  }
  :global([data-theme="dark"]) .panel-orig { color: var(--ra-amber); border-color: var(--color-border); }
  :global([data-theme="light"]) .panel-orig { color: var(--ra-amber-ink); border-color: var(--color-border-light); }
  .panel-body { font-family: var(--font-body); font-size: 0.97rem; line-height: 1.68; margin: 0; }
  :global([data-theme="dark"]) .panel-body { color: var(--color-text-muted); }
  :global([data-theme="light"]) .panel-body { color: var(--color-text-dark-muted); }

