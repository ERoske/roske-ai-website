---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// The lead story, set as newspaper columns. First paragraph gets the drop cap.
const lead = [
  `Spider-Man: Brand New Day opens Friday, and the entire premise is that the world forgot Peter Parker. He still does the job, and nobody knows whose job it is.`,
  `I got a quieter version of that deal. For 25 years I ran interRel, and inside the Oracle finance world the name did the introducing for me. Then I sold it, walked into AI rooms, and became a guy in a hat with opinions.`,
  `That turned out to be the useful part. When nobody expects last decade's answer from you, you get to build the new thing while nobody's watching. Right now the new thing is MCP servers that let AI agents work inside enterprise finance systems, plus a work week run by ten-plus AI agents who redesign this website every Saturday without asking me first.`,
  `I do still sell photographs of myself to the paper, because some habits survive a rebrand and that one pays.`,
];

// BY THE NUMBERS box. All real, plus the last one.
const numbers = [
  { value: '50+', label: 'Countries spoken in' },
  { value: '15', label: 'Books published' },
  { value: '25+', label: 'Years running companies' },
  { value: '10+', label: 'Agents running the week' },
  { value: '0', label: 'People at the badge table who knew' },
];

// Late bulletins. Static strap, no ticker.
const bulletins = [
  `SPIDER-MAN: BRAND NEW DAY OPENS FRIDAY, JULY 31. THIS PAPER HAS NO COMMENT ON THE COSTUME.`,
  `CARIBBEAN AI SUMMIT, OCTOBER 9-10, SAN JUAN. HE VOLUNTEERED TO CO-CHAIR IT AND HAS BEEN ANSWERING EMAIL ABOUT IT EVER SINCE.`,
  `WEBSITE REDESIGNED AGAIN OVERNIGHT BY HIS OWN AI AGENTS. NO ONE CONSULTED THE EDITOR.`,
];

// PAGE 3: the photo desk. Captions verified against each generated image.
// `alt` describes the picture for screen readers; `caption` is the joke.
const photoDesk = [
  {
    src: '/images/brand-new-day/newsroom-desk.jpg',
    alt: 'Edward Roske in his blue fedora, a red web-patterned mask bunched around his neck and a tweed blazer over the costume, leaning across a cluttered newsroom desk to slide a fan of black-and-white photographs toward an unimpressed cigar-chewing editor, under a corkboard of tabloid front pages.',
    slug: 'PLATE 01 / THE SALE',
    title: 'Selling to the Paper That Hates Him',
    caption: `I bring the pictures in myself, wearing a tweed blazer over the suit as though that settles the dress code. The editor complains about the framing, pays under rate, and runs them on the front page anyway.`,
    credit: 'PHOTO: E. ROSKE / SOLD TO THIS PAPER BY E. ROSKE',
    wide: true,
  },
  {
    src: '/images/brand-new-day/badge-table.jpg',
    alt: 'Edward Roske in a red-and-blue web-patterned suit and his blue fedora, leaning politely on a conference registration table while a volunteer in a staff polo scans a printed attendee list without looking up. The badge on the table reads GUEST.',
    slug: 'PLATE 02 / REGISTRATION',
    title: 'Name Not on the List',
    caption: `Twenty-five years in this industry and the badge came out reading GUEST. I let it stand. A room that has no idea what you used to be will actually listen to what you're saying now, which is a better trade than it sounds.`,
    credit: 'PHOTO: E. ROSKE / BADGE AUTHENTIC',
    wide: false,
  },
  {
    src: '/images/brand-new-day/stuck-to-wall.jpg',
    alt: 'Edward Roske in the web-patterned suit and his blue fedora, clinging to a brick alley wall at night and thoroughly tangled in white webbing, wearing an expression of calm acceptance, with a metal trash can and a puddle below him.',
    slug: 'PLATE 03 / THE ALLEY',
    title: 'Caught in Something I Made',
    caption: `Every new venture has a stretch where you're stuck to a wall in your own webbing at midnight. The trick is to hold a completely neutral expression until somebody walks past with scissors.`,
    credit: 'PHOTO: E. ROSKE / TIMER, TRASH CAN',
    wide: false,
  },
  {
    src: '/images/brand-new-day/curb-lunch.jpg',
    alt: 'Edward Roske in the web-patterned suit and his blue fedora, sitting on a curb outside a neon-lit San Juan corner store at night eating a sandwich with both hands while a tabby street cat sits beside him, watching the sandwich intently.',
    slug: 'PLATE 04 / COLMADO ROSA',
    title: 'Dinner Break, Curbside',
    caption: `The cat opened with a strong position on the sandwich and never came off it. Most productive negotiation I had all week, and I gave up less than I expected to.`,
    credit: 'PHOTO: E. ROSKE / CAT DECLINED TO COMMENT',
    wide: false,
  },
  {
    src: '/images/brand-new-day/home-office-webs.jpg',
    alt: 'Edward Roske in the web-patterned suit and his blue fedora, typing calmly at a home-office laptop in a room criss-crossed with white webbing across the bookshelves, windows and monitor, while a coffee mug stuck to the ceiling drips above his head.',
    slug: 'PLATE 05 / THE OFFICE',
    title: 'A Week Run by Ten Agents',
    caption: `This is roughly what it looks like from the inside: everything wired to everything, most of it holding, and one coffee mug permanently out of reach on the ceiling. I keep working, and the mug is a problem for a different agent.`,
    credit: 'PHOTO: E. ROSKE / MUG STILL UP THERE',
    wide: false,
  },
];

// PAGE 6: the city desk. Six real things, filed as news briefs.
const cityDesk = [
  {
    kicker: 'TECHNOLOGY',
    dateline: 'SAN JUAN, P.R.',
    title: 'The Servers That Let AI Touch the Ledger',
    body: `MCP servers are the connective tissue between AI agents and enterprise finance systems. Oracle Essbase and EPM Planning are shipping now, and Financial Close and Consolidations is in beta. It's unglamorous plumbing, and it's the part that decides whether any of this survives a real close. (I have now explained out loud what the letters MCP stand for something like four hundred times, and I'll happily do it again on request.)`,
    tag: 'ORACLE EPM / MCP',
    status: 'SHIPPING',
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    kicker: 'EVENTS',
    dateline: 'SAN JUAN, P.R.',
    title: 'Summit Returns to the Island in October',
    body: `Co-chairing the largest AI conference Puerto Rico has hosted, October 9 and 10 at the Convention Center. The lineup is public: Kay Firth-Butterfield, formerly Head of AI at the World Economic Forum, MIT's Fabio Duarte, EU Parliament AI advisor Idoia Salazar, and a bunch more still landing. (Co-chairing is ten percent stagecraft and ninety percent email.)`,
    tag: '9-10 OCT 2026',
    status: 'CALL FOR SPEAKERS OPEN',
    href: 'https://www.caribbeansummit.ai/en/speakers/submit',
    external: true,
    cta: 'Submit a speaker',
  },
  {
    kicker: 'BUSINESS',
    dateline: 'SAN JUAN, P.R.',
    title: 'Where the Actual Work Gets Done',
    body: `Investor and contributor at Caprus, the AI software and services firm building faster operations for finance teams. They do the engineering. I show up, point at it, and occasionally get quoted about it in this newspaper.`,
    tag: 'AI / FINANCE',
    status: 'RUNNING',
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    kicker: 'TRAVEL',
    dateline: 'KHUMBU, NEPAL',
    title: 'A Walk to the Foot of Everest',
    body: `This spring I walked to Everest Base Camp. I brought a map, asked the guides everything I could think of, and largely kept my head down through the altitude headaches. The full trail log is on the blog, including the parts that went badly.`,
    tag: 'NEPAL / 2026',
    status: 'TRAIL LOG LIVE',
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    kicker: 'AFTER HOURS',
    dateline: 'EBERRON',
    title: "An AI Behind the Dungeon Master's Screen",
    body: `A prototype AI screen for running 5e: initiative, lore lookups, and improv help for the person behind the cardboard. If there's going to be an oracle at my table, it can earn its seat like everyone else. (The party still gets told nothing.)`,
    tag: 'D&D / 5E',
    status: 'IN PROTOTYPE',
    href: null,
    external: false,
    cta: 'Quiet build',
  },
  {
    kicker: 'COMMUNITY',
    dateline: 'SAN JUAN, P.R.',
    title: '850 People Arguing About AI on an Island',
    body: `President of the Puerto Rico AI Community, now past 850 people across our events. We meet every other month and work out in public what AI actually means here, which mostly means arguing about it in two languages until something useful falls out.`,
    tag: '850+ MEMBERS',
    status: 'RUNNING',
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];
---

<BaseLayout>
  <WeeklyAnimation />

  <!-- ================= NAMEPLATE ================= -->
  <header class="np">
    <div class="np-inner">
      <div class="np-row">
        <div class="np-ear np-ear-l">
          <span>Late Edition</span>
          <span>San Juan, P.R.</span>
        </div>
        <div class="np-title" aria-label="The Daily Roske">The Daily Roske</div>
        <div class="np-ear np-ear-r">
          <span>Vol. LIV, No. 30</span>
          <span>Price: Still Free</span>
        </div>
      </div>
      <div class="np-rule"></div>
      <div class="np-folio">
        <span>SATURDAY, JULY 25, 2026</span>
        <span class="np-motto">"ALL THE NEWS ABOUT ONE GUY, WHETHER OR NOT YOU ASKED"</span>
        <span>WEATHER: HIGH OF 88, HUMID, WEBBING LIKELY</span>
      </div>
    </div>
  </header>

  <!-- ================= FRONT PAGE ================= -->
  <section class="front">
    <div class="front-inner">
      <div class="strap">
        <span class="strap-flag">EXCLUSIVE</span>
        <span class="strap-text">He sold the company and kept the hat, and he has not stopped filing copy since.</span>
      </div>

      <h1 class="screamer">Who <em>Is</em> This Man?</h1>

      <p class="subdeck">{theme.hero.subtitle} Formerly a name in Oracle finance, now unrecognized in every AI room he walks into. Says it's going better than it sounds.</p>

      <div class="byline">
        <span>By THE DAILY ROSKE STAFF</span>
        <span class="byline-sep">|</span>
        <span>Photographs by E. ROSKE</span>
        <span class="byline-sep">|</span>
        <span>Sold to this paper by E. ROSKE, at a rate we regret agreeing to</span>
      </div>

      <div class="front-grid">
        <figure class="lead-photo">
          <div class="lead-photo-frame">
            <img
              src={`/images/${theme.hero.heroImage}`}
              alt={theme.hero.imageAlt}
              width="1600"
              height="893"
              loading="eager"
              decoding="async"
              class="lead-photo-img"
            />
          </div>
          <figcaption class="lead-photo-cap">
            <strong>ABOVE:</strong> The subject photographs himself on the old city wall at dusk, beside a sign offering the results for sale. This paper bought four.
            <span class="credit">PHOTO: E. ROSKE / SELF, ARM'S LENGTH</span>
          </figcaption>
        </figure>

        <div class="lead-col">
          {lead.map((p, i) => (
            <p class={i === 0 ? 'lead-p lead-p-first' : 'lead-p'}>{p}</p>
          ))}
          <p class="jump">Continued on Page 3, with pictures</p>

          <div class="front-cta">
            <a href="/question/" target="_blank" rel="noopener" class="btn-ink">Book 13 minutes</a>
            <a href={theme.hero.ctaLink} class="btn-outline">{theme.hero.ctaText}</a>
          </div>
        </div>

        <aside class="numbers-box" aria-label="By the numbers">
          <h2 class="numbers-head">By the Numbers</h2>
          <dl class="numbers-list">
            {numbers.map(n => (
              <div class="numbers-row">
                <dt class="numbers-value">{n.value}</dt>
                <dd class="numbers-label">{n.label}</dd>
              </div>
            ))}
          </dl>
          <p class="numbers-foot">Figures supplied by the subject, who has an obvious interest in them.</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- ================= LATE BULLETINS ================= -->
  <section class="bulletins" aria-label="Late bulletins">
    <div class="bulletins-inner">
      <span class="bulletins-flag">Stop Press</span>
      <ul class="bulletins-list">
        {bulletins.map(b => <li class="bulletins-item">{b}</li>)}
      </ul>
    </div>
  </section>

  <!-- ================= LATEST CONTENT (permanent) ================= -->
  <LatestContent
    eyebrow="Off the wire"
    heading={"Filed <em>this week.</em>"}
    deck="The newest writing and video briefs, straight off the desk. Nothing here is held for a slow news day."
  />

  <!-- ================= BOOK EDWARD (permanent) ================= -->
  <SpeakerCTA eyebrow="Classified / Situations wanted" />

  <!-- ================= PAGE 3: THE PHOTO DESK ================= -->
  <section class="photodesk">
    <div class="photodesk-inner">
      <header class="sec-head">
        <div class="sec-slug">Page 3 / The Photo Desk</div>
        <h2 class="sec-title">Wire photos we <em>paid for.</em></h2>
        <p class="sec-deck">
          Every photograph in this issue is of the same man and was invoiced by the same man. Accounting has raised this twice. (We ran them anyway, which is the part he was counting on.)
        </p>
      </header>

      <div class="pd-grid">
        {photoDesk.map(p => (
          <figure class={p.wide ? 'pd-item pd-item-wide' : 'pd-item'}>
            <div class="pd-frame">
              <img src={p.src} alt={p.alt} loading="lazy" decoding="async" class="pd-img" />
              <span class="pd-slug">{p.slug}</span>
            </div>
            <figcaption class="pd-cap">
              <h3 class="pd-title">{p.title}</h3>
              <p class="pd-text">{p.caption}</p>
              <span class="credit">{p.credit}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= WHAT'S NEW (permanent) ================= -->
  <WhatsNew
    eyebrow="Press clippings"
    heading={"What the <em>other</em> papers ran."}
    deck="Interviews, mentions, awards, and the odd post worth clipping. Filed here so you can check the story against a second source."
  />

  <!-- ================= PAGE 12: OPINION ================= -->
  <section class="oped">
    <div class="oped-inner">
      <div class="oped-slug">Page 12 / Opinion / Signed, The Editor</div>
      <div class="oped-grid">
        <div class="oped-main">
          <h2 class="oped-scream">Menace!</h2>
          <p class="oped-p">
            This paper has said it before and will say it again. The man is a menace. He rebuilds his own website every Saturday morning without consulting anybody, including himself. He answers questions before they're finished, holds published opinions about Freeze Panes, and has been photographed webbed to a wall behind a colmado at an hour when respectable people are asleep.
          </p>
          <p class="oped-p">
            Our position is unchanged and will remain unchanged until he takes off the hat, which he has declined to do in writing.
          </p>
          <div class="oped-sig">The Editor</div>
        </div>
        <aside class="reply">
          <div class="reply-head">Right of Reply</div>
          <p class="reply-p">
            The hat stays. Everything else is negotiable, which is a more generous offer than most people lead with.
          </p>
          <p class="reply-p">
            If you want the long version, take thirteen minutes and decide for yourself. Bring the hard one.
          </p>
          <p class="reply-p reply-p-small">
            (A Roske never removes his fedora in the presence of others. There is one exception, and it is Memorial Day.)
          </p>
          <div class="reply-sig">Edward Roske</div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ================= PAGE 6: CITY DESK ================= -->
  <section id="current-work" class="citydesk">
    <div class="citydesk-inner">
      <header class="sec-head">
        <div class="sec-slug">Page 6 / City Desk / Ongoing</div>
        <h2 class="sec-title">Six stories <em>still developing.</em></h2>
        <p class="sec-deck">
          The work behind the costume. All six are real, and none of them involve webbing.
        </p>
      </header>

      <div class="cd-grid">
        {cityDesk.map(item => (
          <article class="cd-brief">
            <div class="cd-kicker">{item.kicker}</div>
            <h3 class="cd-title">{item.title}</h3>
            <p class="cd-body"><span class="cd-dateline">{item.dateline} |</span>{item.body}</p>
            <div class="cd-meta">
              <span class="cd-tag">{item.tag}</span>
              <span class="cd-status">{item.status}</span>
            </div>
            {item.href ? (
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
                class="cd-cta"
              >{item.cta}</a>
            ) : (
              <span class="cd-cta cd-cta-off">{item.cta}</span>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= PAGE 20: LETTERS ================= -->
  <section class="letters">
    <div class="letters-inner">
      <div class="letters-slug">Page 20 / Letters to the Editor</div>
      <h2 class="letters-title">Write in. <em>I'll allow it.</em></h2>
      <p class="letters-deck">
        Thirteen minutes on the phone, no charge and no pitch. Ask about AI inside the Office of the CFO, what an MCP server actually does on a Tuesday, whether the Caribbean AI Summit is worth the flight, or how a grown man ends up webbed to a wall in an alley. Answers arrive whether or not anyone requested them.
      </p>
      <div class="letters-cta">
        <a href="/question/" target="_blank" rel="noopener" class="btn-ink btn-big">Book 13 minutes</a>
        <a href="/contact" class="btn-outline btn-big">Send a note</a>
      </div>
    </div>
  </section>

  <!-- ================= COLOPHON ================= -->
  <footer class="colophon">
    <div class="colophon-inner">
      <p>
        THE DAILY ROSKE is a parody newspaper published by its own subject and is not affiliated with Marvel, Sony Pictures, the Daily Bugle, or any newspaper that employs actual reporters. Spider-Man: Brand New Day opens in theaters Friday, July 31, 2026, and had nothing to do with this. Edward really did run interRel for 25 years and really does build MCP servers for enterprise finance. The webbing is not real, the badge is, and the fedora stays on.
      </p>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ============================================================
     THE DAILY ROSKE  |  BRAND NEW DAY  |  2026-07-25
     A tabloid front page running a smear campaign on its owner.
     Palette: newsprint cream + ink black, tabloid spot red,
              press blue. Dark mode is the "night edition".
     Type: Newsreader (headlines), Libre Franklin (decks/body),
           Courier Prime (slugs, credits, folio),
           UnifrakturMaguntia (nameplate only).
     Atmosphere: Ben-Day halftone, column rules, drop caps,
                 jump lines, wire-photo credits. No motion.
     ============================================================ */

  :global([data-theme="dark"]) {
    --n-paper: #14110d;
    --n-paper2: #1d1913;
    --n-paper3: #221d16;
    --n-ink: #f2ece0;
    --n-muted: #b8ae9b;
    --n-rule: #3a3228;
    --n-red: #e2453f;
    --n-blue: #7ea2e8;
    --n-dot: rgba(242, 236, 224, 0.05);
    --n-onred: #14110d;
  }
  :global([data-theme="light"]) {
    --n-paper: #f3efe3;
    --n-paper2: #fbf8ef;
    --n-paper3: #ece6d6;
    --n-ink: #17140f;
    --n-muted: #544c3e;
    --n-rule: #d9d1bd;
    --n-red: #b3121b;
    --n-blue: #1c3f94;
    --n-dot: rgba(23, 20, 15, 0.055);
    --n-onred: #fbf8ef;
  }

  /* Ben-Day halftone, used as a section texture */
  .front, .photodesk, .citydesk, .letters {
    background-image: radial-gradient(var(--n-dot) 1px, transparent 1px);
    background-size: 5px 5px;
  }

  .credit {
    display: block;
    margin-top: 0.6rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--n-muted);
  }

  /* ---------------- NAMEPLATE ---------------- */
  .np {
    background: var(--n-paper2);
    color: var(--n-ink);
    border-bottom: 3px double var(--n-ink);
    padding: 2.4rem 2rem 0.7rem;
  }
  .np-inner { max-width: 1360px; margin: 0 auto; }
  .np-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: end;
  }
  .np-ear {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--n-muted);
    padding-bottom: 0.6rem;
  }
  .np-ear-r { text-align: right; }
  .np-title {
    font-family: 'UnifrakturMaguntia', 'Newsreader', serif;
    font-size: clamp(2.5rem, 8.5vw, 6.5rem);
    line-height: 0.95;
    text-align: center;
    color: var(--n-ink);
    white-space: nowrap;
  }
  .np-rule {
    height: 0;
    border-top: 1px solid var(--n-ink);
    border-bottom: 3px solid var(--n-ink);
    margin: 0.9rem 0 0.5rem;
  }
  .np-folio {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.63rem;
    letter-spacing: 0.1em;
    color: var(--n-muted);
  }
  .np-motto { color: var(--n-red); text-align: center; }
  @media (max-width: 900px) {
    .np { padding: 1.6rem 1.1rem 0.6rem; }
    .np-row { grid-template-columns: 1fr; gap: 0.5rem; }
    .np-ear { flex-direction: row; gap: 1rem; justify-content: center; padding-bottom: 0; font-size: 0.58rem; }
    .np-ear-r { text-align: center; }
    .np-folio { flex-direction: column; gap: 0.4rem; text-align: center; font-size: 0.55rem; }
  }

  /* ---------------- FRONT PAGE ---------------- */
  .front {
    background-color: var(--n-paper);
    color: var(--n-ink);
    padding: 2.6rem 2rem 4rem;
  }
  .front-inner { max-width: 1360px; margin: 0 auto; }

  .strap {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--n-rule);
    border-bottom: 1px solid var(--n-rule);
    padding: 0.55rem 0;
    margin-bottom: 1.6rem;
  }
  .strap-flag {
    background: var(--n-red);
    color: var(--n-onred);
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.28rem 0.6rem;
  }
  .strap-text {
    font-family: 'Libre Franklin', sans-serif;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--n-muted);
  }

  .screamer {
    font-family: 'Newsreader', serif;
    font-weight: 800;
    font-size: clamp(3.2rem, 11vw, 9rem);
    line-height: 0.87;
    letter-spacing: -0.03em;
    margin: 0 0 1.1rem;
    color: var(--n-ink);
  }
  .screamer em { font-style: italic; color: var(--n-red); }

  .subdeck {
    font-family: 'Libre Franklin', sans-serif;
    font-weight: 500;
    font-size: clamp(1.05rem, 1.9vw, 1.45rem);
    line-height: 1.45;
    color: var(--n-muted);
    max-width: 52em;
    margin: 0 0 1.4rem;
    border-left: 4px solid var(--n-red);
    padding-left: 1.1rem;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    font-family: 'Courier Prime', monospace;
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--n-muted);
    border-top: 1px solid var(--n-rule);
    border-bottom: 1px solid var(--n-rule);
