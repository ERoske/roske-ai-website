  }
  :global([data-theme="dark"]) .pass-k { color: var(--color-text-muted); }
  :global([data-theme="light"]) .pass-k { color: var(--color-text-dark-muted); }

  /* ---------- upgrade frame around SpeakerCTA ---------- */
  .upgrade { position: relative; padding-top: 1.6rem; }
