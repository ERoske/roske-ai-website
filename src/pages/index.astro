    padding-top: 1.4rem;
  }
  .er-reveal-foot a { color: var(--er-amber); }

  /* ---------- set dressing ---------- */
  .er-dressing {
    background: var(--er-bg);
    padding: clamp(3rem, 7vw, 5.5rem) 1.5rem;
    position: relative;
  }
  .er-dressing::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--er-wood);
  }
  .er-dressing-inner {
    position: relative;
    max-width: 84rem;
    margin: 0 auto;
  }
  .er-dressing-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .er-plates {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.6rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .er-plates { grid-template-columns: 1fr; }
  }
  .er-plate {
    margin: 0;
    transform: rotate(var(--tilt, 0deg));
  }
  .er-plate figcaption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.68;
    color: var(--er-muted);
    margin: 1.1rem 0 0 0.2rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--color-accent);
    max-width: 54ch;
  }
  .er-plate-wide { align-self: center; }

  /* ---------- objects ---------- */
  .er-objects {
    background: var(--er-surface);
    border-top: 1px solid var(--er-line);
    padding: clamp(3rem, 7vw, 5.5rem) 1.5rem;
  }
  .er-objects-inner {
    max-width: 84rem;
    margin: 0 auto;
  }
  .er-objects-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .er-obj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1.2rem;
  }
  .er-obj {
    display: flex;
    flex-direction: column;
    background: var(--er-bg);
    border: 1px solid var(--er-line);
    padding: 1.5rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .er-obj:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 30px var(--er-glow);
    transform: translateY(-3px);
  }
  .er-obj-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .er-obj-tag,
  .er-obj-state {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .er-obj-tag { color: var(--er-muted); }
  .er-obj-state {
    border: 1px solid currentColor;
    padding: 0.2rem 0.55rem;
  }
  [data-theme="dark"] .er-obj-state-go { color: var(--er-amber); }
  [data-theme="light"] .er-obj-state-go { color: #8a5410; }
  [data-theme="dark"] .er-obj-state-done { color: #7fc6a4; }
  [data-theme="light"] .er-obj-state-done { color: #1c6444; }
  [data-theme="dark"] .er-obj-state-hold { color: #9fb3ad; }
  [data-theme="light"] .er-obj-state-hold { color: #55635f; }
  .er-obj-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--er-text);
    margin: 0 0 0.8rem;
  }
  .er-obj-note {
    font-size: 0.93rem;
    line-height: 1.7;
    color: var(--er-muted);
    margin: 0 0 1.4rem;
    flex: 1 1 auto;
  }
  .er-obj-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }
  .er-obj-cta:hover { text-decoration: underline; text-underline-offset: 4px; }
  .er-obj-cta-off {
    color: var(--er-muted);
    cursor: default;
  }

  /* ---------- closing CTA ---------- */
  .er-cta {
    position: relative;
    background: var(--er-teal-2);
    padding: clamp(3rem, 7vw, 5.5rem) 1.5rem;
    overflow: hidden;
    border-top: 1px solid #3a5250;
  }
  .er-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(50% 60% at 50% 0%, rgba(226, 166, 72, 0.16), transparent 72%), var(--er-grain);
    opacity: 0.7;
  }
  .er-cta-inner {
    position: relative;
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
  }
  .er-cta-inner .er-deck { margin: 0 auto; }
  .er-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2.2rem;
  }
  /* the CTA band is dark in both modes, so its buttons stay on the amber pair */
  [data-theme="light"] .er-cta .er-btn-solid {
    background: var(--er-amber);
    border-color: var(--er-amber);
    color: #10191a;
  }
  [data-theme="light"] .er-cta .er-btn-line {
    color: var(--er-amber);
    border-color: var(--er-amber);
  }
  [data-theme="light"] .er-cta .er-btn-line:hover {
    background: var(--er-amber);
    color: #10191a;
  }
  [data-theme="light"] .er-room .er-btn-solid,
  [data-theme="light"] .er-door .er-btn-solid {
    background: var(--er-amber);
    border-color: var(--er-amber);
    color: #10191a;
  }

  @media (prefers-reduced-motion: reduce) {
    .er-obj,
    .er-btn-solid,
    .er-btn-line,
    .er-q { transition: none; }
    .er-obj:hover { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    let tick = null;

    function stopClock() {
      if (tick) {
        clearInterval(tick);
        tick = null;
      }
    }

    function boot() {
      stopClock();

      const room = document.getElementById('the-room');
      if (!room) return;

      // --- the clock. Decorative, non-punitive, and it says so on the face.
      const clock = document.getElementById('er-clock');
      if (clock) {
        let left = parseInt(clock.getAttribute('data-seconds') || '3600', 10);
        const paint = function () {
          const m = Math.floor(left / 60);
          const s = left % 60;
          clock.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
        };
        paint();
        tick = setInterval(function () {
          left -= 1;
          if (left <= 0) {
            left = 0;
            paint();
            stopClock();
            const note = clock.parentElement && clock.parentElement.querySelector('.er-clock-note');
            if (note) note.textContent = 'Time. The door is exactly as locked as it was.';
            return;
          }
          paint();
        }, 1000);
      }

      // --- the stations
      const solved = {};

      function openStation(id) {
        if (solved[id]) return;
        solved[id] = true;
        const station = room.querySelector('[data-station="' + id + '"]');
        if (station) station.classList.add('is-solved');
        const state = room.querySelector('[data-state-for="' + id + '"]');
        if (state) {
          state.textContent = 'Open';
          state.classList.add('is-open');
        }
        const got = room.querySelector('[data-got-for="' + id + '"]');
        if (got) got.hidden = false;
        const why = room.querySelector('[data-why-for="' + id + '"]');
        if (why) why.hidden = false;
      }

      const asks = room.querySelectorAll('[data-ask]');
      Array.prototype.forEach.call(asks, function (btn) {
        btn.addEventListener('click', function () {
          const id = btn.getAttribute('data-ask');
          const out = room.querySelector('[data-text-for="' + id + '"]');
          if (out) out.textContent = btn.getAttribute('data-answer') || '';

          // Mark every sibling asked, then flag this one.
          const siblings = room.querySelectorAll('[data-ask="' + id + '"]');
          Array.prototype.forEach.call(siblings, function (s) {
            if (s === btn) return;
            if (!s.classList.contains('is-key')) s.classList.add('is-asked');
          });
          btn.classList.remove('is-asked');

          if (btn.getAttribute('data-ok') === 'yes') {
            btn.classList.add('is-key');
            openStation(id);
          }
        });
      });

      // --- the door
      const form = document.getElementById('er-lock-form');
      const msg = document.getElementById('er-door-msg');
      const reveal = document.getElementById('er-reveal');
      const d1 = document.getElementById('er-d1');
      const d2 = document.getElementById('er-d2');
      const d3 = document.getElementById('er-d3');
      const KEY = ['13', '25', '300'];

      function openDoor(gaveUp) {
        if (reveal) reveal.hidden = false;
        if (msg) {
          msg.className = 'er-door-msg is-good';
          msg.textContent = gaveUp
            ? 'Opened with the answer key. That counts. Everybody uses the key eventually.'
            : 'The handle turns. Three good questions, one door.';
        }
        stations();
        if (reveal) {
          reveal.setAttribute('tabindex', '-1');
          reveal.focus({ preventScroll: true });
          reveal.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function stations() {
        ['shelf', 'timeline', 'wall'].forEach(openStation);
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          const got = [d1, d2, d3].map(function (el) {
            return (el && el.value ? el.value : '').replace(/\D/g, '').trim();
          });
          if (got.join('') === '') {
            if (msg) {
              msg.className = 'er-door-msg';
              msg.textContent = 'The dials are empty. The door notices.';
            }
            return;
          }
          const right = got[0] === KEY[0] && got[1] === KEY[1] && got[2] === KEY[2];
          if (right) {
            openDoor(false);
            return;
          }
          const hits = got.filter(function (g, i) { return g === KEY[i]; }).length;
          if (msg) {
            msg.className = 'er-door-msg is-bad';
            msg.textContent =
              hits === 0
                ? 'Nothing moves. None of the three are right, which at least is a clean result.'
                : hits + ' of 3 are right. The door will not tell you which, and neither will I.';
          }
        });
      }

      const giveup = document.getElementById('er-giveup');
      if (giveup) {
        giveup.addEventListener('click', function () {
          if (d1) d1.value = KEY[0];
          if (d2) d2.value = KEY[1];
          if (d3) d3.value = KEY[2];
          // Light up the winning question at each station too, so the answer
          // key actually teaches instead of just opening the door.
          const keys = room.querySelectorAll('[data-ok="yes"]');
          Array.prototype.forEach.call(keys, function (k) {
            k.classList.add('is-key');
            const id = k.getAttribute('data-ask');
            const out = room.querySelector('[data-text-for="' + id + '"]');
            if (out) out.textContent = k.getAttribute('data-answer') || '';
          });
          openDoor(true);
        });
      }
    }

    document.addEventListener('astro:page-load', boot);
    document.addEventListener('astro:before-swap', stopClock);
    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);
  })();
</script>
