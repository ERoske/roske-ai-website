  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var boss = document.querySelector('[data-tm-boss]');
      var round = document.querySelector('[data-tm-round]');
      var timer = document.querySelector('[data-tm-timer]');
      // The opponent's health drains as you read the page.
      function drain() {
        if (!boss) return;
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var pct = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        boss.style.width = Math.max(0, 100 - pct * 100) + '%';
        if (round) round.textContent = pct > 0.97 ? 'K.O.' : 'Round 1';
      }
      window.addEventListener('scroll', drain, { passive: true });
      drain();
      // The round timer counts down, then resets (there is always another close).
      if (timer && !reduce) {
        var t = 99;
        setInterval(function () {
          t = t <= 0 ? 99 : t - 1;
          timer.textContent = (t < 10 ? '0' : '') + t;
        }, 1000);
      }
      // Continue? counts 9 to 0 once the CTA is on screen.
      var cont = document.querySelector('[data-tm-continue]');
      if (cont && 'IntersectionObserver' in window && !reduce) {
        var started = false;
        new IntersectionObserver(function (entries, obs) {
          if (started || !entries[0].isIntersecting) return;
          started = true;
          obs.disconnect();
          var n = 9;
          var id = setInterval(function () {
            n -= 1;
            if (n <= 0) {
              clearInterval(id);
              cont.textContent = '0 (the button still works)';
            } else {
              cont.textContent = String(n);
            }
          }, 1000);
        }, { threshold: 0.4 }).observe(cont);
      }
    })();
  </script>
