---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// ---------------------------------------------------------------------------
// TRAINING MODE (2026-10-17). Street Fighter opened October 16 (set in 1993),
// so the site is a 1993 arcade fighting game. The argument: most enterprise
// AI pilots are fought in Training Mode, where the dummy never hits back.
// Every image of Edward is generated (headshot as reference, blue fedora).
// No Capcom characters, logos, or move names anywhere: the opponents are the
// ones finance teams actually face, and the special moves are Edward's talks.
// ---------------------------------------------------------------------------

const IMG = '/images/training-mode';
const CAL = 'https://calendar.app.google/udtTerQwcX9Z7QQt7';

// Fighter select: the stat card. Values are out of 10.
const statBars = [
  { k: 'Essbase', v: 10, note: 'First perfect score on the certification exam' },
  { k: 'Questions per minute', v: 9, note: `It's the name of the podcast` },
  { k: 'Fedora retention', v: 10, note: 'See the knockout photo below' },
  { k: 'Small talk', v: 2, note: 'Introvert, professionally disguised' },
  { k: 'Patience for no Freeze Panes', v: 0, note: 'Row 4,000, which column is this?' },
];

// The stats strip under the hero. Same 4 numbers every week.
const stats = [
  { v: '80+', k: 'Countries visited' },
  { v: '50+', k: 'Countries spoken in' },
  { v: '15', k: 'Books' },
  { v: '25', k: 'Years running interRel' },
];

// Training Mode vs Arcade Mode. The argument of the week, as a table.
const modes = [
  {
    k: 'The opponent',
    training: 'A tidy sample of 3 months of data that somebody cleaned up for the demo.',
    arcade: 'Your actual general ledger, with 14 years of mapping exceptions and an account named MISC-OTHER-2.',
  },
  {
    k: 'Health',
    training: 'Infinite. Reset it whenever you like.',
    arcade: 'One close a month, and the board sees how it went.',
  },
  {
    k: 'Blocking',
    training: 'The dummy never blocks.',
    arcade: 'Your users block constantly: they keep the old spreadsheet open next to the AI and believe the spreadsheet.',
  },
  {
    k: 'Round timer',
    training: 'Off.',
    arcade: `6:40 PM on Day 3 of close, and intercompany still doesn't tie out.`,
  },
  {
    k: 'Win screen',
    training: 'A green checkmark on slide 14.',
    arcade: 'A number somebody signs.',
  },
];

// The ladder. Opponents every finance team actually fights. The last one is
// the final boss, and it gets the knockout photo.
const ladder = [
  {
    no: '01',
    name: 'The Demo',
    stage: 'A vendor booth in Las Vegas',
    move: 'Perfect Dataset',
    moveNote: 'It brought its own data, and its own data has never once been late.',
    weak: 'Your data.',
    counter: 'Ask it to run on a month of your real ledger, live, while you watch. Most demos have a scheduling conflict that day.',
  },
  {
    no: '02',
    name: 'The Confident Hallucination',
    stage: 'Any chat window',
    move: 'Fluent Wrong Number',
    moveNote: 'Quotes your Q3 revenue to 2 decimal places from memory, which is a polite way of saying it made the number up.',
    weak: 'A source.',
    counter: `Connect it to the system of record so it reads the number instead of remembering one (that's the whole reason I build MCP servers), and make it show where every figure came from.`,
  },
  {
    no: '03',
    name: 'The Eternal Pilot',
    stage: 'A steering committee, forever',
    move: 'Phase 2',
    moveNote: 'Whenever it starts to lose, it announces a Phase 2 and the round resets.',
    weak: 'A kill date.',
    counter: 'Write down, before it starts, the result that ends the pilot in either direction. Then actually look at the calendar.',
  },
  {
    no: '04',
    name: 'The Spreadsheet Without Freeze Panes',
    stage: 'Somebody shared it with you',
    move: 'Scroll of Confusion',
    moveNote: `You're on row 4,000 and the headers left about 3,960 rows ago, so column AF could be anything (revenue, a date, somebody's lunch order, you name it).`,
    weak: 'View, then Freeze Panes.',
    counter: `View, then Freeze Panes. (This one has nothing to do with AI. It's my personal nemesis, and it's my ladder.)`,
  },
  {
    no: '05',
    name: 'Shadow AI',
    stage: 'An open browser tab',
    move: 'Paste and Pray',
    moveNote: 'Your analyst pastes the board deck into whichever free chatbot was already open.',
    weak: 'An approved tool that is easier than the free one.',
    counter: `Banning it mostly moves it to people's phones, so give them a sanctioned tool that's better than the one they found (and easier to log into, which is usually where these things lose).`,
  },
];

const boss = {
  name: 'Month-End Close',
  stage: 'Your finance department, every month',
  record: 'Undefeated since Luca Pacioli wrote down double-entry bookkeeping in 1494',
  move: 'Day 3 Surprise',
  moveNote: `Everything ties until the morning it doesn't, and then the reconciliation you skipped in March comes back for you.`,
  counter: `Nobody has beaten it in 532 years, so the realistic goal is a shorter fight: automate the reconciliations first and the commentary last, and keep a human on every number that leaves the building.`,
};

// The move list: Edward's talks, with joystick inputs. All 4 live on /speaking/.
const moves = [
  {
    input: '↓ ↘ → + P (×10)',
    title: 'Your Day, Run by Ten Agents',
    type: 'Keynote | Fireside | Most booked',
    note: `My own life runs on 10+ AI agents (calendar, inbox, research, writing, code, and the one rebuilding this website every Saturday at 5AM), and this is the tour of the actual stack, so executives can build the same thing without an engineering degree.`,
  },
  {
    input: '← (charge) → + K',
    title: `Answers to the Questions You've Been Quietly Asking Yourself About AI`,
    type: 'Keynote | Fireside | Offsite opener',
    note: `The questions senior leaders won't ask in a meeting because everyone else in the meeting seems to know the answer (they don't), answered from every episode of Asking Good Questions I've recorded so far.`,
  },
  {
    input: '→ ↓ ↘ + P',
    title: 'The Computer-First Finance Department',
    type: 'Keynote | Workshop pairing | Finance events',
    note: `What finance should automate first and what it should never automate at all. This is the one that fights Month-End Close directly, so it pairs nicely with the workshop.`,
  },
  {
    input: '360° + P',
    title: 'Building a Company in the Era of AI',
    type: 'Keynote | PE annual meetings | Board retreats',
    note: `A grab move: your product, your pricing, your staffing plan, your org chart, your competition, and probably your board deck are all being re-priced by the same technology at once, and this talk is about what to do when they are. I founded interRel at 22 and ran it for 25 years, so I've redone a plan or two.`,
  },
];

// Previous round: the Caribbean AI Summit recap stays on the page.
const recapPhotos = [
  { file: 'opening-batucada.jpg', w: 800, h: 533, alt: 'A batucada band in red with a trombone and drums, plus two stilt walkers, greeting attendees as they walk into the Caribbean AI Summit', caption: 'Day 1: the opening batucada.' },
  { file: 'edward-opening-keynote.jpg', w: 800, h: 533, alt: 'Edward in a blue fedora talking with two men in suits beside a screen that reads Opening Keynote 9:00', caption: 'Me (the fedora) right before the opening keynote.' },
  { file: 'volunteers.jpg', w: 800, h: 533, alt: 'A large group of volunteers in teal Caribbean AI Summit shirts posing in front of the sponsor wall', caption: 'The volunteers, who carried the whole game.' },
];
const recapStats = [
  { v: '800+', k: 'People' },
  { v: '17', k: 'Countries' },
  { v: '44', k: 'Speakers' },
  { v: '29', k: 'Hackathon projects' },
];

// The save file: the 6 projects. Same projects every week.
const projects = [
  {
    no: '01',
    name: 'MCP Servers for Enterprise Finance',
    state: 'Shipping',
    note: `Plumbing so an AI reads the real number out of Essbase and Oracle EPM instead of remembering one that sounds about right (the counter to opponent 02, above). Essbase and EPM Planning have shipped, and Financial Close and Consolidations is in beta.`,
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    no: '02',
    name: 'Caribbean AI Summit',
    state: 'Cleared, October 2026',
    note: `Co-chaired it on October 9 and 10: 800+ people, 17 countries, 44 speakers, and 6 fire extinguishers Dawn bought at Walmart at 7:30 in the morning. The whole story is on the blog.`,
    href: '/blog/how-many-fire-extinguishers-does-an-ai-summit-need/',
    external: false,
    cta: 'Read the recap',
  },
  {
    no: '03',
    name: 'Caprus',
    state: 'Investor',
    note: `I'm an investor, and that's the whole job. Lillian Buziak runs it, and they sell and support AgentCube (the MCP servers above), which spares everybody from having me do it.`,
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    no: '04',
    name: 'Everest Base Camp',
    state: 'Cleared, April 2026',
    note: `Two weeks on foot to 18,571 feet with Dawn, which is the closest I've come to an actual endurance round. The trail log is on the blog, including the last 400 feet of Kala Patthar.`,
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    no: '05',
    name: "AI Dungeon Master's Screen",
    state: 'Quiet build',
    note: `A prototype screen for running 5e: lore lookups and improvisation help for the person behind the cardboard. It hasn't earned a dollar and it isn't finished, which is about what you'd expect from a project whose main customer is me.`,
    href: null,
    external: false,
    cta: 'Not public yet',
  },
  {
    no: '06',
    name: 'Puerto Rico AI Community',
    state: 'Every other month',
    note: `President of the island's AI community (unpaid, obviously), now past 1,000 different people through the door. Bi-monthly, free, both languages, and the reason the summit exists at all.`,
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];
---

<BaseLayout>
  <WeeklyAnimation />

  <!-- ================= TITLE SCREEN ================= -->
  <section class="tm-hero" aria-labelledby="tm-hero-title">
    <img
      class="tm-hero-img"
      src={`/images/${theme.hero.heroImage}`}
      alt={theme.hero.imageAlt}
      width="1600"
      height="893"
      fetchpriority="high"
      decoding="async"
    />
    <div class="tm-hero-shade" aria-hidden="true"></div>
    <div class="tm-scan" aria-hidden="true"></div>

    <div class="tm-hud" aria-hidden="true">
      <div class="tm-hud-side">
        <span class="tm-hud-name">Edward</span>
        <div class="tm-bar"><span class="tm-bar-fill tm-bar-p1"></span></div>
      </div>
      <div class="tm-hud-mid">
        <span class="tm-hud-timer" data-tm-timer>99</span>
        <span class="tm-hud-round" data-tm-round>Round 1</span>
      </div>
      <div class="tm-hud-side tm-hud-side-r">
        <span class="tm-hud-name">Month-End Close</span>
        <div class="tm-bar tm-bar-r"><span class="tm-bar-fill tm-bar-p2" data-tm-boss></span></div>
      </div>
    </div>

    <div class="tm-hero-inner">
      <p class="tm-kicker">Saturday, October 17, 2026 | Street Fighter opened in theaters Friday, October 16</p>
      <h1 class="tm-title" id="tm-hero-title">
        <span class="tm-title-a">Training</span>
        <span class="tm-title-b">Mode</span>
      </h1>
      <p class="tm-hero-sub">{theme.hero.subtitle}</p>
      <p class="tm-hero-lede">
        So your AI pilot won (congratulations, and I mean that, mostly). It was also fought in Training Mode,
        where the dummy stands there with infinite health and never once hits back. I ran interRel for 25 years (1997
        to 2022, which is a lot of quarters, and a lot of month-end closes) helping finance teams put planning
        software to work, and this week the whole site is a 1993 arcade game about beating the dummy versus beating
        the close.
      </p>
      <div class="tm-hero-ctas">
        <a class="tm-btn tm-btn-coin" href={theme.hero.ctaLink}>{theme.hero.ctaText}</a>
        <a class="tm-btn tm-btn-ghost" href="#ladder">See the opponents</a>
      </div>
      <p class="tm-press" aria-hidden="true">Press start</p>
    </div>
  </section>

  <ul class="tm-stats" aria-label="Edward by the numbers">
    {stats.map((s) => (
      <li><span class="tm-stat-v">{s.v}</span><span class="tm-stat-k">{s.k}</span></li>
    ))}
  </ul>

  <!-- ================= FIGHTER SELECT ================= -->
  <section class="tm-section" id="select" aria-labelledby="tm-select-title">
    <div class="tm-wrap tm-select">
      <figure class="tm-portrait">
        <img src={`${IMG}/dojo.jpg`} alt="Edward in a navy suit, tie, and blue fedora, kneeling on a tatami mat in a quiet wooden dojo, studying an enormous open binder of accounting printouts, a laptop and a cup of tea beside him." width="1195" height="1600" loading="lazy" decoding="async" />
        <figcaption>Training montage. The binder is the opponent.</figcaption>
      </figure>
      <div class="tm-select-body">
        <p class="tm-eyebrow">Select your fighter | 1 player</p>
        <h2 class="tm-h2" id="tm-select-title">Edward Roske</h2>
        <dl class="tm-dossier">
          <div><dt>Fighting style</dt><dd>Asking Good Questions (a Socratic school, picked up at Shimer College)</dd></div>
          <div><dt>Home stage</dt><dd>San Juan, Puerto Rico (previously The Great State of Texas, for 25+ years)</dd></div>
          <div><dt>Signature item</dt><dd>Blue fedora. A Roske never removes his fedora in the presence of others.</dd></div>
          <div><dt>Unlocks</dt><dd>15 books, an ODTUG Lifetime Achievement Award, and a stage in 50+ countries on all 7 continents (yes, Antarctica too)</dd></div>
        </dl>
        <ul class="tm-statbars">
          {statBars.map((s) => (
            <li>
              <span class="tm-statbar-k">{s.k}</span>
              <span class="tm-statbar-track" role="img" aria-label={`${s.v} out of 10`}>
                {Array.from({ length: 10 }).map((_, i) => (
                  <span class:list={['tm-pip', { on: i < s.v }]}></span>
                ))}
              </span>
              <span class="tm-statbar-note">{s.note}</span>
            </li>
          ))}
        </ul>
        <p class="tm-select-copy">
          I founded interRel at 22, ran it for 25 years, and merged it with Keste to help found Argano. These days I build MCP servers for finance, invest in AI companies, run D&amp;D for my sons whenever I can find the time, and get on stages to explain what any of that (well, not the D&amp;D) means for the people running a business (with a stat line like that, you'd think I'd win more often, and you'll see below how
          that's going).
        </p>
      </div>
    </div>
  </section>

  <!-- ================= LATEST DISPATCHES ================= -->
  <LatestContent
    eyebrow="Patch notes"
    heading="New <em>this week.</em>"
    deck="Writing and video, newest first, including this week's post on whether your AI pilot is stuck in Training Mode."
  />

  <!-- ================= TRAINING MODE VS ARCADE MODE ================= -->
  <section class="tm-section tm-band" id="modes" aria-labelledby="tm-modes-title">
    <div class="tm-wrap">
      <header class="tm-head">
        <p class="tm-eyebrow">Mode select</p>
        <h2 class="tm-h2" id="tm-modes-title">Your pilot passed. Which mode was it in?</h2>
        <p class="tm-deck">
          Every serious player spends hours in Training Mode, and they should: it's where you learn the inputs.
          The trouble starts when someone announces they've won the tournament from inside it. Here's how to
          tell which mode your AI pilot was actually played in (if you're not sure, it was Training Mode).
        </p>
      </header>
      <div class="tm-modes">
        <figure class="tm-modes-fig">
          <img src={`${IMG}/training-dummy.jpg`} alt="Edward in a navy suit and blue fedora, beaming, presenting a laptop on a padded stand in an empty grey simulator room with a glowing grid floor; the laptop shows a rising bar chart with a giant green checkmark." width="1600" height="1195" loading="lazy" decoding="async" />
          <figcaption>Training Mode, where I'm undefeated (the dummy has been very cooperative).</figcaption>
        </figure>
        <div class="tm-modes-table" role="table" aria-label="Training Mode compared with Arcade Mode">
          <div class="tm-mrow tm-mrow-head" role="row">
            <span role="columnheader"></span>
            <span role="columnheader" class="tm-m-tr">Training Mode</span>
            <span role="columnheader" class="tm-m-ar">Arcade Mode</span>
          </div>
          {modes.map((m) => (
            <div class="tm-mrow" role="row">
              <span role="rowheader" class="tm-m-k">{m.k}</span>
              <span role="cell" class="tm-m-tr-cell">{m.training}</span>
              <span role="cell" class="tm-m-ar-cell">{m.arcade}</span>
            </div>
          ))}
        </div>
      </div>
      <p class="tm-modes-advice">
        <strong>Before your next pilot, write down what Arcade Mode looks like:</strong> a full month of your actual
        ledger, the skeptical users (especially whoever built the spreadsheet it's replacing), a run during a real
        close, and the result that ends the pilot in either direction. If the vendor won't fight there, ask them why
        and write that down too (the longer version is <a href="/blog/is-your-ai-pilot-stuck-in-training-mode/">over on the blog</a>).
      </p>
    </div>
  </section>

  <!-- ================= BOOK EDWARD ================= -->
  <SpeakerCTA eyebrow="Here comes a new challenger" />

  <!-- ================= THE LADDER ================= -->
  <section class="tm-section" id="ladder" aria-labelledby="tm-ladder-title">
    <div class="tm-wrap">
      <header class="tm-head">
        <p class="tm-eyebrow">Arcade Mode | 6 stages</p>
        <h2 class="tm-h2" id="tm-ladder-title">The ladder every finance team climbs.</h2>
        <p class="tm-deck">
          Five opponents and a final boss, with a special move, a weakness, and a counter for each (Stage 04
          predates AI by several decades and is also a personal grudge).
        </p>
      </header>
      <ol class="tm-ladder">
        {ladder.map((o) => (
          <li class="tm-opp">
            <div class="tm-opp-top">
              <span class="tm-opp-no">Stage {o.no}</span>
              <span class="tm-vs" aria-hidden="true">VS</span>
            </div>
            <h3 class="tm-opp-name">{o.name}</h3>
            <p class="tm-opp-stage">Stage: {o.stage}</p>
            <p class="tm-opp-move"><span class="tm-label">Special move</span> <strong>{o.move}.</strong> {o.moveNote}</p>
            <p class="tm-opp-weak"><span class="tm-label">Weakness</span> {o.weak}</p>
            <p class="tm-opp-counter"><span class="tm-label">Counter</span> {o.counter}</p>
          </li>
        ))}
      </ol>

      <article class="tm-boss" aria-labelledby="tm-boss-title">
        <figure class="tm-boss-fig">
          <img src={`${IMG}/ko.jpg`} alt="Edward in a navy suit lying flat on his back on a boardroom carpet in slapstick defeat, eyes closed, glasses askew, blue fedora still on his head, under a ceiling-high tower of overflowing accounting binders, spreadsheets fluttering through the air." width="1600" height="1195" loading="lazy" decoding="async" />
          <span class="tm-ko" aria-hidden="true">K.O.</span>
        </figure>
        <div class="tm-boss-body">
          <p class="tm-eyebrow tm-eyebrow-red">Stage 06 | Final boss</p>
          <h3 class="tm-boss-name" id="tm-boss-title">{boss.name}</h3>
          <p class="tm-opp-stage">Stage: {boss.stage}</p>
          <p class="tm-boss-record">{boss.record}.</p>
          <p class="tm-opp-move"><span class="tm-label">Special move</span> <strong>{boss.move}.</strong> {boss.moveNote}</p>
          <p class="tm-opp-weak"><span class="tm-label">Weakness</span> None known.</p>
          <p class="tm-opp-counter"><span class="tm-label">Counter</span> {boss.counter}</p>
          <p class="tm-boss-cap">
            That's me, about 4 seconds into the round (Edward, you had 25 years to study this boss). The fedora stayed on (a Roske never removes his fedora in
            the presence of others, and that includes binders).
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- ================= MOVE LIST ================= -->
  <section class="tm-section tm-band" id="moves" aria-labelledby="tm-moves-title">
    <div class="tm-wrap">
      <header class="tm-head">
        <p class="tm-eyebrow">Pause | Move list</p>
        <h2 class="tm-h2" id="tm-moves-title">4 special moves, available for your event.</h2>
        <p class="tm-deck">
          These are my talks, with the inputs. The joystick notation is decorative (please don't try it on the
          speaking page, it's just a normal form, and a nice one).
        </p>
      </header>
      <ol class="tm-moves">
        {moves.map((m) => (
          <li class="tm-move">
            <span class="tm-move-input">{m.input}</span>
            <div>
              <h3 class="tm-move-title">{m.title}</h3>
              <p class="tm-move-type">{m.type}</p>
              <p class="tm-move-note">{m.note}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="tm-btn tm-btn-solid" href="/speaking/">See all 4 talks, with fees</a>
    </div>
  </section>

  <!-- ================= PREVIOUS ROUND: THE SUMMIT ================= -->
  <section class="tm-section" id="recap" aria-labelledby="tm-recap-title">
    <div class="tm-wrap">
      <figure class="tm-victory">
        <img src={`${IMG}/victory.jpg`} alt="Edward in a navy jacket, loose tie, and blue fedora, one fist raised in victory on the stone walls of El Morro in San Juan at sunset, a round sentry box beside him and waves breaking behind." width="1600" height="893" loading="lazy" decoding="async" />
        <span class="tm-win" aria-hidden="true">You win</span>
      </figure>
      <div class="tm-recap">
        <div>
          <p class="tm-eyebrow">Previous round | Home stage</p>
          <h2 class="tm-h2" id="tm-recap-title">The Caribbean AI Summit, cleared.</h2>
          <p>
            On October 9 and 10, more than 800 people from 17 countries and 18 US states came to the Puerto Rico
            Convention Center for the first Caribbean AI Summit, which I co-chaired, and heard 44 speakers across 3
            tracks with live captions in English and Spanish. The bonus round happened at 7:30 on Friday morning,
            when we found out every booth needed its own fire extinguisher, and Dawn drove to Walmart and came back
            with 6 of them before the fire marshals walked in.
          </p>
          <p>
            The victory photo on the walls of El Morro is generated (El Morro wasn't on the agenda), but the
            summit really happened, and the photos below are real. Will there be a 2nd annual Caribbean AI Summit
            (to make it actually, you know, annual)? You'll just have to stay tuned to find out.
          </p>
          <ul class="tm-recap-stats">
            {recapStats.map((s) => (
              <li><span class="tm-stat-v">{s.v}</span><span class="tm-stat-k">{s.k}</span></li>
            ))}
          </ul>
          <a class="tm-btn tm-btn-solid" href="/blog/how-many-fire-extinguishers-does-an-ai-summit-need/">Read the recap</a>
        </div>
        <div class="tm-recap-photos">
          {recapPhotos.map((p) => (
            <figure>
              <img src={`/images/caribbean-ai-summit/recap/${p.file}`} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SAVE FILE: WHAT I'M BUILDING ================= -->
  <section class="tm-section tm-band" id="building" aria-labelledby="tm-build-title">
    <div class="tm-wrap">
      <header class="tm-head">
        <p class="tm-eyebrow">Load game | 6 save slots</p>
        <h2 class="tm-h2" id="tm-build-title">What I'm building, mid-game.</h2>
      </header>
      <ul class="tm-slots">
        {projects.map((p) => (
          <li class="tm-slot">
            <div class="tm-slot-top">
              <span class="tm-slot-no">Slot {p.no}</span>
              <span class="tm-slot-state">{p.state}</span>
            </div>
            <h3 class="tm-slot-name">{p.name}</h3>
            <p class="tm-slot-note">{p.note}</p>
            {p.href ? (
              <a
                class="tm-slot-link"
                href={p.href}
                {...(p.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
