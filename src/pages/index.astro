---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// The club's form guide. All real, formatted like a league table.
const formGuide = [
  { value: '80+', label: 'Countries toured' },
  { value: '50+', label: 'Nations spoken in' },
  { value: '15', label: 'Books published' },
  { value: '25+', label: 'Years managing clubs (companies)' },
];

// PRESEASON, WEEK ONE: the training-ground photo wall.
// `alt` describes the picture for screen readers; `caption` is the coach's note.
const trainingWall = [
  {
    src: '/images/ted-lasso/believe-sign.jpg',
    alt: 'Edward Roske in a tan coach’s jacket and his blue fedora, up over a wooden folding chair in a football club locker room, taping a homemade yellow BELIEVE sign above the doorway.',
    num: '02',
    drill: 'CULTURE / DAY ONE',
    title: 'The Sign Goes Up First',
    caption: `Day one at any club: hang the sign, then figure out the sport. I've opened three companies and one AI community in this order and the sign hasn't been wrong yet. (I have a Master's in Data Science and my entire management philosophy is a piece of yellow paper.)`,
    shape: 'landscape',
  },
  {
    src: '/images/ted-lasso/biscuits.jpg',
    alt: 'Edward Roske in his blue fedora with flour on his coach’s jacket, proudly presenting an open pink cardboard box of shortbread biscuits in a chaotic home kitchen before dawn.',
    num: '03',
    drill: 'BOARDROOM / 4 AM',
    title: 'Biscuits With the Boss',
    caption: `No slide deck has ever won anyone over, but shortbread closes. Baking counts as data prep if you measure everything twice, and I measure everything twice.`,
    shape: 'portrait',
  },
  {
    src: '/images/ted-lasso/press-conference.jpg',
    alt: 'Edward Roske in his blue fedora and a club scarf at a press conference table full of microphones, cheerfully holding up a small whiteboard covered in a software architecture flowchart instead of football tactics.',
    num: '04',
    drill: 'MEDIA DUTIES',
    title: 'Tactics Board, Sort Of',
    caption: `The press asked about our formation. I showed them an MCP server architecture diagram, and it got more follow-up questions than any back four ever has. We play a 4-3-3 of agents.`,
    shape: 'portrait',
  },
  {
    src: '/images/ted-lasso/darts.jpg',
    alt: 'Edward Roske in his blue fedora and coach’s jacket in a warm British pub, mid dart throw with eyes narrowed in concentration, while astonished locals with pints watch from the bar.',
    num: '05',
    drill: 'AWAY FIXTURE / THE PUB',
    title: 'The American Has Played Before',
    caption: `Everyone in that pub assumed the American in the fedora had never held a dart. I let the assumption ride for exactly three throws. Be curious about your opponents, especially the ones buying the next round.`,
    shape: 'landscape',
  },
  {
    src: '/images/ted-lasso/whiff.jpg',
    alt: 'Edward Roske mid fall on a professional training pitch, both feet in the air after completely missing a kick, clipboard papers flying, while players in red and blue training kits wince in the background. His blue fedora is still on.',
    num: '06',
    drill: 'SCOUTING REPORT',
    title: 'First Touch: Theoretical',
    caption: `The scouting report called my first touch "theoretical," which is fair. I contribute in other ways: vision, morale, and knowing exactly when to stop kicking things I don't understand. (The fedora never left my head, which is the only part of that drill I passed.)`,
    shape: 'wide',
  },
];

// THE SQUAD: six real projects, filed as a club roster.
const squad = [
  {
    num: '08',
    position: 'Central Midfield',
    name: 'MCP Servers for Enterprise Finance',
    note: `This is the engine room. MCP servers are how AI agents actually work inside enterprise finance systems: Oracle Essbase and EPM Planning are shipping, Financial Close and Consolidations is in beta. It's the unglamorous passing that wins the match, and someone has to do it on purpose.`,
    tag: 'ORACLE EPM / MCP',
    status: 'SHIPPING',
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    num: '10',
    position: 'Home Fixture',
    name: 'Caribbean AI Summit',
    note: `Co-chairing the biggest AI conference Puerto Rico has hosted, October 9 and 10 at the Convention Center. The bill so far: Kay Firth-Butterfield, MIT's Fabio Duarte, EU Parliament AI advisor Idoia Salazar, and a bunch more still landing. (Co-chairing is ten percent stagecraft and ninety percent email.)`,
    tag: '9-10 OCT 2026',
    status: 'CALL FOR SPEAKERS OPEN',
    href: 'https://www.caribbeansummit.ai/en/speakers/submit',
    external: true,
    cta: 'Submit a speaker',
  },
  {
    num: '04',
    position: 'Front Office',
    name: 'Caprus',
    note: `Investor and contributor at the AI software and services firm building faster operations for finance teams. They do the engineering. I show up to training and point at things.`,
    tag: 'AI / FINANCE',
    status: 'RUNNING',
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    num: '07',
    position: 'The Long Away Day',
    name: 'Everest Base Camp',
    note: `This spring I walked to the foot of Everest: seventeen days, one map, altitude headaches, and every question I could think of asked of the guides. The full report is on the blog, including the parts that went badly.`,
    tag: 'NEPAL / 2026',
    status: 'REPORT FILED',
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the away-day report',
  },
  {
    num: '12',
    position: 'Set Pieces',
    name: "AI Dungeon Master's Screen",
    note: `A prototype AI screen for running D&D 5e: lore lookups and improv help for the person behind the cardboard. Set pieces are just encounters you rehearsed in advance, and I rehearse mine. (The party still gets told nothing.)`,
    tag: 'D&D / 5E',
    status: 'CLOSED TRAINING',
    href: null,
    external: false,
    cta: 'Quiet build',
  },
  {
    num: '06',
    position: "Supporters' Trust",
    name: 'Puerto Rico AI Community',
    note: `President of the island's AI community, now past 850 people. We meet every other month and argue about what AI means for Puerto Rico in two languages until something useful falls out. Best supporters in the league, and I say that with total bias.`,
    tag: '850+ MEMBERS',
    status: 'RUNNING',
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];

const scarfLetters = 'ASK GOOD QUESTIONS'.split('');
---

<BaseLayout>
  <WeeklyAnimation />

  <!-- ================= SCOREBOARD STRIP ================= -->
  <div class="score" role="presentation">
    <div class="score-inner">
      <span class="score-item">AFC ROSKE, EST. 1997</span>
      <span class="score-board" aria-label="Scoreboard: AFC Roske 4, Ordinary 0">
        <span class="score-team">ROSKE</span>
        <span class="score-num">4</span>
        <span class="score-dash">:</span>
        <span class="score-num">0</span>
        <span class="score-team">ORDINARY</span>
      </span>
      <span class="score-item">HOME FIXTURES: SATURDAYS, 5 AM AST</span>
    </div>
  </div>

  <!-- ================= HERO: THE TOUCHLINE ================= -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-kicker">Official club site of one man | Season 4 of coaching a sport I don't understand</p>
        <h1 class="hero-h1">Be curious,<br /><em>not judgmental.</em></h1>
        <p class="hero-aside">(Ted says Walt Whitman said that. Whitman didn't, but it's still the entire job description.)</p>
        <p class="hero-sub">{theme.hero.subtitle}</p>
        <p class="hero-desc">
          Ted Lasso is back, coaching a team in a sport he doesn't understand, on the theory that curiosity outruns expertise. I've been running the same play since 2023, when I sold the company I actually understood and walked into AI with nothing but questions, which got better the longer I asked them. These days I coach finance teams through the same transfer window and build MCP servers so AI agents can work inside enterprise systems. Ten of those agents rebuild this website every Saturday morning. They picked this theme, and I found out when you did.
        </p>
        <div class="hero-cta">
          <a href="/question/" target="_blank" rel="noopener" class="btn-red">Book 13 minutes</a>
          <a href={theme.hero.ctaLink} class="btn-line">{theme.hero.ctaText}</a>
        </div>
      </div>

      <figure class="hero-fig">
        <div class="hero-frame">
          <span class="hero-badge">MATCHDAY</span>
          <img
            src={`/images/${theme.hero.heroImage}`}
            alt={theme.hero.imageAlt}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
            class="hero-img"
          />
          <span class="hero-numtag" aria-hidden="true">01</span>
        </div>
        <figcaption class="hero-cap">
          The new gaffer arrives at the ground with a clipboard of diagrams no one on the coaching staff can read, including him.
        </figcaption>
      </figure>
    </div>

    <div class="form" aria-label="Club form guide">
      <div class="form-inner">
        <span class="form-head">FORM GUIDE</span>
        {formGuide.map(s => (
          <span class="form-stat">
            <span class="form-value">{s.value}</span>
            <span class="form-label">{s.label}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= CLUB SCARF ================= -->
  <div class="scarf" aria-hidden="true">
    <span class="scarf-fringe scarf-fringe-l"></span>
    <div class="scarf-body">
      {scarfLetters.map(ch => (
        ch === ' ' ? <span class="scarf-gap"></span> : <span class="scarf-ch">{ch}</span>
      ))}
    </div>
    <span class="scarf-fringe scarf-fringe-r"></span>
  </div>

  <!-- ================= LATEST CONTENT (permanent) ================= -->
  <LatestContent
    eyebrow="Match highlights"
    heading={"Fresh off <em>the pitch.</em>"}
    deck="The newest writing and video briefs, posted the week they happen. The video briefs cover AI news, and I have never once run out of AI news, which tells you something about AI news."
  />

  <!-- ================= BOOK EDWARD (permanent) ================= -->
  <SpeakerCTA eyebrow="Hire the gaffer" />

  <!-- ================= PRESEASON: TRAINING WALL ================= -->
  <section class="wall">
    <div class="wall-inner">
      <header class="sec-head">
        <div class="sec-slug">Preseason | Week One</div>
        <h2 class="sec-title">Training ground <em>footage.</em></h2>
        <p class="sec-deck">
          Photos from the first week at the club. The coaching staff would like it noted that none of this was their idea, and that the biscuits were excellent.
        </p>
      </header>

      <div class="wall-grid">
        {trainingWall.map(p => (
          <figure class={`wall-item wall-${p.shape}`}>
            <div class="wall-frame">
              <img src={p.src} alt={p.alt} loading="lazy" decoding="async" class="wall-img" />
              <span class="wall-num" aria-hidden="true">{p.num}</span>
              <span class="wall-drill">{p.drill}</span>
            </div>
            <figcaption class="wall-cap">
              <h3 class="wall-title">{p.title}</h3>
              <p class="wall-text">{p.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= WHAT'S NEW (permanent) ================= -->
  <WhatsNew
    eyebrow="Club news"
    heading={"From the <em>press room.</em>"}
    deck="Interviews, mentions, and the odd post worth pinning to the noticeboard. Filed here so you can check the manager's claims against a second source."
  />

  <!-- ================= THE BELIEVE SIGN ================= -->
  <section class="believe">
    <div class="believe-inner">
      <div class="believe-signwrap">
        <div class="believe-sign" role="img" aria-label="A homemade yellow paper sign reading BELIEVE, taped up at a slight angle">
          <span class="believe-tape believe-tape-l" aria-hidden="true"></span>
          <span class="believe-tape believe-tape-r" aria-hidden="true"></span>
          <span class="believe-word" aria-hidden="true">BELIEVE</span>
        </div>
        <p class="believe-under">(in verified data)</p>
      </div>
      <div class="believe-copy">
        <div class="sec-slug">Season 4 kickoff | Wednesday, August 5</div>
        <h2 class="believe-title">Season 4 is about starting over. I recommend it.</h2>
        <p class="believe-p">
          The new season sends Ted back to Richmond to coach the women's team, with a new squad and the same total absence of qualifications. That's the part I believe in. I've started over at 22 with a consulting firm, at 45 with a data science degree, and at 48 with AI, and every time the only transferable skill was asking better questions than the people who already knew everything.
        </p>
        <p class="believe-p">
          The sign in my office says what the sign in his office says, with one edit underneath in Sharpie. Belief will carry a team through a whole season, but nobody has ever passed an audit on morale.
        </p>
        <p class="believe-tune">Ted Lasso season 4 is out August 5 on Apple TV. AFC Roske plays at home every Saturday at 5 AM, whether or not anyone asked.</p>
      </div>
    </div>
  </section>

  <!-- ================= THE SQUAD ================= -->
  <section id="current-work" class="squad">
    <div class="squad-inner">
      <header class="sec-head sec-head-onpitch">
        <div class="sec-slug sec-slug-onpitch">Squad list | 2026/27 season</div>
        <h2 class="sec-title sec-title-onpitch">The <em>squad.</em></h2>
        <p class="sec-deck sec-deck-onpitch">
          Six names on the team sheet, all real, all currently getting minutes. The manager insists on playing every one of them at the same time.
        </p>
      </header>

      <div class="squad-grid">
        {squad.map(item => (
          <article class="player">
            <div class="player-head">
              <span class="player-num" aria-hidden="true">{item.num}</span>
              <div class="player-id">
                <span class="player-pos">{item.position}</span>
                <h3 class="player-name">{item.name}</h3>
              </div>
            </div>
            <p class="player-note">{item.note}</p>
            <div class="player-meta">
              <span class="player-tag">{item.tag}</span>
              <span class="player-status">{item.status}</span>
            </div>
            {item.href ? (
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
                class="player-cta"
              >{item.cta}</a>
            ) : (
              <span class="player-cta player-cta-off">{item.cta}</span>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= BISCUITS WITH THE BOSS (CTA) ================= -->
  <section class="biscuits">
    <div class="biscuits-inner">
      <div class="sec-slug">Biscuits with the boss</div>
      <h2 class="biscuits-title">Thirteen minutes. <em>I'll allow it.</em></h2>
      <p class="biscuits-deck">
        A short call, no charge and no pitch deck. Ask about AI inside the Office of the CFO, what an MCP server actually does on a Tuesday, whether the Caribbean AI Summit is worth the flight, or why a grown man is running a football club that doesn't exist. Google Calendar still can't attach shortbread, which I consider its largest remaining product gap.
      </p>
      <div class="biscuits-cta">
        <a href="/question/" target="_blank" rel="noopener" class="btn-red btn-big">Book 13 minutes</a>
        <a href="/contact" class="btn-line btn-big">Send a note</a>
      </div>
    </div>
  </section>

  <!-- ================= CLUB NOTICE ================= -->
  <footer class="notice">
    <div class="notice-inner">
      <p>
        AFC ROSKE is a football club with no players, no ground, no league affiliation, and one extremely committed manager. It is not associated with Apple TV, Ted Lasso, AFC Richmond, or any organization that has successfully kicked a ball. Ted Lasso season 4 is out August 5, 2026, and had no say in this. Edward really did found interRel at 22, really does build MCP servers for enterprise finance, and really will bring biscuits. The fedora stays on.
      </p>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ============================================================
     AFC ROSKE: BELIEVE  |  TED LASSO S4  |  2026-08-01
     A small football club run by one optimistic American.
     Palette: programme cream + kit blue, spot red CTA, pitch
              green, Believe gold. Dark mode is the floodlit
              night match.
     Type: Archivo (headlines), Anton (kit numbers, scarf),
           Nunito Sans (body), Space Mono (fixture data).
     Atmosphere: scoreboard strip, knitted scarf, pitch-line
                 rules, taped paper sign. No motion.
     ============================================================ */

  :global([data-theme="dark"]) {
    --tl-bg: #0e1330;
    --tl-panel: #171e42;
    --tl-panel2: #1c244f;
    --tl-ink: #f0f2fa;
    --tl-muted: #aeb6d8;
    --tl-line: #2c3563;
    --tl-red: #e45866;
    --tl-blue: #93a4f0;
    --tl-gold: #ffd23f;
    --tl-pitch: #0b4526;
    --tl-pitch2: #0d5230;
    --tl-onred: #ffffff;
    --tl-redsolid: #c11425;
  }
  :global([data-theme="light"]) {
    --tl-bg: #f7f5ec;
    --tl-panel: #fffdf6;
    --tl-panel2: #efecdd;
    --tl-ink: #151a2b;
    --tl-muted: #4b5268;
    --tl-line: #ded9c6;
    --tl-red: #c11425;
    --tl-blue: #2a3ba0;
    --tl-gold: #ffd23f;
    --tl-pitch: #0b5c2e;
    --tl-pitch2: #0e6b36;
    --tl-onred: #ffffff;
    --tl-redsolid: #c11425;
  }

  /* ---------------- SCOREBOARD STRIP ---------------- */
  .score {
    background: var(--tl-ink);
    color: var(--tl-bg);
    padding: 0.55rem 2rem;
  }
  .score-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .score-item {
    font-family: 'Space Mono', monospace;
    font-size: 0.64rem;
    letter-spacing: 0.13em;
  }
  .score-board {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .score-team {
    font-family: 'Anton', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
  }
  .score-num {
    font-family: 'Anton', sans-serif;
    font-size: 0.85rem;
    background: var(--tl-redsolid);
    color: var(--tl-onred);
    padding: 0.1rem 0.45rem;
  }
  .score-dash { font-family: 'Space Mono', monospace; font-size: 0.7rem; }
  @media (max-width: 760px) {
    .score { padding: 0.5rem 1.1rem; }
    .score-inner { justify-content: center; }
    .score-item { display: none; }
  }

  /* ---------------- HERO ---------------- */
  .hero {
    background:
      linear-gradient(to bottom, transparent 0 calc(100% - 1px), var(--tl-line) calc(100% - 1px)),
      var(--tl-bg);
    color: var(--tl-ink);
    padding: 4.2rem 2rem 0;
  }
  .hero-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding-bottom: 3.6rem;
  }
  @media (max-width: 1020px) {
    .hero { padding: 2.8rem 1.1rem 0; }
    .hero-inner { grid-template-columns: 1fr; gap: 2.4rem; }
  }

  .hero-kicker {
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tl-red);
    margin: 0 0 1.3rem;
    padding-bottom: 0.8rem;
    border-bottom: 3px solid var(--tl-red);
    display: inline-block;
  }
  .hero-h1 {
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: clamp(2.9rem, 7.2vw, 5.6rem);
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    margin: 0 0 0.9rem;
    color: var(--tl-ink);
  }
  .hero-h1 em {
    font-style: normal;
    color: var(--tl-blue);
  }
  .hero-aside {
    font-family: 'Nunito Sans', sans-serif;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--tl-muted);
    margin: 0 0 1.6rem;
  }
  .hero-sub {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.35;
    color: var(--tl-ink);
    margin: 0 0 1.1rem;
  }
  .hero-desc {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--tl-muted);
    margin: 0 0 1.8rem;
    max-width: 38em;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.85rem; }

  .btn-red, .btn-line {
    display: inline-flex;
    align-items: center;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.85rem 1.5rem;
    border: 2px solid var(--tl-redsolid);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .btn-red {
    background: var(--tl-redsolid);
    color: var(--tl-onred);
    box-shadow: 4px 4px 0 var(--tl-ink);
  }
  .btn-red:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--tl-ink); }
  .btn-line {
    background: transparent;
    border-color: var(--tl-ink);
    color: var(--tl-ink);
    box-shadow: 4px 4px 0 var(--tl-line);
  }
  .btn-line:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--tl-line); background: var(--tl-panel); }
  .btn-big { padding: 1rem 2rem; font-size: 0.9rem; }

  .hero-fig { margin: 0; }
  .hero-frame {
    position: relative;
    border: 3px solid var(--tl-ink);
    background: var(--tl-panel);
    padding: 0.55rem;
    box-shadow: 10px 10px 0 var(--tl-redsolid);
  }
  .hero-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .hero-badge {
    position: absolute;
    top: -0.85rem;
    left: 1.2rem;
    background: var(--tl-gold);
    color: #1f2d7a;
    font-family: 'Anton', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    padding: 0.32rem 0.75rem;
    border: 2px solid #1f2d7a;
    z-index: 2;
  }
  .hero-numtag {
    position: absolute;
    right: 0.55rem;
    bottom: 0.55rem;
    background: var(--tl-ink);
    color: var(--tl-bg);
    font-family: 'Anton', sans-serif;
    font-size: 1.3rem;
    line-height: 1;
    padding: 0.4rem 0.6rem 0.3rem;
  }
  .hero-cap {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 0.86rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--tl-muted);
    margin-top: 0.9rem;
  }

  /* Form guide bar */
  .form {
    border-top: 3px solid var(--tl-ink);
    background: var(--tl-panel);
  }
  .form-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
  }
  .form-head {
    font-family: 'Anton', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    color: var(--tl-onred);
    background: var(--tl-redsolid);
    display: inline-flex;
    align-items: center;
