      if (!el) return;
      // San Juan is UTC-4 all year (no daylight saving).
      var sj = new Date(Date.now() - 4 * 3600 * 1000);
      var today = Date.UTC(sj.getUTCFullYear(), sj.getUTCMonth(), sj.getUTCDate());
      var diff = Math.round((Date.UTC(2026, 9, 9) - today) / 86400000);
      if (diff > 1) el.textContent = 'Opens in ' + diff + ' days';
      else if (diff === 1) el.textContent = 'Opens tomorrow';
      else if (diff === 0) el.textContent = 'Happening now | Day 1';
      else if (diff === -1) el.textContent = 'Happening now | Day 2';
    })();
