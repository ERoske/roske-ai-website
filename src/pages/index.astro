---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// ---------------------------------------------------------------------------
// AN A.I. CAROL (2026-11-14). Ebenezer: A Christmas Carol opened Friday,
// November 13. The page is the book's 5 staves. Edward is Marley and only
// Marley: the dead partner who worked the same ledgers and shows up in a
// chain he forged himself. The argument: Scrooge had all the information in
// Stave One and said Humbug to it; what changed him was being shown. Every
// Dickens quotation is checked against the Project Gutenberg text (ebook 46).
// Nobody from the film is depicted.
// ---------------------------------------------------------------------------

const IMG = '/images/ai-carol';
const CAL = 'https://calendar.app.google/udtTerQwcX9Z7QQt7';
const POST = '/blog/what-actually-changed-scrooges-mind/';
const BOOK = 'https://www.gutenberg.org/ebooks/46';
const REVIEWS = 'https://www.hollywoodreporter.com/movies/movie-news/ebenezer-reviews-johnny-depp-1236754299/';
const WTI = 'https://blogs.microsoft.com/blog/2024/05/08/microsoft-and-linkedin-release-the-2024-work-trend-index-on-the-state-of-ai-at-work/';
const RAILWAY = 'https://en.wikipedia.org/wiki/Railway_Mania';

// The 4 standing numbers. Same every week.
const stats = [
  { v: '80+', k: 'Countries visited' },
  { v: '50+', k: 'Countries spoken in' },
  { v: '15', k: 'Books' },
  { v: '25', k: 'Years running interRel' },
];

// The chain, itemized. Every link is a real line from the career.
const chain = [
  {
    when: '1995',
    what: 'Essbase consulting',
    note: `The first link. My title was Senior Analytics Consultant, and this was 2 years before I founded a company at 22, so you can work out for yourself how senior.`,
  },
  {
    when: '1997',
    what: 'interRel Consulting',
    note: `Founded May 21, 1997, the day before my birthday, because I thought it'd be cool to start a company at 22. It's the longest link on the chain: 25 years of running it.`,
  },
  {
    when: '15 books',
    what: 'Look Smarter Than You Are',
    note: `13 on Amazon and 2 more for training classes, and they're the reason I clank. (Edward, you wrote 15 books about software with the version numbers right there in the titles. What did you think was going to happen to them?)`,
  },
  {
    when: '1 exam',
    what: 'A perfect score on the Essbase certification',
    note: `First person to do it. It's a small link (and yes, I'm aware that bringing it up on my own website, on a chain, is more or less what Marley was being punished for).`,
  },
  {
    when: '2020',
    what: 'The merger',
    note: `Merged interRel with Keste to help found Argano, and stayed on as CEO through 2022.`,
  },
  {
    when: '2023 to now',
    what: 'Still forging',
    note: `AgentCube, a YouTube channel with over 800,000 subscribers, the Caribbean AI Summit, and this website, which a machine rebuilds every Saturday. Marley's chain stopped growing 7 years before the book starts, and I'm still adding to mine (Dickens doesn't say what happens in that case).`,
  },
];

// The three Spirits. What each showed Scrooge, and what it'd show yours.
type Spirit = {
  stave: string;
  bell: string;
  name: string;
  img: string;
  w: number;
  h: number;
  shape: 'wide' | 'tall' | 'full';
  alt: string;
  caption: string;
  showed: string;
  yours: string;
  link?: { href: string; text: string };
};

const spirits: Spirit[] = [
  {
    stave: 'Stave Two',
    bell: 'The bell tolls One',
    name: 'The Ghost of Technology Past',
    img: 'past.jpg',
    w: 1600,
    h: 1195,
    shape: 'wide',
    alt: 'Edward as Marley\'s Ghost, translucent and glowing green in a frock coat and his blue fedora with a chain over his shoulder, stands in the aisle of an empty 1990s cubicle farm and gestures like a tour guide at a beige CRT monitor showing a green spreadsheet. A wall calendar reads 1998, and a stack of books, a beige keyboard, and some floppy disks sit chained at his feet.',
    caption: `Me, giving the tour of 1998 (it's on the wall calendar). interRel was 1 year old, and yes, that's a CRT (ask your parents).`,
    showed: `His old school, his sister, and a Christmas party thrown by his first boss, Fezziwig, who by the Ghost's own math spent "but a few pounds" on it. Scrooge jumps in to defend him ("The happiness he gives, is quite as great as if it cost a fortune") and then goes quiet, because he's just thought of his own clerk.`,
    yours: `The last few things they called humbug. I've been doing this since 1995, and every big shift since then had smart people explaining why it was a fad. What I said about "AI's a fad" on my show is that it'll end up like personal computers, which are all going to go away someday so we can put everything back on 1 big central computer (that one sort of did happen, it just took about 50 years longer than anybody thought).`,
  },
  {
    stave: 'Stave Three',
    bell: 'The bell tolls One, again',
    name: 'The Ghost of Technology Present',
    img: 'present.jpg',
    w: 1195,
    h: 1600,
    shape: 'tall',
    alt: 'On a snowy city sidewalk at night, Edward as Marley\'s Ghost in his blue fedora, chain hung with books, padlocks, floppy disks, and a beige keyboard, rests one hand on the frosted window of a modern office building and looks back at the camera. Inside the dark office, one man sits alone at a desk, typing by the glow of a laptop.',
    caption: `That's Bob. The office is dark, everybody else went home, and whatever he's typing into isn't on the approved list (I'm not going to tell on him).`,
    showed: `Rooms he'd never have walked into on his own. His clerk's house, where Bob Cratchit toasts him as "the Founder of the Feast" over Mrs. Cratchit's objections, and his nephew's party, where the guests play a guessing game called Yes and No and the answer ("a disagreeable animal, a savage animal") turns out to be Scrooge.`,
    yours: `What their own people are doing tonight. Microsoft and LinkedIn found 75% of knowledge workers already using AI at work back in 2024, with 78% of those people bringing their own tools. Bob Cratchit has a personal chatbot account, he's had it for 2 years, and he isn't going to bring it up in the meeting.`,
    link: { href: WTI, text: 'Microsoft and LinkedIn found' },
  },
  {
    stave: 'Stave Four',
    bell: 'The bell tolls Twelve',
    name: 'The Ghost of Technology Yet to Come',
    img: 'yet-to-come.jpg',
    w: 1600,
    h: 893,
    shape: 'full',
    alt: 'In a snowy churchyard at night, a tall figure in a black hooded robe, its face hidden, points down at a gray headstone carved with the words WAIT AND SEE. Edward as Marley\'s Ghost, in his blue fedora with a chain of books, padlocks, floppy disks, and a beige keyboard, crouches beside the stone brushing snow off the top with a small brush and looks up at the camera, mildly concerned.',
    caption: `The stone says WAIT AND SEE. I brought a brush, because I'm a professional.`,
    showed: `It never says a word. It points: first at some businessmen discussing a man who died last night (one of them will go to the funeral "if a lunch is provided"), and then at a headstone with Scrooge's name on it. Scrooge asks the best question in the book ("Are these the shadows of the things that Will be, or are they shadows of things that May be, only?") and doesn't get an answer.`,
    yours: `Nobody can tell your skeptic what AI does to their industry by 2030, and I'd be a little careful around anybody who says they can. A good look at the future does what the headstone does, which is get you asking Scrooge's question. This Spirit is the most persuasive speaker in the book and it has no lines, which I'm trying not to take personally (my keynotes run up to 90 minutes, plus Q&A).`,
  },
];

// The Humbug Ledger. 5 humbugs, entered honestly. Only 1 of them is humbug.
const ledger = [
  {
    humbug: 'It makes things up.',
    verdict: 'Fair',
    entry: `It does, when it's answering from memory. Give it something to read (your documents and the real numbers out of your real systems) and it mostly stops guessing, though not always, so you still check the ones that matter, the same way you'd check a new hire's.`,
  },
  {
    humbug: `It's a bubble.`,
    verdict: 'Could be',
    entry: `Dickens published this book in 1843, and Britain's Railway Mania peaked 3 years later, when Parliament approved 263 new railway companies in a single year. About a third of that track never got built, and a lot of families lost their savings. The lines that did get built are still on the map, so it was a bubble and the trains ran anyway.`,
    link: { href: RAILWAY, text: 'Railway Mania' },
  },
  {
    humbug: `We tried it, and it wasn't any good.`,
    verdict: 'Fair, that month',
    entry: `Ask which month that was. Something better ships every few months, so a verdict from 2023 is about a product that's been replaced several times since (I'd tell you how many times, but it'll be out of date by the time you read this).`,
  },
  {
    humbug: `Our data isn't ready.`,
    verdict: 'True, forever',
    entry: `I spent 25 years working in other people's data, and "ready" isn't a word I'd have used for much of it. It got used anyway. Pick 1 problem where the data's good enough and start there.`,
  },
  {
    humbug: `My people aren't asking for it.`,
    verdict: 'Humbug',
    entry: `They're not asking because they already have it. See Stave Three: 75% were using it by 2024, and 78% of those brought their own, so the request you're waiting for isn't coming.`,
  },
];

// On the books: the 6 projects. Same 6 every week, restyled.
const projects = [
  {
    name: 'MCP Servers for Enterprise Finance',
    status: 'Shipping',
    note: `Plumbing so an AI reads the real number out of Oracle Essbase and EPM instead of remembering one that sounds about right. Essbase and EPM Planning have shipped, and Financial Close and Consolidations is in beta.`,
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    name: 'Caribbean AI Summit',
    status: 'Happened, October 9 and 10',
    note: `Co-chaired it: 800+ people, 17 countries, 44 speakers, and 6 fire extinguishers Dawn bought at Walmart at 7:30 in the morning. The whole story is on the blog.`,
    href: '/blog/how-many-fire-extinguishers-does-an-ai-summit-need/',
    external: false,
    cta: 'Read the recap',
  },
  {
    name: 'Caprus',
    status: 'Investor',
    note: `I'm an investor, and that's the whole job. Lillian Buziak runs it, and they sell and support AgentCube (that's Folio 01), which spares everybody from having me do it.`,
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    name: 'Everest Base Camp',
    status: 'Done, April 2026',
    note: `2 weeks on foot to 18,571 feet with Dawn. The trail log is on the blog, including the last 400 feet of Kala Patthar.`,
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    name: "AI Dungeon Master's Screen",
    status: 'Quiet build',
    note: `A prototype screen for running 5e: lore lookups and improvisation help for the person behind the cardboard. It isn't public yet, and so far the only customer is me (and my players, who didn't get a vote).`,
    href: null,
    external: false,
    cta: 'No public link (take my word for it)',
  },
  {
    name: 'Puerto Rico AI Community',
    status: 'Every other month',
    note: `President of the island's AI community (unpaid, obviously), now past 1,000 different people through the door. Bi-monthly, free, both languages, and the reason the summit exists at all.`,
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
const split = (text: string, linkText: string) => {
  const i = text.indexOf(linkText);
  return { before: text.slice(0, i), after: text.slice(i + linkText.length) };
};
---

<BaseLayout
  title="Roske.AI | An A.I. Carol"
  description="Ebenezer: A Christmas Carol week on roske.ai. Edward Roske is Marley's Ghost, dragging a chain he forged over 25 years of enterprise software, with 5 staves on what actually changed Scrooge's mind and an honest ledger of 5 of the usual humbugs about AI."
>
  <WeeklyAnimation />

  <!-- ================= RUNNING HEAD ================= -->
  <div class="ac-runhead" role="note" aria-label="Running head">
    <div class="ac-wrap ac-runhead-inner">
      <span>An A.I. Carol</span>
      <span>Saturday, November 14, 2026 | San Juan</span>
      <span>41 days before Christmas (the movie couldn't wait either)</span>
    </div>
  </div>

  <!-- ================= HERO: FRONTISPIECE + TITLE PAGE ================= -->
  <section class="ac-hero" aria-labelledby="ac-title">
    <figure class="ac-plate">
      <img
        class="ac-plate-img"
        src={`/images/${theme.hero.heroImage}`}
        alt={theme.hero.imageAlt}
        width="1600"
        height="878"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="ac-plate-cap">
        <span class="ac-wrap">Marley's Ghost. <em>Frontispiece, drawn by a machine.</em></span>
      </figcaption>
    </figure>

    <div class="ac-wrap">
      <div class="ac-book">
        <div class="ac-page ac-tp">
          <h1 class="ac-tp-title" id="ac-title">
            <span class="ac-tp-an">An</span>
            <span class="ac-tp-main">A.I. Carol.</span>
          </h1>
          <p class="ac-tp-prose">In Prose.</p>
          <p class="ac-tp-small">Being</p>
          <p class="ac-tp-ghost">A Ghost Story of Quarter Four.</p>
          <span class="ac-tp-rule" aria-hidden="true"></span>
          <p class="ac-tp-small">By</p>
          <p class="ac-tp-author">Edward Roske.</p>
          <p class="ac-tp-small">With illustrations by a machine.</p>
          <span class="ac-tp-rule" aria-hidden="true"></span>
          <p class="ac-tp-imprint">San Juan: Roske.AI, every Saturday at 5AM.<br />MMXXVI.</p>
        </div>

        <div class="ac-page ac-preface">
          <p class="ac-preface-head">Preface.</p>
          <p class="ac-preface-pull">{theme.hero.subtitle}</p>
          <p>
            Ebenezer: A Christmas Carol opened Friday, with Johnny Depp as Scrooge and Ian McKellen as Marley's Ghost
            (<a href={REVIEWS} target="_blank" rel="noopener noreferrer">the reviews are split</a>, and I'm staying out
            of it). I'm also Marley this week. Sir Ian has been Gandalf and Magneto, and I've been a Dungeon Master
            for a long time, which I've decided is comparable experience.
          </p>
          <p>
            Marley's the dead business partner who shows up 7 years late, in a chain he made himself, to tell Scrooge
            that 3 more visitors are coming. I'm unreasonably qualified for the part, since I ran a consulting firm for
            25 years and wrote 15 books about software, and I can show you every link (they're itemized in Stave One&hellip;
            Edward, nobody asked for an itemized chain. I know, and it's in there anyway).
          </p>
          <p>
            If you go back and read <a href={BOOK} target="_blank" rel="noopener noreferrer">the book</a> (it's free,
            and it takes an evening), Scrooge isn't short on information. In Stave One his nephew gives him a good
            speech and 2 gentlemen show up with statistics, and he says &ldquo;Humbug&rdquo; to the nephew and asks
            the 2 gentlemen whether there are no prisons. Then his dead partner turns up in person, and it's still
            humbug for a while.
          </p>
          <p>
            A lot of smart people are saying &ldquo;Humbug&rdquo; about AI right now, and some of them have earned it
            (the Halloween page was about what they were sold, so I won't start again). If that's somebody at your
            company, or it's you, here are 5 staves on how the book handles it, plus an honest ledger of which humbugs
            are actually humbug.
          </p>
          <div class="ac-ctas">
            <a class="ac-btn ac-btn-paper" href={theme.hero.ctaLink}>{theme.hero.ctaText}</a>
            <a class="ac-btn ac-btn-paper-ghost" href="#ledger">Skip to the Humbug Ledger</a>
          </div>
          <p class="ac-preface-sign">
            Your faithful Friend and Servant,<br />
            <span>E. R.</span><br />
            November, 2026.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <div class="ac-stats-wrap">
    <ul class="ac-wrap ac-stats" aria-label="On the record">
      {stats.map((s) => (
        <li><span class="ac-stat-v">{s.v}</span><span class="ac-stat-k">{s.k}</span></li>
      ))}
    </ul>
  </div>

  <!-- ================= ALSO IN THIS VOLUME ================= -->
  <LatestContent
    eyebrow="Also in this volume"
    heading="New <em>this week.</em>"
    deck="This week's writing and video, newest first, including today's post on what actually changed Scrooge's mind (his nephew's speech didn't do it, and it was a good speech)."
  />

  <!-- ================= STAVE ONE: MARLEY'S GHOST ================= -->
  <section class="ac-section ac-stave1" id="stave-one" aria-labelledby="ac-s1-title">
    <div class="ac-wrap">
      <div class="ac-s1-top">
        <header class="ac-head">
          <p class="ac-eyebrow">Stave One | Marley's Ghost</p>
          <h2 class="ac-h2 ac-h2-quote" id="ac-s1-title">&ldquo;I wear the chain I forged in life.&rdquo;</h2>
          <p class="ac-copy">
            That's Marley, and he goes on: &ldquo;I made it link by link, and yard by yard; I girded it on of my own
            free will, and of my own free will I wore it.&rdquo; Dickens even lists what's on it (cash-boxes, keys,
            padlocks, ledgers, deeds, and heavy purses wrought in steel). Mine has different hardware, and I made it
            the same way he did (it's itemized further down this page, for anyone who likes an audit trail).
          </p>
          <p class="ac-copy">
            The reason Marley gets sent first is that he's the 1 visitor Scrooge can't wave off as somebody who
            doesn't understand the business, because they ran the business together. That's most of what I've got
            going for me on a stage, too: I did it the old way starting in 1995, with cubes and consolidations and
            other people's spreadsheets (the ones that didn't have Freeze Panes turned on, you know who you are).
          </p>
          <p class="ac-copy">
            And it works, a little. Scrooge says &ldquo;Humbug&rdquo; 6 times in the whole book (the machine that
            builds this site counted), and all 6 are in Stave One. Right after Marley leaves, he tries for a 7th, and
            Dickens says he &ldquo;stopped at the first syllable,&rdquo; and that's the last time he says it (the
            book's free on Project Gutenberg if you'd like to check the machine's math).
          </p>
        </header>

        <figure class="ac-fig ac-fig-knocker">
          <img
            src={`${IMG}/knocker.jpg`}
            alt="A brass door knocker on a black Victorian front door in the snow, cast in the shape of Edward's face, bearded and deadpan and glowing faintly green, with a navy blue fedora on its head and the knocker ring hanging under its chin."
            width="1195"
            height="1600"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            In the book, Marley's face shows up in the door knocker first, as a sort of courtesy. Mine came with the
            fedora on (a Roske never removes his fedora in the presence of others, and the family creed doesn't make
            an exception for brass).
          </figcaption>
        </figure>
      </div>

      <div class="ac-s1-bottom">
        <figure class="ac-fig ac-fig-inventory">
          <img
            src={`${IMG}/inventory.jpg`}
            alt="Edward as Marley's Ghost sits on a clerk's stool in a candlelit Victorian counting-house, in his blue fedora, writing in a huge ledger with a quill and looking up at the camera. His chain trails across the desks and the floor, hung with old books, padlocks, and floppy disks, and a beige 1990s computer monitor and keyboard sit on the desk beside him."
            width="1600"
            height="1195"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Taking inventory by quill and candlelight, in a counting-house, with a perfectly good beige keyboard
            sitting right there on the desk the whole time (the machine that drew this has opinions about my workflow,
            and I've chosen not to ask).
          </figcaption>
        </figure>

        <div class="ac-chain-box">
          <h3 class="ac-h3">The chain, itemized</h3>
          <ol class="ac-chain">
            {chain.map((c) => (
              <li class="ac-link">
                <span class="ac-link-oval" aria-hidden="true"></span>
                <p class="ac-link-when">{c.when}</p>
                <p class="ac-link-what">{c.what}</p>
                <p class="ac-link-note">{c.note}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BOOK EDWARD ================= -->
  <SpeakerCTA eyebrow="Marley takes bookings (the Spirits don't)" />

  <!-- ================= STAVES TWO TO FOUR: THE THREE SPIRITS ================= -->
  <section class="ac-night" id="spirits" aria-labelledby="ac-sp-title">
    <div class="ac-wrap">
      <header class="ac-head ac-night-head">
        <p class="ac-eyebrow ac-eyebrow-night">Staves Two, Three, and Four</p>
        <h2 class="ac-h2 ac-h2-night ac-h2-quote" id="ac-sp-title">&ldquo;You will be haunted by Three Spirits.&rdquo;</h2>
        <p class="ac-copy ac-copy-night">
          Scrooge's answer to that, for the record, is &ldquo;I think I'd rather not.&rdquo; He gets them anyway. None
          of the 3 argues with him, and 1 doesn't talk at all. Each one takes him somewhere and stands there while he
          looks, so here's where each one took him, and where I'd take the Scrooge at your company.
        </p>
      </header>

      <ol class="ac-spirits">
        {spirits.map((s) => {
          const parts = s.link ? split(s.yours, s.link.text) : null;
          return (
            <li class={`ac-spirit ac-spirit-${s.shape}`}>
              <figure class="ac-spirit-fig">
                <img src={`${IMG}/${s.img}`} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />
                <figcaption>{s.caption}</figcaption>
              </figure>
              <div class="ac-spirit-body">
                <p class="ac-spirit-stave">{s.stave} <span>{s.bell}</span></p>
                <h3 class="ac-spirit-name">{s.name}</h3>
                <dl class="ac-spirit-dl">
                  <div>
                    <dt>What it showed Scrooge</dt>
                    <dd>{s.showed}</dd>
                  </div>
                  <div class="ac-spirit-yours">
                    <dt>What it'd show yours</dt>
                    <dd>
                      {parts && s.link ? (
                        <>
                          {parts.before}
                          <a href={s.link.href} target="_blank" rel="noopener noreferrer">{s.link.text}</a>
                          {parts.after}
                        </>
                      ) : (
                        s.yours
                      )}
                    </dd>
                  </div>
                </dl>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ================= THE HUMBUG LEDGER ================= -->
  <section class="ac-ledger-sec" id="ledger" aria-labelledby="ac-ledger-title">
    <div class="ac-wrap">
      <div class="ac-ledger">
        <header class="ac-ledger-head">
          <p class="ac-ledger-firm">Scrooge &amp; Marley | Humbugs received</p>
          <h2 class="ac-ledger-title" id="ac-ledger-title">The Humbug Ledger</h2>
          <p class="ac-ledger-intro">
            In fairness to Scrooge, his first theory about the ghost is indigestion (&ldquo;There's more of gravy
            than of grave about you&rdquo;), and as hypotheses go, that's a decent one, and plenty of what you've
            been told about AI deserves the same treatment. So here are 5 of the usual humbugs, entered honestly,
            including the ones where the skeptic's right.
          </p>
        </header>

        <ol class="ac-rows">
          {ledger.map((r, i) => {
            const parts = r.link ? split(r.entry, r.link.text) : null;
            return (
              <li class={`ac-row ${r.verdict === 'Humbug' ? 'ac-row-humbug' : ''}`}>
                <span class="ac-row-no">No. {i + 1}</span>
                <p class="ac-row-humbug-text">&ldquo;{r.humbug}&rdquo;</p>
                <p class="ac-row-verdict"><span class="ac-sr">Verdict: </span>{r.verdict}</p>
                <p class="ac-row-entry">
                  {parts && r.link ? (
                    <>
                      {parts.before}
                      <a href={r.link.href} target="_blank" rel="noopener noreferrer">{r.link.text}</a>
                      {parts.after}
                    </>
                  ) : (
                    r.entry
                  )}
                </p>
              </li>
            );
          })}
        </ol>

        <p class="ac-ledger-total">
          <span class="ac-ledger-total-k">Carried forward</span>
          <span class="ac-ledger-total-v">1 humbug in 5.</span>
          <span class="ac-ledger-total-note">
            Scrooge went 0 for 6, so today's skeptic is doing a lot better than he did. The skeptic still gets the 3
            visitors, though (sorry, I don't make the rules, Dickens does).
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- ================= ON THE BOOKS ================= -->
