  }
  .hero-img { display: block; width: 100%; height: auto; }
  .hero-cap {
    font-family: var(--font-body); font-size: 0.88rem; line-height: 1.6;
    margin: 0.9rem 0 0; padding-left: 0.9rem; border-left: 3px solid var(--ra-amber);
  }
  :global([data-theme="dark"]) .hero-cap { color: var(--color-text-muted); }
  :global([data-theme="light"]) .hero-cap { color: var(--color-text-dark-muted); }

  /* ---------- boarding pass ---------- */
  .pass {
    max-width: 1280px; margin: 3.5rem auto 0;
    display: grid; grid-template-columns: 1.4fr 1fr;
    border: 3px solid;
    position: relative;
  }
  :global([data-theme="dark"]) .pass { border-color: var(--color-border); background: var(--color-surface); }
  :global([data-theme="light"]) .pass { border-color: var(--ra-navy); background: var(--color-surface-light); }
  .pass-main { padding: 1.6rem 1.8rem; }
  .pass-stub {
