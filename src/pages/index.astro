<script is:inline>
  (function () {
    // Placings for the open-class judging card. Totals out of 40.
    var BANDS = [
      { min: 36, cls: 'blue', short: '1st', place: 'Blue Ribbon, first place',
        note: 'Everything was written down before it started and somebody is checking it. Frame this card. The exhibitor collects them.' },
      { min: 28, cls: 'red', short: '2nd', place: 'Second place',
        note: 'Sound entry. One criterion is resting on a feeling. Measure it before the auditor does.' },
      { min: 20, cls: 'yellow', short: '3rd', place: 'Third place',
        note: 'It may well work. You just cannot prove it to a stranger, which is who your auditor is.' },
      { min: 10, cls: 'white', short: '4th', place: 'Fourth place',
        note: "You are in good company. See the exhibitor's butter. The difference is that now you know which points you left on the table." },
      { min: 0, cls: 'green', short: 'H.M.', place: 'Thank you for entering',
        note: 'Honorable mention for honesty, which is the only criterion that was not on the card.' }
    ];
    var ALL = ['blue', 'red', 'yellow', 'white', 'green', 'blank'];

    function boot() {
      var form = document.getElementById('br-entry-form');
      if (!form || form.getAttribute('data-bound') === 'yes') return;
      form.setAttribute('data-bound', 'yes');

      var total = document.getElementById('br-result-total');
      var count = document.getElementById('br-result-count');
      var place = document.getElementById('br-result-place');
      var note = document.getElementById('br-result-note');
      var rosette = document.getElementById('br-result-rosette');
      var short = document.getElementById('br-result-short');
      var names = ['aim', 'base', 'edge', 'name'];

      function score() {
        var sum = 0;
        var judged = 0;
        names.forEach(function (n) {
          var picked = form.querySelector('input[name="' + n + '"]:checked');
          if (picked) {
            judged += 1;
            sum += parseInt(picked.value, 10) || 0;
          }
        });
        total.textContent = String(sum);
        count.textContent = '(' + judged + ' of 4 judged)';
        if (judged < 4) {
          place.textContent = 'Judging in progress';
          note.textContent = (4 - judged) + ' criteria to go. The judge does not award partial cards, and neither should you.';
          setRibbon('blank', '?');
          return;
        }
        for (var i = 0; i < BANDS.length; i++) {
          if (sum >= BANDS[i].min) {
            place.textContent = BANDS[i].place;
            note.textContent = BANDS[i].note;
            setRibbon(BANDS[i].cls, BANDS[i].short);
            return;
          }
        }
      }

      function setRibbon(cls, text) {
        ALL.forEach(function (c) { rosette.classList.remove('br-rosette-' + c); });
        rosette.classList.add('br-rosette-' + cls);
        short.textContent = text;
      }

      form.addEventListener('change', score);
      form.addEventListener('submit', function (e) { e.preventDefault(); });
    }

    if (!window.__brBound) {
      window.__brBound = true;
      document.addEventListener('astro:page-load', boot);
    }
    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);
  })();
</script>
