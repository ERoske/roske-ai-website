    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.66;
    color: var(--er-dark-muted);
    margin: 1.2rem 0 0;
    min-height: 1.4rem;
    max-width: 62ch;
  }
  .er-door-msg.is-bad { color: var(--er-red); }
  .er-door-msg.is-good { color: var(--er-amber); }
  .er-giveup {
