---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;
const ROOM_NO = 'ROOM 3';

// ---------------------------------------------------------------------------
// WHAT'S IN THE ROOM WITH YOU. Four numbers, all real.
// ---------------------------------------------------------------------------
const inventory = [
  { v: '300+', k: 'Rooms escaped, each' },
  { v: '80+', k: 'Countries visited' },
  { v: '15', k: 'Books on the shelf' },
  { v: '25', k: 'Years running interRel' },
];

// ---------------------------------------------------------------------------
// THE PUZZLE. Three stations. Four questions each, and exactly one of them
// has an edge on it. VERBATIM answers all four with total confidence, which
// is the joke and also the entire argument: the room never withholds the
// answer, it withholds it from the question you asked.
//
// Every correct answer below is a real fact that is checkable elsewhere on
// this site, which is the conversion mechanic wearing a game costume.
// ---------------------------------------------------------------------------
interface RoomQuestion {
  q: string;
  a: string;
  ok?: boolean;
  n?: string;
}

interface Station {
  id: string;
  no: string;
  name: string;
  prop: string;
  img: string;
  imgW: number;
  imgH: number;
  imgAlt: string;
  questions: RoomQuestion[];
  hint: string;
  why: string;
}

const stations: Station[] = [
  {
    id: 'shelf',
    no: 'I',
    name: 'The shelf',
    prop: '15 books with his name on the spine. Nobody has defended the ordering.',
    img: '/images/escape-room/bookshelf.jpg',
    imgW: 1195,
    imgH: 1600,
    imgAlt:
      'Edward Roske in his signature blue fedora reaching up to pull a thick technical hardback from a tall library shelf under a brass reading lamp, a small brass key turned in the shelf lock beside his hand and a second key held in his other hand.',
    questions: [
      {
        q: 'Tell me about the books.',
        a: 'There are fifteen books on the shelf. They are arranged spine out. The tallest is 23.5 centimeters. I can keep going.',
      },
      {
        q: 'Are the books any good?',
        a: `I am not authorized to hold opinions about books. I can tell you that more than one of them describes software Oracle no longer sells, and that this was not the author's decision.`,
      },
      {
        q: 'How many books did he write?',
        a: 'Fifteen. You asked for a count, so I counted everything on the shelf. You did not say a count of what.',
      },
      {
        q: 'How many of the fifteen can a stranger buy today?',
        a: 'Thirteen. The other two were written for training classes and never listed for sale, so a stranger cannot buy them at any price. You put a boundary on the question, which is why it has an answer.',
        ok: true,
        n: '13',
      },
    ],
    hint: 'Counting is the easy half. Two of the 15 have never been for sale, which is the half nobody asks about.',
    why: `Four questions at the same shelf, and the only one that got a number out of it was the one that said who's asking and as of when. That's the whole trick, and I wish it were a more interesting trick.`,
  },
  {
    id: 'timeline',
    no: 'II',
    name: 'The timeline',
    prop: 'A career chalked along one wall. It starts at 1997 and it has been argued with.',
    img: '/images/escape-room/terminal.jpg',
    imgW: 1600,
    imgH: 1195,
    imgAlt:
      'Edward Roske in his signature blue fedora sitting at a long polished boardroom table in a dim locked room, arms folded, regarding an old beige CRT terminal glowing amber, his expression patient and thoroughly unimpressed.',
    questions: [
      {
        q: 'How long did he run interRel?',
        a: 'A number of years. You did not say whether to stop counting at the merger, at the name change, or on the day he actually left, and those are three different numbers. So: a number of years.',
      },
      {
        q: 'When did he start?',
        a: '1997. He was 22. You asked when he started, so I have not told you when he stopped.',
      },
      {
        q: 'What happened to the company?',
        a: 'Merged with Keste in 2020 to help form Argano, now a billion-dollar consulting firm. He still owns a thirtieth of it. None of that is a number of years.',
      },
      {
        q: 'How many years was he CEO of it, start to finish?',
        a: '25. 1997 to 2022. He founded it at 22, merged it with Keste in 2020 to help form Argano, and stayed chief executive until 2022. You told me where to start counting and where to stop, which is the only reason this answer has a number in it.',
        ok: true,
        n: '25',
      },
    ],
    hint: `The clock doesn't stop at the merger. Say where the counting starts and where it stops and there is exactly one number.`,
    why: `If it won't say what it counted, you don't have a number yet, and you'd be amazed how many slides that thing gets onto before anybody checks.`,
  },
  {
    id: 'wall',
    no: 'III',
    name: 'The wall of locks',
    prop: 'Several hundred padlocks on a board, brass and steel and iron, hung in rows.',
    img: '/images/escape-room/keypad.jpg',
    imgW: 1600,
    imgH: 1195,
    imgAlt:
      `Close view of Edward Roske in his signature blue fedora leaning in with a jeweler's loupe to one eye, inspecting a brass three-dial combination lock mounted on a riveted steel plate on a heavy wooden door, a lit oil lantern behind him.`,
    questions: [
      {
        q: 'How many locks are on that wall?',
        a: 'A quantity. You did not say whether to include the ones still in the crate, the two on the floor, or the one on the door you are trying to open, and each of those gives a different total. So: a quantity.',
      },
      {
        q: 'Who has the key?',
        a: 'Nobody. None of these were opened with a key.',
      },
      {
        q: 'Open the door.',
        a: 'That is not a question. I can process it anyway, and the answer is no.',
      },
      {
        q: 'How many did one person open, and over how long?',
        a: 'Three hundred each, by two people, over about a decade. Edward and Dawn, separately, keeping separate counts, which has caused exactly the argument you are imagining. They also vote on the best rooms in the world every year and are paid nothing for it.',
        ok: true,
        n: '300',
      },
    ],
    hint: 'Two people, one number each, and neither of them will round it.',
    why: `You asked for a count without saying a count of what, so it said "a quantity," which is flawless and which I dare you to put in a board deck.`,
  },
];

// ---------------------------------------------------------------------------
// THE PRIZE. What is actually behind the door: the questions Edward uses on
// vendors, each one paired with the lazy version that gets waved through.
// ---------------------------------------------------------------------------
const sheet = [
  {
    lazy: 'How accurate is it?',
    good: `What does it do when it doesn't know?`,
    note: `Accuracy is a number on their slide and it's always a good number. What you live with is what it does at the edge of what it knows, which is the part that turns up in your close at 11pm (never at 2pm, and I've stopped trying to explain why).`,
  },
  {
    lazy: 'Is there a human in the loop?',
    good: 'Which decisions does this make with no person involved, and whose name is on those?',
    note: 'Everybody says yes to the first one, and the second one produces a list, which is usually longer than the room expected and which somebody in the back is already doing the math on.',
  },
  {
    lazy: 'Can I see a demo?',
    good: 'Show me a run where it was wrong, and what you changed afterward.',
    note: 'A demo is a rehearsed answer, so ask for the postmortem instead, and a vendor who hasn\'t got one has either never shipped or never looked very hard.',
  },
  {
    lazy: 'Is our data secure?',
    good: 'If we leave in 18 months, what do we walk out with, in what format?',
    note: `They'll pass the security question, everybody passes the security question. Whether you can walk your own data out in a format somebody else can read is the one that decides what you're worth at renewal, and nobody asks it until month 17.`,
  },
  {
    lazy: 'What is your SLA?',
    good: 'Who at your company gets woken up when this is wrong at 2am on day 3 of close?',
    note: `Ask who, by name, with a phone number, and watch them reach for the support tier instead. The SLA is what they owe you after it's already gone wrong, which is the wrong end of the problem to be negotiating from at 2am.`,
  },
  {
    lazy: 'What does it cost?',
    good: 'What did this cost your last customer my size, all in, counting our people?',
    note: `The license is the small number. Integration, cleanup, the data nobody wanted to admit was a mess, the 2 people who now babysit it, the consultant you bring in at month 4, and a bunch more, and none of that is on the quote they hand you, which is why the number worth asking for is the one their last customer actually paid. Ask them, not the rep.`,
  },
];

// ---------------------------------------------------------------------------
// OBJECTS IN THE ROOM. The 6 real projects, catalogued the way a room's
// props list is catalogued: what it is, whether it is in play.
// ---------------------------------------------------------------------------
const objects = [
  {
    tag: 'OBJ-01',
    name: 'MCP Servers for Enterprise Finance',
    state: 'In play',
    tone: 'go',
    note: `Plumbing so an AI reads the real number out of Essbase and Oracle EPM instead of remembering one that sounds about right. Essbase and EPM Planning have shipped, Financial Close and Consolidations is in beta (beta meaning it works and I'm not ready to say that out loud yet). It's the least glamorous thing on this list and the one most likely to matter.`,
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    tag: 'OBJ-02',
    name: 'Caribbean AI Summit',
    state: 'October 9 to 10',
    tone: 'go',
    note: `Co-chairing the biggest AI conference we've put on down here, at the Convention Center in San Juan: 30-plus speakers, 3 tracks, every session translated live between English and Spanish. The lineup is public now, including Kay Firth-Butterfield (formerly Head of AI at the World Economic Forum), MIT's Fabio Duarte, and Idoia Salazar, who advises the EU Parliament on AI. Come in a day early and I'll show you the island (I'm told I'm a mediocre tour guide with strong opinions about which of the two forts is the good fort).`,
    href: 'https://www.caribbeansummit.ai/',
    external: true,
    cta: 'Get a seat',
  },
  {
    tag: 'OBJ-03',
    name: 'Caprus',
    state: 'In play',
    tone: 'go',
    note: `Investor in the AI software and services firm building faster operations for finance teams. Lillian Buziak runs it. I turn up, point at the roadmap, and they're gracious about it.`,
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    tag: 'OBJ-04',
    name: 'Everest Base Camp',
    state: 'Solved',
    tone: 'done',
    note: `Two weeks on foot to 18,571 feet with Dawn in April. The trail log is on the blog, including the parts that went badly and the part where I asked the guides more questions than they had signed up for.`,
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    tag: 'OBJ-05',
    name: "AI Dungeon Master's Screen",
    state: 'Set aside',
    tone: 'hold',
    note: `A prototype screen for running 5e: lore lookups and improvisation help for the person behind the cardboard. It's never earned a dollar, it isn't finished, and I would keep it over half the paying ones.`,
    href: null,
    external: false,
    cta: 'Quiet build',
  },
  {
    tag: 'OBJ-06',
    name: 'Puerto Rico AI Community',
    state: 'In play',
    tone: 'go',
    note: `President of the island's AI community (unpaid, obviously), now past 1,000 different people through the door. Every other month, free, both languages, and we argue until something useful falls out. Come to one!`,
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];

// ---------------------------------------------------------------------------
// SET DRESSING. Two plates that are not stations, used to break the grid.
// ---------------------------------------------------------------------------
interface Plate {
  src: string;
  w: number;
  h: number;
  alt: string;
  cap: string;
  tilt: number;
  wide?: boolean;
}

const dressing: Plate[] = [
  {
    src: '/images/escape-room/vent.jpg',
    w: 1195,
    h: 1600,
    alt: 'Edward Roske in his signature blue fedora lowering himself out of a square ceiling air vent onto a rolling office chair, holding the loose vent grille in one hand, entirely composed about it.',
    cap: `I check the ceiling in every room, on a chair with wheels, which is the part the staff watch on the monitor and the reason one of them now greets me by name.`,
    tilt: 1.8,
  },
  {
    src: '/images/escape-room/timer.jpg',
    w: 1600,
    h: 893,
    alt: 'Edward Roske in his signature blue fedora standing in a dim room with his hands behind his back, calmly watching a wall-mounted split-flap countdown clock that reads three minutes and thirty-three seconds, lit red.',
    cap: `3:33. There's a kind of player who speeds up here and a kind who slows down, and the second kind gets out more often (I've watched Dawn do it for a decade and it's still annoying).`,
    tilt: -1.2,
    wide: true,
  },
];
---

<BaseLayout>
  <WeeklyAnimation />

  <!-- ================= DOOR STRIP ================= -->
  <div class="er-strip" role="presentation">
    <div class="er-strip-inner">
      <span class="er-strip-item er-strip-mark">{ROOM_NO}</span>
      <span class="er-strip-item">Occupancy: 1</span>
      <span class="er-strip-item">Door: locked</span>
      <span class="er-strip-item">Locks remaining: 3</span>
      <span class="er-strip-item">Game master: off duty</span>
      <span class="er-strip-item">Hints: unlimited, no penalty</span>
    </div>
  </div>

  <!-- ================= HERO: THE ROOM ================= -->
  <section class="er-hero">
    <div class="er-hero-grid">
      <div class="er-hero-copy">
        <p class="er-kicker">Roske.AI | {ROOM_NO} | Week of September 12, 2026</p>
        <h1 class="er-h1">
          <span class="er-h1-line">You're locked in</span>
          <span class="er-h1-line">with an <span class="er-h1-hit">AI.</span></span>
        </h1>
        <p class="er-hero-sub">{theme.hero.subtitle}</p>
        <p class="er-hero-desc">{theme.hero.description}</p>
        <div class="er-hero-cta">
          <a href="#the-room" class="er-btn-solid">Start the room</a>
          <a href={theme.hero.ctaLink} class="er-btn-line">{theme.hero.ctaText}</a>
        </div>
      </div>

      <figure class="er-hero-fig">
        <div class="er-frame er-frame-hero">
          <span class="er-plate-tag" aria-hidden="true">The wall</span>
          <img
            src={`/images/${theme.hero.heroImage}`}
            alt={theme.hero.imageAlt}
            width="1600"
            height="893"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="er-hero-img"
          />
        </div>
        <figcaption class="er-hero-cap">
          Every lock on that board came off a door that was supposed to stay shut, and almost none of them
          came off because somebody was clever with a paperclip. Mostly somebody finally asked the right
          thing out loud at minute 48, and it was usually the person who'd said nothing for the first 40.
        </figcaption>
      </figure>
    </div>

    <!-- inventory -->
    <div class="er-inv" aria-label="What is in the room">
      <p class="er-inv-label">Contents of the room</p>
      <div class="er-inv-grid">
        {inventory.map((s) => (
          <div class="er-inv-cell">
            <span class="er-inv-v">{s.v}</span>
            <span class="er-inv-k">{s.k}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= THE ROOM (the puzzle) ================= -->
  <section class="er-room" id="the-room">
    <div class="er-room-inner">
      <div class="er-room-head">
        <div>
          <p class="er-eyebrow er-eyebrow-on-dark">The room | Three locks</p>
          <h2 class="er-h2 er-h2-on-dark">Ask it something.</h2>
          <p class="er-deck er-deck-on-dark">
            The terminal in the corner runs a system called VERBATIM. It answers exactly what you asked,
            with total confidence, and nothing else, which means it's never wrong and frequently useless.
            Three of the questions at each station are the kind people actually ask. One has an edge on it
            and produces a number. Three numbers open the door, and the whole thing takes about 90
            seconds (Dawn hasn't tried it yet, and I've already made my peace with whatever her time turns out to be).
          </p>
        </div>
        <div class="er-clock" aria-label="Room timer">
          <span class="er-clock-label">Time remaining</span>
          <span class="er-clock-digits" id="er-clock" data-seconds="3600">60:00</span>
          <span class="er-clock-note">Nothing happens at zero. It's a prop.</span>
        </div>
      </div>

      <ol class="er-stations">
        {stations.map((st) => (
          <li class="er-station" data-station={st.id}>
            <div class="er-station-body">
              <header class="er-station-head">
                <span class="er-station-no" aria-hidden="true">{st.no}</span>
                <div>
                  <h3 class="er-station-name">
                    {st.name}
                    <span class="er-station-state" data-state-for={st.id}>Locked</span>
                  </h3>
                  <p class="er-station-prop">{st.prop}</p>
                </div>
              </header>

              <fieldset class="er-qset">
                <legend class="er-qlegend">Say one of these out loud. Only one of them is a question worth asking.</legend>
                <div class="er-qgrid">
                  {st.questions.map((q, qi) => (
                    <button
                      type="button"
                      class="er-q"
                      data-ask={st.id}
                      data-answer={q.a}
                      data-ok={q.ok ? 'yes' : 'no'}
                      data-number={q.n ?? ''}
                      data-index={qi}
                    >
                      <span class="er-q-mark" aria-hidden="true">?</span>
                      <span class="er-q-text">{q.q}</span>
                    </button>
                  ))}
                </div>
              </fieldset>

              <div class="er-readout" data-readout-for={st.id}>
                <p class="er-readout-name" aria-hidden="true">VERBATIM v1.0</p>
                <p class="er-readout-text" role="status" aria-live="polite" data-text-for={st.id}
                  >Awaiting input. I will answer precisely what you ask me.</p
                >
                <p class="er-readout-why" data-why-for={st.id} hidden>{st.why}</p>
              </div>

              <div class="er-station-foot">
                <details class="er-hint">
                  <summary>I'm stuck</summary>
                  <p>{st.hint}</p>
                </details>
                <p class="er-got" data-got-for={st.id} hidden>
                  <span class="er-got-label">Lock {st.no} open. Number:</span>
                  <span class="er-got-n">{st.questions.find((q) => q.ok)?.n}</span>
                </p>
              </div>
            </div>

            <figure class="er-station-fig">
              <div class="er-frame">
                <img
                  src={st.img}
                  alt={st.imgAlt}
                  width={st.imgW}
                  height={st.imgH}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </figure>
          </li>
        ))}
      </ol>

      <!-- ---------------- THE DOOR ---------------- -->
      <div class="er-door" id="er-door">
        <div class="er-door-plate">
          <p class="er-eyebrow er-eyebrow-on-dark">The door</p>
          <h3 class="er-door-h">Three numbers, in order.</h3>
          <p class="er-door-deck">
            Type them in and turn the handle. Wrong combinations cost you nothing here, which is not true
            of the version of this you do with a vendor.
          </p>

          <form class="er-dials" id="er-lock-form" novalidate>
            <div class="er-dial">
              <label for="er-d1">First</label>
              <input id="er-d1" name="d1" type="text" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="--" />
            </div>
            <div class="er-dial">
              <label for="er-d2">Second</label>
              <input id="er-d2" name="d2" type="text" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="--" />
            </div>
            <div class="er-dial">
              <label for="er-d3">Third</label>
              <input id="er-d3" name="d3" type="text" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="---" />
            </div>
            <button type="submit" class="er-btn-solid er-dial-go">Turn the handle</button>
          </form>

          <p class="er-door-msg" role="status" aria-live="polite" id="er-door-msg"></p>

          <button type="button" class="er-giveup" id="er-giveup">
            Show me the answer
          </button>
        </div>

        <!-- the reveal -->
        <div class="er-reveal" id="er-reveal" hidden>
          <p class="er-reveal-eyebrow">The door is open</p>
          <h3 class="er-reveal-h">Take this with you.</h3>
          <p class="er-reveal-deck">
            6 questions I actually ask before I sign anything with the word AI in the contract, each one
            next to the lazy version that gets waved through in the room. The lazy ones all have answers,
            which is exactly why they get waved through.
          </p>
          <ol class="er-sheet">
            {sheet.map((s, i) => (
              <li class="er-sheet-row">
                <span class="er-sheet-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="er-sheet-body">
                  <p class="er-sheet-lazy"><span>Usually asked:</span> {s.lazy}</p>
                  <p class="er-sheet-good">{s.good}</p>
                  <p class="er-sheet-note">{s.note}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="er-reveal-foot">
            I do a 45-minute version of this on a stage, with worse jokes and a live demo of the
            agents that rebuilt this page at 5am while I was asleep.
            <a href="/speaking/">That talk is for hire</a>. There's also a door in this building that has
            been unlocked since 1997 and I've never had the heart to seal up:
            <a href="/april-1-1997.html">try the handle</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= LATEST DISPATCHES ================= -->
  <LatestContent
    eyebrow="Slid under the door"
    heading="Newest <em>in the room.</em>"
    deck="Writing and video, most recent first. None of it is part of the puzzle. It's just the work."
  />

  <!-- ================= BOOK EDWARD ================= -->
  <SpeakerCTA eyebrow="The main event" />

  <!-- ================= SET DRESSING ================= -->
  <section class="er-dressing" id="dressing">
    <div class="er-dressing-inner">
      <div class="er-dressing-head">
        <p class="er-eyebrow">Also in here</p>
        <h2 class="er-h2">Things I check in every room.</h2>
        <p class="er-deck">
          300 rooms in, the habits are involuntary: I lift the rug, I count the chairs, I check behind the
          framed thing, I pull on the bookcase to see if it's a bookcase, and I have been asked by an
          actual game master to please stop doing that to his bookcase.
        </p>
      </div>
      <div class="er-plates">
        {dressing.map((p) => (
          <figure class={`er-plate${p.wide ? ' er-plate-wide' : ''}`} style={`--tilt:${p.tilt}deg`}>
            <div class="er-frame">
              <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
            </div>
            <figcaption>{p.cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= OBJECTS IN THE ROOM (6 projects) ================= -->
  <section class="er-objects" id="objects">
    <div class="er-objects-inner">
      <div class="er-objects-head">
        <p class="er-eyebrow">Props list</p>
        <h2 class="er-h2">What's actually on the table.</h2>
        <p class="er-deck">
          6 things I'm working on, catalogued the way a game master catalogues a room: what it is, and
          whether it's in play. One of them hasn't moved since spring and I keep not admitting that.
        </p>
      </div>

      <div class="er-obj-grid">
        {objects.map((o) => (
          <article class={`er-obj er-obj-${o.tone}`}>
            <header class="er-obj-head">
              <span class="er-obj-tag">{o.tag}</span>
              <span class={`er-obj-state er-obj-state-${o.tone}`}>{o.state}</span>
            </header>
            <h3 class="er-obj-name">{o.name}</h3>
            <p class="er-obj-note">{o.note}</p>
            {o.href ? (
              <a
                class="er-obj-cta"
                href={o.href}
                target={o.external ? '_blank' : undefined}
                rel={o.external ? 'noopener noreferrer' : undefined}
              >
                {o.cta}
                <span aria-hidden="true">&#8594;</span>
              </a>
            ) : (
              <span class="er-obj-cta er-obj-cta-off">{o.cta}</span>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= WHAT'S NEW ================= -->
  <WhatsNew
    eyebrow="Taped to the mirror"
