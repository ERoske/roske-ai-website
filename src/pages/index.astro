---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// ---------------------------------------------------------------------------
// DOORBUSTER (launched 12:00 AM AST, Black Friday, 2026-11-27). The page is
// a sale circular for AI deals. The argument: the sticker is real, and it's
// the smallest number in the deal; the cost lives in the fine print. Halloween
// asked whether the AI is real; this week assumes it works and asks whether
// the deal is. No real retailers, AI vendors, logos, or real prices. Edward
// is the only person depicted.
// ---------------------------------------------------------------------------

const IMG = '/images/doorbuster';
const CAL = 'https://calendar.app.google/udtTerQwcX9Z7QQt7';
const POST = '/blog/is-that-ai-deal-actually-a-deal/';

// The 4 standing numbers. Same every week.
const stats = [
  { v: '80+', k: 'Countries visited' },
  { v: '50+', k: 'Countries spoken in' },
  { v: '15', k: 'Books' },
  { v: '25', k: 'Years running interRel' },
];

// The doorbusters. Generic composites, no real vendor, no real price.
const busters = [
  {
    name: 'The Free Pilot',
    was: 'Was: a budget meeting',
    now: 'FREE',
    unit: '',
    fine: `For 90 days. On day 91 it turns into a 3-year commitment, unless somebody remembers to cancel it, and the person who signed it got promoted in September (Admiral Ackbar would like a word).`,
  },
  {
    name: 'Unlimited AI for Everyone',
    was: 'Was $24.97',
    now: '$19.97',
    unit: 'per seat, per month',
    fine: `Unlimited, subject to fair use, and fair use is a number they tell you about after you hit it (my own plan is the first paragraph of today's post, and it isn't flattering).`,
  },
  {
    name: 'Pay Only for What You Use',
    was: 'Was: a fixed price',
    now: '$0.00',
    unit: 'to start',
    fine: `Metered by the token, and nobody, including the vendor, can tell you in advance how many tokens you'll use. I've seen recordings of 2 AIs negotiating with each other until they devolved into their own shorthand that nobody was reading anymore (I assume somebody was paying for every word).`,
  },
  {
    name: 'Priced Per Agent',
    was: 'Was: priced per seat',
    now: '$1',
    unit: 'per agent, per day',
    fine: `Ask 100 AI people what an agent is and you'll get no fewer than 297 definitions (I've said that on my show and I stand by the math), so find out whose definition the invoice uses.`,
  },
  {
    name: 'AI Included, Free',
    was: 'With your renewal',
    now: '$0',
    unit: 'add-on',
    fine: `The AI line on the invoice really does say $0. The line right above it, the renewal, went up, and it didn't explain why.`,
  },
  {
    name: 'Lifetime Access',
    was: 'Was: a subscription',
    now: '1',
    unit: 'payment',
    fine: `Lifetime of the product, which isn't the same thing as your lifetime, and the model underneath it can get retired over a weekend (there's a whole post about that on the blog).`,
    link: { href: '/blog/your-best-ai-model-can-vanish-over-a-weekend/', text: 'Read it' },
  },
];

// The questions to ask before signing. The screenshot part.
const questions = [
  `How is it metered, and what did a heavy month cost a real customer about your size? Ask for an actual invoice, since the calculator on the website has never had a heavy month in its life.`,
  `What does the pilot turn into on day 91, and whose job is it to say no?`,
  `What happens to the price at renewal? Get the cap in writing, because "we don't usually raise prices much" isn't a cap.`,
  `When the model underneath gets updated or retired, what do you get, and does the work you built on it still work?`,
  `Who owns your data and everything you type into it, and can they train on any of it? (If you're on the free version, the model you're training is the one your competitor is paying for.)`,
  `How do you leave, and what do you get to take with you when you go?`,
  `What's it going to cost to get it working on your real data and get your people actually using it? Nobody quotes that line, and it's usually the biggest one on the receipt.`,
];

// The receipt. Dollar signs are relative size, not real prices.
const receipt = [
  { item: 'AI PLATFORM (DOORBUSTER)', amt: '$' },
  { item: 'USAGE PAST "UNLIMITED"', amt: '$$' },
  { item: 'CONNECTING IT TO YOUR DATA', amt: '$$$$' },
  { item: 'CLEANING THE DATA FIRST', amt: '$$$$$' },
  { item: 'PEOPLE CHANGING HOW THEY WORK', amt: '$$$$$$' },
  { item: 'RENEWAL, YEAR 2', amt: 'SEE STORE' },
];

// Year-round stock: the 6 projects. Same 6 every week, restyled.
const projects = [
  {
    name: 'MCP Servers for Enterprise Finance',
    status: 'In stock',
    note: `Plumbing so an AI reads the real number out of Oracle Essbase and EPM instead of remembering one that sounds about right. Essbase and EPM Planning have shipped, and Financial Close and Consolidations is in beta.`,
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    name: 'Caribbean AI Summit',
    status: 'Sold out, October 9 and 10',
    note: `Co-chaired it: 800+ people, 17 countries, 44 speakers, and 6 fire extinguishers Dawn bought at Walmart at 7:30 in the morning (the only retail purchase on this page that was worth every penny).`,
    href: '/blog/how-many-fire-extinguishers-does-an-ai-summit-need/',
    external: false,
    cta: 'Read the recap',
  },
  {
    name: 'Caprus',
    status: 'Investor',
    note: `I'm an investor, and that's the whole job. Lillian Buziak runs it, and they sell and support AgentCube (the first item in this aisle), which spares everybody from having me do it.`,
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    name: 'Everest Base Camp',
    status: 'Done, April 2026',
    note: `2 weeks on foot to 18,571 feet with Dawn. The trail log is on the blog, and it makes 3 hours in a parking lot look a lot less impressive.`,
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    name: "AI Dungeon Master's Screen",
    status: 'Not on shelves yet',
    note: `A prototype screen for running 5e: lore lookups and improvisation help for the person behind the cardboard. It isn't public yet, and so far the only customer is me (and my players, who didn't get a vote).`,
    href: null,
    external: false,
    cta: 'No public link (take my word for it)',
  },
  {
    name: 'Puerto Rico AI Community',
    status: 'Free, every other month',
    note: `President of the island's AI community (unpaid, obviously), now past 1,000 different people through the door. Bi-monthly, both languages, and the reason the summit exists at all.`,
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title="Roske.AI | Doorbuster"
  description="Black Friday on roske.ai: Edward Roske camped out overnight for an AI doorbuster, and the page is a sale circular about why the sticker is the smallest number in an AI deal, with the fine-print questions to ask before you sign."
>
  <WeeklyAnimation />

  <!-- ================= MASTHEAD STRIP ================= -->
  <div class="db-strip" role="note" aria-label="Circular banner">
    <div class="db-wrap db-strip-inner">
      <span class="db-strip-tag">Doors open</span>
      <span>12:00 AM, Black Friday, November 27, 2026</span>
      <span class="db-strip-hide">Prices good through Cyber Monday</span>
      <span class="db-strip-hide">San Juan (while supplies last)</span>
    </div>
  </div>

  <!-- ================= HERO ================= -->
  <section class="db-hero" aria-labelledby="db-title">
    <div class="db-wrap db-hero-grid">
      <div class="db-hero-copy">
        <p class="db-kicker">The Roske.AI circular | Black Friday edition</p>
        <h1 class="db-title" id="db-title">Door<span>buster</span></h1>
        <p class="db-pull">{theme.hero.subtitle}</p>
        <div class="db-prose">
          <p>
            Every Saturday at 5AM this website rebuilds itself, but this week I told it to show up at midnight on Friday
            instead, because that's when the doors open, and I got here before it did. I've been sitting in this chair
            since 9 PM Thursday with a thermos and a plate of leftovers, waiting for the AI doorbuster on the banner
            (Edward, you have a master's in data science with a 4.0, and you've spent 3 hours in a parking lot for a
            discount you could have calculated in your head before the pie came out, and you didn't even check whether
            the store sells anything you need, which, now that I'm saying it out loud, is a thing you should probably
            not tell your clients).
          </p>
          <p>
            Every AI deal this season comes with a doorbuster number: a slashed compare-at price, a free pilot, a
            "lifetime" deal, a per-agent price nobody can define, a discount that expires at the end of the quarter
            (it's always the end of some quarter), and a bunch more. The sticker's real.
            It's also, in my experience, the smallest number in the deal, and I've watched enterprise software get sold
            for 30-some years. So this week's page is a sale circular, and every item in it comes with the fine
            print printed right there next to it, at a size you can actually read.
          </p>
        </div>
        <div class="db-ctas">
          <a class="db-btn db-btn-main" href={theme.hero.ctaLink}>{theme.hero.ctaText}</a>
          <a class="db-btn db-btn-ghost" href="#fine-print">Skip to the fine print</a>
        </div>
      </div>

      <div class="db-hero-art">
        <figure class="db-hero-photo">
          <img
            src={`/images/${theme.hero.heroImage}`}
            alt={theme.hero.imageAlt}
            width="1600"
            height="893"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>11:58 PM, and I'm first in line, mostly because I'm the only one in it.</figcaption>
        </figure>
        <div class="db-tag" aria-label="Price tag: compare at $1,000,000, now $999,999 with an asterisk">
          <span class="db-tag-hole" aria-hidden="true"></span>
          <span class="db-tag-label">AI, the whole thing</span>
          <span class="db-tag-was">Compare at <s>$1,000,000</s></span>
          <span class="db-tag-now">$999,999<sup>*</sup></span>
          <span class="db-tag-fine">*Per seat, per month, billed annually, 500-seat minimum, price good until the end of the quarter, which is always 2 weeks from now.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <div class="db-stats-wrap">
    <div class="db-wrap">
      <ul class="db-stats" aria-label="On the record">
        {stats.map((s) => (
          <li><span class="db-stat-v">{s.v}</span><span class="db-stat-k">{s.k}</span></li>
        ))}
      </ul>
      <p class="db-stats-note">None of these are on sale (I asked), they're just here for comparison purposes.</p>
    </div>
  </div>

  <!-- ================= LATEST ================= -->
  <LatestContent
    eyebrow="Fresh off the truck"
    heading="New <em>this week.</em>"
    deck="This week's writing and video, newest first, including today's post on whether that AI deal is actually a deal (it starts with my own AI bill, which seemed only fair)."
  />

  <!-- ================= BOOK EDWARD ================= -->
  <SpeakerCTA eyebrow="The one price in this circular with no asterisk" />

  <!-- ================= THE LINE (pinned parking lot) ================= -->
  <section class="db-lot" aria-labelledby="db-line-title">
    <div class="db-wrap">
      <p class="db-eyebrow db-lot-eyebrow">The line</p>
      <h2 class="db-h2 db-lot-h2" id="db-line-title">9:00 PM to 12:00 AM, a timeline</h2>
      <p class="db-lot-deck">
        For the record, the line was me and a rope tied between 4 traffic cones. Back in 2007 somebody handed me a free
        iPod Touch at Oracle OpenWorld, and I wrote on my blog that it was "a blatant bribe which I shamelessly
        accepted," so I'm in no position to lecture anybody about free stuff (I'm going to anyway… further down the
        page).
      </p>
      <ol class="db-timeline">
        <li class="db-shot db-shot-tall">
          <span class="db-time">9:00 PM</span>
          <figure>
            <img src={`${IMG}/leftovers.jpg`} width="1195" height="1600" loading="lazy" decoding="async"
              alt="Edward in his blue fedora and blue blazer sits in a folding camping chair outside a dark store at night, eating a paper plate of mashed potatoes, stuffing, green beans, and cranberry sauce with a plastic fork, foil peeled back. A sign on the glass door behind him reads OPENS 12:00 AM." />
            <figcaption>First in line, with leftovers and a plastic fork. The sign says 12:00 AM, and I've checked it 9 times.</figcaption>
          </figure>
        </li>
        <li class="db-shot">
          <span class="db-time">11:40 PM</span>
          <figure>
            <img src={`${IMG}/frost.jpg`} width="1600" height="1195" loading="lazy" decoding="async"
              alt="Edward wrapped in a red plaid blanket in a camping chair outside a glowing storefront, checking his wristwatch, with a thin layer of white frost on the brim of his blue fedora and his breath visible in the cold air." />
            <figcaption>Frost on the brim. It doesn't frost in San Juan, which makes this the least believable picture on the page (and there's one of me in pajamas further down).</figcaption>
          </figure>
        </li>
        <li class="db-shot db-shot-wide">
          <span class="db-time">12:00:04 AM</span>
          <figure>
            <img src={`${IMG}/doors.jpg`} width="1600" height="893" loading="lazy" decoding="async"
              alt="Edward mid-sprint in front of a store's open automatic glass doors, one hand holding his blue fedora on his head and the other holding a steel thermos, a red plaid blanket flying behind him like a cape. Red and yellow SALE and 50% OFF signs fill the store behind him." />
            <figcaption>Mid-sprint with the thermos, and the blanket has become a cape. The fedora stays on, obviously.</figcaption>
          </figure>
        </li>
      </ol>
    </div>
  </section>

  <!-- ================= THE DOORBUSTERS (pinned newsprint) ================= -->
  <section class="db-circular" id="doorbusters" aria-labelledby="db-bust-title">
    <div class="db-wrap">
      <div class="db-circ-head">
        <p class="db-eyebrow db-circ-eyebrow">This week's doorbusters</p>
        <h2 class="db-h2 db-circ-h2" id="db-bust-title">6 AI deals, with the fine print enlarged</h2>
        <p class="db-circ-deck">
          None of these are real vendors or real prices, and every one of them will look familiar if you've opened your
          inbox since September (if one of them looks exactly like an email you got last Tuesday, that's a coincidence,
          and I'd still read the asterisk).
        </p>
      </div>
      <ol class="db-busters">
        {busters.map((b, i) => (
          <li class="db-buster">
            <span class="db-burst" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="db-buster-name">{b.name}</h3>
            <p class="db-buster-was">{b.was}</p>
            <p class="db-buster-now">{b.now}<sup>*</sup> {b.unit && <span>{b.unit}</span>}</p>
            <p class="db-buster-fine">
              <span class="db-ast">*</span>{b.fine}
              {b.link && <> <a href={b.link.href}>{b.link.text}</a>.</>}
            </p>
          </li>
        ))}
      </ol>
      <p class="db-circ-foot">
        Halloween was about AI that's secretly plain software (that page is <a href="/blog/is-the-ai-you-just-bought-wearing-a-costume/">over here</a>).
        Everything in this aisle works, so this week I'm only asking what it costs.
      </p>
    </div>
  </section>

  <!-- ================= THE FINE PRINT ================= -->
  <section class="db-section" id="fine-print" aria-labelledby="db-fine-title">
    <div class="db-wrap db-fine-grid">
      <figure class="db-photo db-tilt-l db-fine-photo">
        <img src={`${IMG}/fine-print.jpg`} width="1600" height="1195" loading="lazy" decoding="async"
          alt="Close up in a store aisle, Edward in his blue fedora holds a magnifying glass to one eye, which looks huge through the lens. Beside him hangs a long red price tag from a white box labeled AI: SOLD OUT crossed out, $9.99, SALE, and below that a long column of tiny fine print." />
        <figcaption>The tag says SOLD OUT, crossed out, so it's either back in stock or it was never sold out. The fine print underneath is in Latin, as far as I can tell.</figcaption>
      </figure>
      <div>
        <p class="db-eyebrow">Bring a magnifying glass</p>
        <h2 class="db-h2" id="db-fine-title">What does it say under the asterisk?</h2>
        <p class="db-copy">
          These are the questions I'd ask before I signed anything this weekend, and none of them require a lawyer
          (the lawyer comes later, and the lawyer is not on sale either).
        </p>
        <ol class="db-questions">
          {questions.map((q) => <li>{q}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <!-- ================= THE RECEIPT ================= -->
  <section class="db-section db-band" aria-labelledby="db-rec-title">
    <div class="db-wrap db-rec-grid">
      <div class="db-rec-copy">
        <p class="db-eyebrow">At the register</p>
        <h2 class="db-h2" id="db-rec-title">Where's the sticker price on this receipt?</h2>
        <p class="db-copy">
          It's at the top, and it's the smallest line on it. In my 25 years running interRel, I had the best seat in the
          house for this, long before anybody put AI on a banner: the software is the cheap part, and the expensive
          part is getting it hooked up to your real data (after you clean that data up, because everybody's data needs
          it, and everybody's surprised), and then the months it takes people to change how they work.
        </p>
        <p class="db-copy">
          The dollar signs on the receipt are relative, by the way. I didn't want to make up numbers on a page about
          made-up numbers (it seemed like a bad look, and I have exactly 1 magnifying glass).
        </p>
      </div>
      <div class="db-rec-stack">
        <div class="db-receipt" role="group" aria-label="Itemized receipt for an AI deal, in relative cost">
          <p class="db-rec-store">ROSKE.AI GENERAL STORE<br />SAN JUAN, PR<br />11/27/2026 12:07 AM</p>
          <p class="db-rec-rule" aria-hidden="true">--------------------------------</p>
          {receipt.map((r) => (
            <div class="db-rec-row">
              <span>{r.item}</span>
              <span>{r.amt}</span>
            </div>
          ))}
          <p class="db-rec-rule" aria-hidden="true">--------------------------------</p>
          <div class="db-rec-row db-rec-total"><span>YOU SAVED</span><span>$0.00</span></div>
          <p class="db-rec-rule" aria-hidden="true">--------------------------------</p>
          <p class="db-rec-foot">ITEMS: 1 | CASHIER: AGENT 07<br />THANK YOU FOR SHOPPING<br />RETURNS: SEE BELOW</p>
          <p class="db-rec-barcode" aria-hidden="true"></p>
        </div>
        <figure class="db-photo db-tilt-r db-rec-photo">
          <img src={`${IMG}/receipt.jpg`} width="1195" height="1600" loading="lazy" decoding="async"
            alt="Edward in his blue fedora and blue blazer stands at a store checkout reading a receipt that unrolls off the counter, across the floor, and out through the open front doors into the night. A small white box labeled AI sits on the counter." />
          <figcaption>1 item. The receipt goes out the door and into the parking lot.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ================= YEAR-ROUND STOCK ================= -->
  <section class="db-section" aria-labelledby="db-stock-title">
    <div class="db-wrap">
      <p class="db-eyebrow">Aisle 6</p>
      <h2 class="db-h2" id="db-stock-title">Never on sale</h2>
      <p class="db-copy">
        The 6 things I'm actually working on this year, at regular price, which in most of these cases is free (the
        fedora isn't for sale either, so please don't ask).
      </p>
      <ol class="db-stock">
        {projects.map((p, i) => (
          <li class="db-card db-stock-item">
            <div class="db-stock-top">
              <span class="db-sku">SKU {pad(i + 1)}</span>
              <span class="db-status">{p.status}</span>
            </div>
            <h3 class="db-h3">{p.name}</h3>
            <p>{p.note}</p>
            {p.href ? (
              <a class="db-stock-link" href={p.href} {...(p.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                {p.cta}<span aria-hidden="true"> &rarr;</span>
              </a>
            ) : (
              <span class="db-stock-nolink">{p.cta}</span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= THE LAST BOX (blog teaser) ================= -->
  <section class="db-section db-band" aria-labelledby="db-post-title">
    <div class="db-wrap db-post-grid">
      <figure class="db-photo db-tilt-r">
        <img src={`${IMG}/last-box.jpg`} width="1600" height="1195" loading="lazy" decoding="async"
          alt="In a store aisle with empty shelves and a yellow DOORBUSTER shelf tag, Edward in his blue fedora smiles politely while holding one end of a big white box printed AI. A pair of hands in grey winter gloves grips the other end from off-frame." />
        <figcaption>The last box on the shelf. I'm being very polite about it, and I'm not letting go.</figcaption>
      </figure>
      <div>
        <p class="db-eyebrow">Today on the blog</p>
        <h2 class="db-h2" id="db-post-title">Is that AI deal actually a deal?</h2>
        <p class="db-copy">
          I wrote the long version for anybody who has to sign an order form before the quarter ends, and it starts with
          my own AI bill, which is a little embarrassing for a man who's spent this whole page lecturing you about fine
          print.
        </p>
        <div class="db-ctas">
          <a class="db-btn db-btn-main" href={POST}>Read the post</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CYBER MONDAY ================= -->
  <section class="db-section db-cyber" aria-labelledby="db-cyber-title">
    <div class="db-wrap db-cyber-grid">
      <div>
        <p class="db-eyebrow">Coming Monday</p>
        <h2 class="db-h2" id="db-cyber-title">Cyber Monday, 12:01 AM</h2>
        <p class="db-copy">
          Saturday is Small Business Saturday, and my business is 1 man and 10+ AI agents, so I'm counting it
          (the agents haven't asked for the weekend off, which I'm told is unusual in retail). Then Monday it all moves
          online, and the doorbusters come back as pop-ups with countdown timers, which is the same deal with a clock on
          it. A countdown timer is mostly there to keep you from reading the fine print, so I'd read it anyway,
          even if the clock runs out.
        </p>
      </div>
      <figure class="db-photo db-tilt-l">
        <img src={`${IMG}/cyber-monday.jpg`} width="1600" height="1195" loading="lazy" decoding="async"
          alt="At a dark kitchen table, Edward in red plaid pajamas and his blue fedora leans toward a laptop, one finger on the trackpad. The screen shows a countdown at 00:00:00 and the word REFRESHING. A mug of coffee and a slice of pumpkin pie with whipped cream sit beside the laptop." />
        <figcaption>Pajamas, fedora, pie, and a refresh button. I'm aware this undercuts the paragraph next to it.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ================= ELSEWHERE ================= -->
  <WhatsNew
    eyebrow="Also in this week's circular"
    heading="Seen <em>elsewhere.</em>"
    deck="Interviews, press, and posts from around the web, at regular price."
  />

  <!-- ================= RETURN POLICY + CTA ================= -->
  <section class="db-section db-returns" aria-labelledby="db-ret-title">
    <div class="db-wrap db-ret-inner">
      <p class="db-eyebrow">Customer service desk</p>
      <h2 class="db-h2 db-ret-h2" id="db-ret-title">Return policy <span>(please read before buying)</span></h2>
      <p class="db-copy">
        AI deals don't come with a gift receipt, and there's no line at Customer Service on Saturday morning where you
        can hand the box back. Here's the good news, though: the expensive lines on that receipt (your data cleaned up
        and your people actually working differently, plus whatever else the receipt said) are the ones you keep, even
        if you switch vendors next year.
      </p>
      <p class="db-copy">
        If you'd like me to say all this to your whole leadership team at once (with slides, and fewer pictures of me
        in a parking lot), keynotes start at $15,000 and the details are on the speaking page. If you'd rather just
        talk it through, I keep 13 minutes on my calendar for exactly that, and they're free (I checked the fine print
        myself)! Or write me (Edward@Roske.AI), Latin fine print welcome.
      </p>
      <div class="db-ctas">
        <a class="db-btn db-btn-main" href="/speaking/">Book Edward</a>
        <a class="db-btn db-btn-ghost" href={CAL} target="_blank" rel="noopener noreferrer">Take 13 free minutes</a>
