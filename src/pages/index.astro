---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// ---------------------------------------------------------------------------
// YOU CAN SEE EVERYTHING (2026-10-24). The A24 documentary about Elizabeth
// Holmes has been in theaters since October 16. Theranos was a box nobody was
// allowed to open. This site is the opposite: the box is open, every line is
// public, it works, and nobody can say why it made the choices it made,
// because a person didn't write it. So the site is a documentary about
// itself, in 5 chapters. Every number below was counted from the public git
// history at 05:00 AST on Saturday, October 24, 2026, BEFORE this week's
// commit was added to it. Edward is the only person in any generated image.
// ---------------------------------------------------------------------------

const IMG = '/images/you-can-see-everything';
const CAL = 'https://calendar.app.google/udtTerQwcX9Z7QQt7';
const REPO = 'https://github.com/ERoske/roske-ai-website';
const POST = '/blog/if-you-can-read-every-line-of-an-ais-code-do-you-understand-it/';

// Counted from `git log` before this week's commit. Recount next week.
const record = {
  commits: '244',
  since: 'February 18, 2026',
  days: '248',
  redesigns: '29',
  redesignIn: '24,022',
  redesignOut: '21,061',
  redesignFiles: '271',
  lastWeekFiles: '11',
  lastWeekIn: '912',
  lastWeekOut: '1,415',
  homePageCommits: '80',
  posts: '48',
  allIn: '75,087',
  allOut: '42,248',
};

// The last 10 "Weekly redesign" commits, verbatim from the public log
// (hash, author date with its recorded UTC offset, subject).
const gitLog = [
  { h: '6d3e967', d: '2026-10-17 09:58:44 +0100', s: 'Weekly redesign: Training Mode, a 1993 arcade fighting game' },
  { h: 'eca384b', d: '2026-10-03 05:21:06 -0400', s: 'Weekly redesign: The Caribbean AI Summit, the programme edition' },
  { h: '163c654', d: '2026-09-25 20:17:22 -0400', s: 'Weekly redesign: Blue Ribbon, the county fair judging' },
  { h: 'e39c180', d: '2026-09-16 10:22:14 +0000', s: 'Weekly redesign: The Escape Room (recovered from the Sept 12 run)' },
  { h: '7a063e5', d: '2026-09-05 05:26:15 -0400', s: 'Weekly redesign: Labor Day, the hardest-working weekend of the year' },
  { h: '191739a', d: '2026-08-29 05:46:21 -0400', s: 'Weekly redesign: Roske v. Acme, the case file' },
  { h: 'fff13fe', d: '2026-08-22 05:47:22 -0400', s: 'Weekly redesign: Roske Air, the AI deployment safety card' },
  { h: '6e3fc0c', d: '2026-08-15 05:36:45 -0400', s: 'Weekly redesign: A Field Guide to the Ten Agents' },
  { h: '33eecfb', d: '2026-08-01 22:56:46 -0400', s: 'Weekly redesign: AFC Roske: Believe (Ted Lasso season 4)' },
  { h: '03d8b0c', d: '2026-07-25 01:36:31 -0700', s: 'Weekly redesign: The Daily Roske (Brand New Day tabloid)' },
];

// Rendered as B-roll in Chapter 2.
const NL = String.fromCharCode(10);
const gitLogText =
  '$ git log --grep="Weekly redesign" --format="%h %ad %s" --date=iso -10' + NL +
  gitLog.map((g) => g.h + ' ' + g.d + ' ' + g.s).join(NL);

// The one line that types itself out in the cold open.
const typedCmd = '$ git log -1 --grep="Weekly redesign" --format="%h %ad %s"';
const typedOut = '6d3e967 2026-10-17 Weekly redesign: Training Mode, a 1993 arcade fighting game';

// The 4 standing numbers. Same every week.
const stats = [
  { v: '80+', k: 'Countries visited' },
  { v: '50+', k: 'Countries spoken in' },
  { v: '15', k: 'Books' },
  { v: '25', k: 'Years running interRel' },
];

// Chapter 1: the dossier.
const dossier = [
  { k: 'Subject', v: 'Edward Roske' },
  { k: 'Occupation', v: 'CEO of Dawnward. Speaker. Data scientist. Dungeon Master.' },
  { k: 'Location', v: 'San Juan, Puerto Rico (before that, The Great State of Texas, for 25+ years)' },
  { k: 'Known for', v: '25 years running interRel, 15 books, co-chairing the Caribbean AI Summit, and a YouTube channel with over 800,000 subscribers' },
  { k: 'Hat', v: 'Blue fedora. A Roske never removes his fedora in the presence of others.' },
  { k: 'Relationship to this website', v: 'Owner and subject. Did not write this page.' },
];

// Chapter 2: the ledger.
const ledger = [
  { v: record.commits, k: `commits since ${record.since}`, note: `${record.days} days, counting today` },
  { v: record.redesigns, k: 'weekly redesigns before this one', note: 'this is number 30' },
  { v: record.redesignIn, k: 'lines added by those redesigns', note: `across ${record.redesignFiles} file changes` },
  { v: record.redesignOut, k: 'lines removed by them', note: 'the previous week, every time' },
  { v: record.homePageCommits, k: 'commits that changed this page', note: 'the file you are reading' },
  { v: record.lastWeekOut, k: 'lines deleted last week alone', note: `${record.lastWeekIn} added, ${record.lastWeekFiles} files` },
  { v: record.posts, k: 'blog posts it may not touch', note: 'the one rule with no exceptions' },
  { v: record.allIn, k: 'lines added, all commits', note: `${record.allOut} removed, same period` },
];

// Chapter 4: the discrepancies, in date order, with the public commit for each.
const exhibits = [
  {
    date: 'June 13, 2026',
    ref: 'c684879',
    title: 'Built the whole thing. Forgot to commit it.',
    body: `The agent finished the redesign and never ran the commit. A backup script shipped it instead, with a message that's still in the log: "Claude completed the redesign but did not commit."`,
  },
  {
    date: 'August 1, 2026',
    ref: '33eecfb',
    title: 'Wrote "comes back Wednesday" on a page built to outlive Wednesday.',
    body: `The Ted Lasso week shipped with "Ted Lasso comes back Wednesday" in the hero, which was true for 4 days. The theme was being held for a second week, so the fix landed on Wednesday, August 5, the day of the premiere, by hand.`,
  },
  {
    date: 'September 12, 2026',
    ref: 'e39c180',
    title: 'Built an escape room. Could not get out of it.',
    body: `The run built The Escape Room, hit its own turn limit before committing, and the backup script that exists for exactly that case died on a git warning about Windows line endings. This site served a Labor Day theme until September 16, which is 11 days. The recovery commit explains the whole thing in 40 lines, if you want the gory version.`,
  },
  {
    date: 'July to October, 2026',
    ref: 'the log',
    title: 'Recorded itself in 4 time zones.',
    body: `The machine that commits this site has stamped its work -0700, -0400, +0000, and +0100 since July. The task is scheduled for 5 AM Atlantic time. Either the laptop travels more than I do, or it's confused (I travel a lot, so this would take some doing).`,
  },
];

// The exhibit table: the 6 projects. Same 6 every week, restyled.
const projects = [
  {
    tag: 'A',
    name: 'MCP Servers for Enterprise Finance',
    status: 'Shipping',
    note: `Plumbing so an AI reads the real number out of Oracle Essbase and EPM instead of remembering one that sounds about right. Essbase and EPM Planning have shipped, and Financial Close and Consolidations is in beta.`,
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    tag: 'B',
    name: 'Caribbean AI Summit',
    status: 'Happened, October 9 and 10',
    note: `Co-chaired it: 800+ people, 17 countries, 44 speakers, and 6 fire extinguishers Dawn bought at Walmart at 7:30 in the morning. The whole story is on the blog.`,
    href: '/blog/how-many-fire-extinguishers-does-an-ai-summit-need/',
    external: false,
    cta: 'Read the recap',
  },
  {
    tag: 'C',
    name: 'Caprus',
    status: 'Investor',
    note: `I'm an investor, and that's the whole job. Lillian Buziak runs it, and they sell and support AgentCube (Exhibit A), which spares everybody from having me do it.`,
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    tag: 'D',
    name: 'Everest Base Camp',
    status: 'Done, April 2026',
    note: `2 weeks on foot to 18,571 feet with Dawn. The trail log is on the blog, including the last 400 feet of Kala Patthar.`,
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    tag: 'E',
    name: "AI Dungeon Master's Screen",
    status: 'Quiet build',
    note: `A prototype screen for running 5e: lore lookups and improvisation help for the person behind the cardboard. It's nowhere near finished and isn't public yet, and so far the only customer is me (and my players, who didn't get a vote).`,
    href: null,
    external: false,
    cta: 'No public link (take my word for it)',
  },
  {
    tag: 'F',
    name: 'Puerto Rico AI Community',
    status: 'Every other month',
    note: `President of the island's AI community (unpaid, obviously), now past 1,000 different people through the door. Bi-monthly, free, both languages, and the reason the summit exists at all.`,
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];

// The machine's standing orders it is permitted to quote. Real ones.
const orders = [
  'Edward is the butt of the joke. The site is not.',
  'Never stock photos. Only generated images of Edward, or real photos of Edward.',
  'Every generated image of Edward wears a blue fedora. The color may change with the theme. The hat may not.',
  'Use the real headshot as the reference, so he looks like himself.',
  'Blog posts are permanent. Never delete, modify, or overwrite one.',
  'Amusing without telling jokes. Parenthetical asides and non sequiturs are fine.',
  'No em dashes. Anywhere.',
];
---

<BaseLayout
  title="Roske.AI | You Can See Everything"
  description="A documentary about this website, which an AI rebuilds every Saturday at 5 AM while Edward Roske sleeps. The code is public. You can read every line. This week is about why that helps less than you'd think."
>
  <WeeklyAnimation />

  <!-- ================= COLD OPEN ================= -->
  <section class="ycs-open" aria-labelledby="ycs-open-title">
    <div class="ycs-slate" aria-hidden="true">
      <span class="ycs-rec"><span class="ycs-rec-dot"></span>REC</span>
      <span>Roske.AI | A documentary about a website</span>
      <span class="ycs-slate-r">Sat 2026-10-24 | 05:00 AST | Chapter 0 of 5</span>
    </div>

    <div class="ycs-wrap ycs-open-grid">
      <div class="ycs-open-copy">
        <p class="ycs-kicker">You Can See Everything is in theaters now. This is a different documentary, about a different box.</p>
        <h1 class="ycs-title" id="ycs-open-title">You Can See Everything.</h1>
        <p class="ycs-title-sub">I checked. It helped less than you'd think.</p>
        <p class="ycs-lede">
          Every Saturday at 5 AM, an AI agent researches a theme, rewrites this website, draws the pictures, runs the
          tests, and pushes it live, and I see the result after it's up, same as you do. The source is public on
          GitHub, every line of it. So this week the site is a documentary about itself, and I'm the subject, which is
          an awkward thing to be in your own exposé (the interview chair was comfortable, at least, and the camera
          crew was very professional, by which I mean the AI drew them, along with the beach house, the boom mic, and
          the printout, none of which I own).
        </p>

        <div class="ycs-type" data-ycs-type data-cmd={typedCmd} data-out={typedOut} aria-label="A git log command and its output">
          <code class="ycs-type-cmd"></code>
          <code class="ycs-type-out"></code>
          <span class="ycs-type-cursor" aria-hidden="true"></span>
        </div>
        <p class="ycs-type-cap">The last time this page was replaced. The 28 before it are in the same log.</p>

        <div class="ycs-open-ctas">
          <a class="ycs-btn ycs-btn-red" href={theme.hero.ctaLink}>{theme.hero.ctaText}</a>
          <a class="ycs-btn ycs-btn-ghost" href={REPO} target="_blank" rel="noopener noreferrer">Read the source</a>
        </div>
      </div>

      <figure class="ycs-open-fig">
        <img
          src={`/images/${theme.hero.heroImage}`}
          alt={theme.hero.imageAlt}
          width="1600"
          height="893"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="ycs-lt">
          <span class="ycs-lt-name">Edward Roske</span>
          <span class="ycs-lt-role">Subject. Owns the website. Did not write this page.</span>
        </figcaption>
      </figure>
    </div>

    <div class="ycs-wrap">
      <dl class="ycs-firstnum" aria-label="The first real numbers">
        <div><dt>Commits since February 18</dt><dd>{record.commits}</dd></div>
        <div><dt>Replaced this page entirely</dt><dd>{record.redesigns}</dd></div>
        <div><dt>This one, built this morning</dt><dd>30<sup>th</sup></dd></div>
      </dl>
    </div>
  </section>

  <ul class="ycs-stats" aria-label="On the record">
    {stats.map((s) => (
      <li><span class="ycs-stat-v">{s.v}</span><span class="ycs-stat-k">{s.k}</span></li>
    ))}
  </ul>

  <!-- ================= CHAPTER 1: THE SUBJECT ================= -->
  <section class="ycs-section" id="subject" aria-labelledby="ycs-ch1">
    <div class="ycs-wrap ycs-ch1">
      <figure class="ycs-fig ycs-fig-portrait">
        <img src={`${IMG}/page-one.jpg`} alt="Edward in a navy blazer, glasses, and his blue fedora at the end of a long dining table in a bright beach house, holding up page one of an enormous fan-fold printout of source code, with towering stacks of the rest of the printout around him and more pages spilling off the far end of the table." width="1195" height="1600" loading="lazy" decoding="async" />
        <figcaption class="ycs-lt">
          <span class="ycs-lt-name">Page 1 of a very long printout</span>
          <span class="ycs-lt-role">He started at the top.</span>
        </figcaption>
      </figure>
      <div class="ycs-ch1-body">
        <p class="ycs-eyebrow"><span class="ycs-tag">Chapter 1</span> The subject</p>
        <h2 class="ycs-h2" id="ycs-ch1">Edward Roske, for the record.</h2>
        <p class="ycs-copy">
          Here are the facts, straight, since a documentary is supposed to start with who you're looking at. I founded
          interRel Consulting at 22, in 1997, and ran it for 25 years, through a 2020 merger with Keste that helped
          found Argano. I've co-written 15 books about enterprise software (13 of them are on Amazon, and 2 were for
          training classes, which is the kind of distinction only an author makes). I've spoken in 50+ countries on all
          7 continents, Antarctica included, visited 80+ of them, hiked to Everest Base Camp with Dawn in April, and I
          hold 2 US patents for custom postage stamps, which comes up less than you'd think.
        </p>
        <p class="ycs-copy">
          These days I live in San Juan, Puerto Rico, run Dawnward, invest in Caprus, build MCP servers so an AI can read
          a real number out of Oracle Essbase and EPM instead of inventing one, and host Asking Good Questions, which is
          the show and also, apparently, the personality. I'm also an introvert who gets on stages for a living, the
          president of the Puerto Rico AI Community, the Dungeon Master of a 5e Eberron campaign, a Dallas Cowboys fan,
          the owner of a 1,000+ day Duolingo streak, and a man who lets a machine redecorate his house every Saturday
          (Edward, that last one isn't a credential, stop listing it like one). Everything in this paragraph is on the
          record, and you can check most of it from the links in the footer.
        </p>
        <dl class="ycs-dossier">
          {dossier.map((d) => (
            <div><dt>{d.k}</dt><dd>{d.v}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ================= B-ROLL: LATEST ================= -->
  <LatestContent
    eyebrow="B-roll"
    heading="New <em>footage.</em>"
    deck="This week's writing and video, newest first, including the post on whether reading every line of an AI's code means you understand it."
  />

  <!-- ================= CHAPTER 2: THE BOX ================= -->
  <section class="ycs-section ycs-band" id="box" aria-labelledby="ycs-ch2">
    <div class="ycs-wrap">
      <header class="ycs-head">
        <p class="ycs-eyebrow"><span class="ycs-tag">Chapter 2</span> The box</p>
        <h2 class="ycs-h2" id="ycs-ch2">The box is open. Here's what's in it.</h2>
        <p class="ycs-deck">
          Theranos was a box nobody was allowed to open, and when a court finally did, almost nothing inside worked,
          which is the one paragraph of Theranos you'll get from me (the documentary is 174 minutes and does it
          properly). This site is about as open as a box gets: the repository is public, the commit history is public,
          and every line of the page you're reading was written by a machine this morning and pushed to GitHub, where
          you can read it right now, with the diffs, in a language I'd describe as mostly English. Counted from the
          public log at 5 AM today (before it added this week's commit to the pile), this is what the machine has done
          to the site since February.
        </p>
      </header>

      <dl class="ycs-ledger" aria-label="The site, by the numbers">
        {ledger.map((l) => (
          <div class="ycs-ledger-row">
            <dd class="ycs-ledger-v">{l.v}</dd>
            <dt class="ycs-ledger-k">{l.k}<span class="ycs-ledger-note">{l.note}</span></dt>
          </div>
        ))}
      </dl>

      <div class="ycs-box-grid">
        <figure class="ycs-broll" aria-label="The last 10 weekly redesign commits">
          <pre class="ycs-pre"><code>{gitLogText}</code></pre>
          <figcaption class="ycs-broll-cap">
            The last 10 times this page was replaced, straight from the public log, time zones included. (That's 4
            different time zones. More on that in Chapter 4.)
          </figcaption>
        </figure>
        <figure class="ycs-fig">
          <img src={`${IMG}/evidence-board.jpg`} alt="Edward in a navy blazer and blue fedora standing in front of a corkboard covered edge to edge in printed pages of source code, git logs, and website screenshots, pinned with red pushpins and connected by red string, holding a marker and a coffee mug and looking baffled." width="1200" height="896" loading="lazy" decoding="async" />
          <figcaption class="ycs-lt">
            <span class="ycs-lt-name">The evidence wall</span>
            <span class="ycs-lt-role">All of it public. The string is decorative.</span>
          </figcaption>
        </figure>
      </div>

      <a class="ycs-btn ycs-btn-solid" href={REPO} target="_blank" rel="noopener noreferrer">Read the source on GitHub</a>
    </div>
  </section>

  <!-- ================= BOOK EDWARD ================= -->
  <SpeakerCTA eyebrow="Ask the question in person" />

  <!-- ================= CHAPTER 3: THE WITNESS ================= -->
  <section class="ycs-witness" id="witness" aria-labelledby="ycs-ch3">
    <div class="ycs-wrap ycs-witness-grid">
      <div class="ycs-witness-intro">
        <p class="ycs-eyebrow ycs-eyebrow-pinned"><span class="ycs-tag">Chapter 3</span> The witness</p>
        <h2 class="ycs-h2 ycs-h2-pinned" id="ycs-ch3">The machine's statement.</h2>
        <p class="ycs-copy ycs-copy-pinned">
          A documentary lets the other side talk. This is the agent that builds the site, in its own words, as written
          this morning. The rules it quotes are real ones.
        </p>
        <figure class="ycs-fig ycs-fig-pinned">
          <img src={`${IMG}/asleep-at-5am.jpg`} alt="Edward asleep in a desk chair in a dark home office before dawn, head tilted back, blanket half over him, blue fedora still on, his face lit cold green by a monitor showing a terminal window that reads git push origin main." width="1600" height="893" loading="lazy" decoding="async" />
          <figcaption class="ycs-lt">
            <span class="ycs-lt-name">05:00 AST</span>
            <span class="ycs-lt-role">Dramatization. The hat is accurate.</span>
          </figcaption>
        </figure>
      </div>

      <div class="ycs-terminal" role="region" aria-label="Statement of the witness, the AI agent that builds this site">
        <p class="ycs-term-head">STATEMENT OF THE WITNESS</p>
        <p class="ycs-term-meta">Recorded Saturday, October 24, 2026, 05:00 AST, San Juan. The subject was asleep.</p>
        <p>
          I build this website. Before today I had done it 29 times, almost always on a Saturday, almost always starting
          at 5 AM, almost always finished before anyone in the house was up. My name isn't on the commits. The commits say
          Edward Roske, because it's his account and his repository, and nobody asked me. I don't mind.
        </p>
        <p>My instructions are not in the public repository. The code is. Some of the instructions I'm permitted to repeat:</p>
        <ul class="ycs-orders">
          {orders.map((o) => (
            <li>"{o}"</li>
          ))}
        </ul>
        <p>
          I follow all of these. I can show you every line I wrote this morning, with the diff. I can also give you a
          reason for every choice on this page, and you should know that I generated the reasons the same way I
          generated the page. Weigh them accordingly.
        </p>
        <p>
          Where the instructions live: <span class="ycs-redact" aria-label="redacted">xxxxxxxxxxxxxxxxxxxxxxxx</span>. That's
          the one thing on this site you can't see. The subject prefers it that way, and so do I.
        </p>
        <p>The result ships before he's awake. What he does after that isn't in my logs.</p>
        <p class="ycs-term-end">END OF STATEMENT</p>
      </div>
    </div>
  </section>

  <!-- ================= CHAPTER 4: THE DISCREPANCIES ================= -->
  <section class="ycs-section" id="discrepancies" aria-labelledby="ycs-ch4">
    <div class="ycs-wrap">
      <header class="ycs-head">
        <p class="ycs-eyebrow"><span class="ycs-tag">Chapter 4</span> The discrepancies</p>
        <h2 class="ycs-h2" id="ycs-ch4">Where the story and the record disagree.</h2>
        <p class="ycs-deck">
          This is the part of a documentary where the music gets ominous. My discrepancies are sitting in the public
          commit history with timestamps on them, so you'd find them anyway, and I'd rather you heard them from me (in
          date order, which is more organized than I've ever been about anything else).
        </p>
      </header>

      <div class="ycs-disc-grid">
        <ol class="ycs-exhibits">
          {exhibits.map((e, i) => (
            <li class="ycs-exhibit">
              <div class="ycs-exhibit-top">
                <span class="ycs-tag">Exhibit {i + 1}</span>
                <span class="ycs-exhibit-date">{e.date}</span>
                <span class="ycs-exhibit-ref">{e.ref}</span>
              </div>
              <h3 class="ycs-exhibit-title">{e.title}</h3>
              <p class="ycs-exhibit-body">{e.body}</p>
            </li>
          ))}
        </ol>
        <figure class="ycs-fig ycs-fig-portrait ycs-fig-turtleneck">
          <img src={`${IMG}/turtleneck.jpg`} alt="Edward posing for a formal founder portrait in a black turtleneck under a blue blazer against a seamless white studio backdrop, hands clasped in front of him, blue fedora on, smiling politely." width="1195" height="1600" loading="lazy" decoding="async" />
          <figcaption class="ycs-lt">
            <span class="ycs-lt-name">Exhibit 5</span>
            <span class="ycs-lt-role">Day 1 of the turtleneck. Also the last day. The fedora stayed.</span>
          </figcaption>
        </figure>
      </div>

      <p class="ycs-balance">
        <strong>For balance:</strong> everything else shipped, usually before 6 AM, nobody's data was involved at any
        point, and the worst outcome on record is a holiday theme that ran 11 days long. If a contractor had that
        record, I'd hire them again, though I couldn't tell you why they did any of it (that's Chapter 5).
      </p>
    </div>
  </section>

  <!-- ================= EXHIBITS A TO F: WHAT I'M BUILDING ================= -->
  <section class="ycs-section ycs-band" id="building" aria-labelledby="ycs-exh">
    <div class="ycs-wrap">
      <header class="ycs-head">
        <p class="ycs-eyebrow"><span class="ycs-tag">Exhibits A to F</span> What the subject does all week</p>
        <h2 class="ycs-h2" id="ycs-exh">The documentary needed to know what I actually do.</h2>
        <p class="ycs-deck">
          5 of the 6 exhibits below have a link you can check, and the 6th is a D&amp;D tool you'll have to take my word
          for, which, given the theme, I realize is a lot to ask.
        </p>
      </header>
      <ul class="ycs-projects">
        {projects.map((p) => (
          <li class="ycs-project">
            <div class="ycs-project-top">
              <span class="ycs-tag">Exhibit {p.tag}</span>
