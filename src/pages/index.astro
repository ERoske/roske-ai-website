---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyAnimation from '../components/WeeklyAnimation.astro';
import LatestContent from '../components/LatestContent.astro';
import SpeakerCTA from '../components/SpeakerCTA.astro';
import WhatsNew from '../components/WhatsNew.astro';
import { currentTheme } from '../themes/theme-config';

const theme = currentTheme;

// ---------------------------------------------------------------------------
// WHAT'S UNDER THE MASK? (2026-10-31). Halloween on a Saturday, so the
// rebuild lands on the night itself. Halloween is the one night everyone
// agrees to be something they aren't and announces it. A lot of AI does the
// first part all year. Every costume below is a vendor claim, with what was
// under it and the question that lifts the mask. No vendors are named.
// Edward is the only person in any generated image.
// ---------------------------------------------------------------------------

const IMG = '/images/halloween';
const CAL = 'https://calendar.app.google/udtTerQwcX9Z7QQt7';
const POST = '/blog/is-the-ai-you-just-bought-wearing-a-costume/';
const VANISH = '/blog/your-best-ai-model-can-vanish-over-a-weekend/';

// The 4 standing numbers. Same every week.
const stats = [
  { v: '80+', k: 'Countries visited' },
  { v: '50+', k: 'Countries spoken in' },
  { v: '15', k: 'Books' },
  { v: '25', k: 'Years running interRel' },
];

// The costume parade. No. 1 (the robot) is the hero image.
type Costume = {
  no: number;
  name: string;
  img: string;
  w: number;
  h: number;
  alt: string;
  claim: string;
  under: string;
  ask: string;
  shape: 'tall' | 'wide';
};

const robot = {
  no: 1,
  name: 'The Robot',
  claim: 'A fully autonomous AI agent that handles everything, end to end.',
  under: 'A chatbot on a cron job, plus a guy in a cardboard box who handles everything the chatbot can\'t (which is most things).',
  ask: 'How many people work behind it, and what do they do all day?',
};

const costumes: Costume[] = [
  {
    no: 2,
    name: 'The Fortune Teller',
    img: 'fortune-teller.jpg',
    w: 1195,
    h: 1600,
    alt: 'Edward dressed as a fortune teller in layered fringed shawls and a gold coin scarf, seated at a velvet-draped table with both hands hovering over a glowing crystal ball, tarot cards fanned out and candles dripping wax, his blue fedora wrapped in a sparkly scarf.',
    claim: 'Predictive AI that sees your next quarter before you do.',
    under: 'Last year\'s trend line, extended to the right, with a confidence interval drawn on in pencil.',
    ask: 'What did it predict last year, and how close did it get?',
    shape: 'tall',
  },
  {
    no: 3,
    name: 'The Mummy',
    img: 'mummy.jpg',
    w: 1195,
    h: 1600,
    alt: 'Edward dressed as a mummy, wrapped head to toe in tattered linen bandages with his face showing, arms stiffly forward, in a dim museum gallery beside an open sarcophagus, his blue fedora on top of the bandages.',
    claim: 'Built from the ground up as an AI-native platform.',
    under: 'A system from 2009, wrapped in a chat window. Please don\'t pull on the loose end during the demo.',
    ask: 'What\'s the oldest part of the stack, and when was it written?',
    shape: 'tall',
  },
  {
    no: 4,
    name: 'The Patchwork Monster',
    img: 'stitched-monster.jpg',
    w: 1195,
    h: 1600,
    alt: 'Edward dressed as a patchwork monster in a too-small black jacket with mismatched sleeves, drawn-on stitches across his forehead, pale green face paint, and bolts on his neck, standing in a stone laboratory full of sparking coils, wearing his blue fedora.',
    claim: 'One unified AI platform.',
    under: '4 acquisitions stitched together at the neck, 4 logins, and a sales team that says "seamless" with a straight face.',
    ask: 'Can you show me where the seams are?',
    shape: 'tall',
  },
  {
    no: 5,
    name: 'The Magician',
    img: 'magician.jpg',
    w: 1600,
    h: 1195,
    alt: 'Edward as a stage magician in a black tailcoat and red-lined cape under a single spotlight, lifting an unimpressed white rabbit out of an upturned blue fedora while wearing a second blue fedora on his head.',
    claim: 'Here it is, working live, on real data.',
    under: 'A demo rehearsed 40 times on data picked because it works. The rabbit was in the hat the whole time (in my case it\'s a fedora, which is roomier).',
    ask: 'Can we run it on our data this week, with my people driving?',
    shape: 'wide',
  },
  {
    no: 6,
    name: 'The Vampire',
    img: 'vampire.jpg',
    w: 1195,
    h: 1600,
    alt: 'Edward as a vampire count in a high-collared black cape with crimson lining and plastic fangs, in a candlelit gothic hall, holding up a paper receipt that unrolls all the way to the floor, wearing his blue fedora.',
    claim: 'Pricing that grows with your success.',
    under: 'Per seat, per token, per agent, per month, plus a "premium model" tier somebody turned on in March. It never takes much at once.',
    ask: 'What does the bill look like at 10 times today\'s usage?',
    shape: 'tall',
  },
  {
    no: 7,
    name: 'The Sorcerer',
    img: 'cauldron.jpg',
    w: 1195,
    h: 1600,
    alt: 'Edward as a sorcerer in a long purple robe embroidered with stars, stirring a huge black cauldron of glowing green potion in a candlelit stone cellar, green steam rising, a crow feather in the band of his blue fedora.',
    claim: 'Our secret sauce is proprietary and can\'t be disclosed.',
    under: 'Mostly your data. It goes in the pot, it gets stirred, and nobody at the table can tell you where the ladle goes after that.',
    ask: 'What happens to our data after it goes in the pot?',
    shape: 'tall',
  },
  {
    no: 8,
    name: 'The Zombie',
    img: 'zombie.jpg',
    w: 1600,
    h: 1195,
    alt: 'Edward as a zombie office worker with grey-green makeup, a torn shirt, a loosened tie, and a blank lanyard badge, shuffling through a foggy abandoned office lit by old monitors, a dusty blue fedora on his head.',
    claim: 'A self-learning model that gets smarter every day.',
    under: 'Trained once, in 2024, and it\'s been wandering the halls looking for fresh data ever since (it hasn\'t found any).',
    ask: 'When did it last learn something, and who decided what it learned?',
    shape: 'wide',
  },
  {
    no: 9,
    name: 'The Ventriloquist',
    img: 'ventriloquist.jpg',
    w: 1600,
    h: 1195,
    alt: 'Edward as a vaudeville ventriloquist on a stool under a spotlight, holding a wooden dummy on his knee. The dummy wears a tiny matching blue fedora and suit, and its mouth is open mid-sentence while Edward\'s lips stay perfectly still.',
    claim: 'Our proprietary AI model.',
    under: 'Somebody else\'s model with a new name painted on the dummy and a very long prompt working the jaw.',
    ask: 'Whose model is it, and what happens to us if they change it over a weekend?',
    shape: 'wide',
  },
  {
    no: 10,
    name: 'The Scarecrow',
    img: 'scarecrow.jpg',
    w: 1195,
    h: 1600,
    alt: 'Edward as a scarecrow in a patched flannel shirt stuffed with straw, propped on a post in a moonlit cornfield with crows on the fence, holding a clipboard and pen, straw sticking out from under his blue fedora.',
    claim: 'A human in the loop on every decision.',
    under: 'A human, technically, propped on a post and approving 400 decisions an hour with a clipboard (the crows have noticed).',
    ask: 'How many decisions does each reviewer see in an hour, and how many do they send back?',
    shape: 'tall',
  },
];

// The flashlight: every question in one place. This is the screenshot.
const questions = [{ name: robot.name, ask: robot.ask }, ...costumes.map((c) => ({ name: c.name, ask: c.ask }))];

// Not in costume: the 6 projects. Same 6 every week, restyled.
const projects = [
  {
    name: 'MCP Servers for Enterprise Finance',
    status: 'Shipping',
    note: `Plumbing so an AI reads the real number out of Oracle Essbase and EPM instead of remembering one that sounds about right. Essbase and EPM Planning have shipped, and Financial Close and Consolidations is in beta.`,
    href: 'https://caprus.ai/agentcube/',
    external: true,
    cta: 'See how it works',
  },
  {
    name: 'Caribbean AI Summit',
    status: 'Happened, October 9 and 10',
    note: `Co-chaired it: 800+ people, 17 countries, 44 speakers, and 6 fire extinguishers Dawn bought at Walmart at 7:30 in the morning. The whole story is on the blog.`,
    href: '/blog/how-many-fire-extinguishers-does-an-ai-summit-need/',
    external: false,
    cta: 'Read the recap',
  },
  {
    name: 'Caprus',
    status: 'Investor',
    note: `I'm an investor, and that's the whole job. Lillian Buziak runs it, and they sell and support AgentCube (the first card on this row), which spares everybody from having me do it.`,
    href: 'https://caprus.ai',
    external: true,
    cta: 'Meet the team',
  },
  {
    name: 'Everest Base Camp',
    status: 'Done, April 2026',
    note: `2 weeks on foot to 18,571 feet with Dawn. The trail log is on the blog, including the last 400 feet of Kala Patthar.`,
    href: '/blog/everest-base-camp-summit/',
    external: false,
    cta: 'Read the trail log',
  },
  {
    name: "AI Dungeon Master's Screen",
    status: 'Quiet build',
    note: `A prototype screen for running 5e: lore lookups and improvisation help for the person behind the cardboard. It isn't public yet, and so far the only customer is me (and my players, who didn't get a vote).`,
    href: null,
    external: false,
    cta: 'No public link (take my word for it)',
  },
  {
    name: 'Puerto Rico AI Community',
    status: 'Every other month',
    note: `President of the island's AI community (unpaid, obviously), now past 1,000 different people through the door. Bi-monthly, free, both languages, and the reason the summit exists at all.`,
    href: 'https://praicommunity.org/',
    external: true,
    cta: 'Join the next one',
  },
];
---

<BaseLayout
  title="Roske.AI | What's Under the Mask?"
  description="Halloween on roske.ai: Edward Roske dresses up as 10 AI vendor claims, from the fully autonomous agent to the human in the loop, lifts the mask on each one, and lists the 10 questions to ask before you sign."
>
  <WeeklyAnimation />

  <!-- ================= HERO: THE PORCH ================= -->
  <section class="hw-hero" aria-labelledby="hw-title">
    <svg class="hw-web hw-web-tl" viewBox="0 0 200 200" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M0 0 L200 40 M0 0 L160 120 M0 0 L110 180 M0 0 L40 200" />
        <path d="M30 6 Q 26 22 10 30" />
        <path d="M68 13 Q 58 44 26 64" />
        <path d="M110 22 Q 92 68 44 104" />
        <path d="M156 31 Q 128 92 64 146" />
        <path d="M196 39 Q 160 116 84 190" />
      </g>
    </svg>

    <div class="hw-wrap">
      <p class="hw-slate">
        <span>Saturday, October 31, 2026</span>
        <span>San Juan</span>
        <span>The porch light is on</span>
      </p>
    </div>

    <div class="hw-wrap hw-hero-grid">
      <div class="hw-hero-copy">
        <p class="hw-kicker">
          Halloween is on a Saturday this year, so this website gets rebuilt on the actual day (Edward, it's a website,
          it doesn't know what day it is. Yes, but I do).
        </p>
        <h1 class="hw-title" id="hw-title">What's under the mask?</h1>
        <p class="hw-sub">{theme.hero.subtitle}</p>
        <p class="hw-lede">
          A lot of the AI being sold right now is wearing a costume, and it's been wearing it since about January, so
          I dressed up as 10 of the claims, wrote down what each one says it is, and lifted the
          mask on every one of them (the fedora stayed on for all 10 costumes, because a Roske never removes his
          fedora in the presence of others, and the camera counted as others).
        </p>
        <div class="hw-ctas">
          <a class="hw-btn hw-btn-candle" href={theme.hero.ctaLink}>{theme.hero.ctaText}</a>
          <a class="hw-btn hw-btn-ghost" href="#flashlight">Skip to the 10 questions</a>
        </div>
      </div>

      <figure class="hw-window">
        <div class="hw-window-glow" aria-hidden="true"></div>
        <div class="hw-window-frame">
          <img
            src={`/images/${theme.hero.heroImage}`}
            alt={theme.hero.imageAlt}
            width="1600"
            height="893"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption class="hw-tag hw-tag-hero">
          <span class="hw-tag-hole" aria-hidden="true"></span>
          <span class="hw-tag-no">Costume No. {robot.no} | {robot.name}</span>
          <span class="hw-tag-label">Claims to be</span>
          <span class="hw-tag-claim">{robot.claim}</span>
          <span class="hw-tag-label hw-tag-label-under">Under it</span>
          <span class="hw-tag-under">{robot.under}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ================= STATS: WAX STRIP ================= -->
  <div class="hw-stats-wrap">
    <ul class="hw-stats" aria-label="On the record, no costume">
      {stats.map((s) => (
        <li><span class="hw-stat-v">{s.v}</span><span class="hw-stat-k">{s.k}</span></li>
      ))}
    </ul>
    <svg class="hw-drip" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 0 H1200 V8 C1180 8 1176 30 1166 30 C1156 30 1154 10 1140 10 C1110 10 1104 18 1090 18 C1078 18 1074 36 1062 36 C1050 36 1048 12 1030 12 L960 12 C944 12 942 24 930 24 C918 24 914 10 900 10 L820 10 C806 10 802 34 790 34 C778 34 776 12 760 12 L640 12 C626 12 622 22 612 22 C602 22 598 10 584 10 L500 10 C486 10 482 38 470 38 C458 38 456 12 440 12 L360 12 C346 12 342 26 332 26 C322 26 318 10 304 10 L220 10 C206 10 202 32 190 32 C178 32 176 12 160 12 L90 12 C76 12 72 22 62 22 C52 22 48 8 34 8 L0 8 Z" />
    </svg>
  </div>

  <!-- ================= FRESH FROM THE CAULDRON ================= -->
  <LatestContent
    eyebrow="Fresh from the cauldron"
    heading="New <em>this week.</em>"
    deck="This week's writing and video, newest first, including tonight's post on how to tell whether the AI you just bought is wearing a costume."
  />

  <!-- ================= THE COSTUME PARADE ================= -->
  <section class="hw-section hw-parade" id="costumes" aria-labelledby="hw-parade-title">
    <div class="hw-wrap">
      <header class="hw-head">
        <p class="hw-eyebrow">The costume parade</p>
        <h2 class="hw-h2" id="hw-parade-title">10 costumes, 10 claims, and what was under every one.</h2>
        <p class="hw-deck">
          Every costume here is a claim you can find on some AI vendor's website this week, give or take a buzzword
          (I'm not naming vendors, partly because I'd like to keep getting invited to things, and mostly because the
          point is that it's a lot of them). Each tag has the claim on top, what you find when you pull the mask off
          underneath, and the question I'd ask to get it off at the bottom.
        </p>
      </header>

      <ol class="hw-gallery">
        {costumes.map((c, i) => (
          <li class={`hw-costume hw-costume-${c.shape} hw-tilt-${i % 4}`}>
            <figure class="hw-costume-fig">
              <img src={`${IMG}/${c.img}`} alt={c.alt} width={c.w} height={c.h} loading="lazy" decoding="async" />
            </figure>
            <div class="hw-tag">
              <span class="hw-tag-hole" aria-hidden="true"></span>
              <span class="hw-tag-no">Costume No. {c.no} | {c.name}</span>
              <span class="hw-tag-label">Claims to be</span>
              <p class="hw-tag-claim">{c.claim}</p>
              <span class="hw-tag-label hw-tag-label-under">Under it</span>
              <p class="hw-tag-under">
                {c.under}
                {c.name === 'The Ventriloquist' && (
                  <>
                    {' '}(More on that weekend <a href={VANISH}>here</a>.)
                  </>
                )}
              </p>
              <p class="hw-tag-ask"><span>Ask:</span> {c.ask}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= BOOK EDWARD ================= -->
  <SpeakerCTA eyebrow="No costume required" />

  <!-- ================= THE FLASHLIGHT ================= -->
  <section class="hw-flash" id="flashlight" aria-labelledby="hw-flash-title" data-hw-flash>
    <div class="hw-flash-beam" aria-hidden="true"></div>
    <div class="hw-wrap hw-flash-grid">
      <div class="hw-flash-intro">
        <p class="hw-eyebrow hw-eyebrow-pinned">The flashlight</p>
        <h2 class="hw-h2 hw-h2-pinned" id="hw-flash-title">How do you see what's under the mask?</h2>
        <p class="hw-copy-pinned">
          You don't have to be technical to do this, you just have to be willing to be the person in the meeting who
          asks (I host a show called Asking Good Questions, so I've had more practice than most). Screenshot this, print it, tape it to the
          inside of your portfolio, whatever works.
        </p>
        <figure class="hw-unmask">
          <img
            src={`${IMG}/unmasking.jpg`}
            alt="In a dark hallway lit by a single flashlight beam, Edward pulls a rubbery green monster mask up and off his face, revealing his real face and glasses underneath, while his blue fedora stays firmly on his head."
            width="1600"
            height="893"
            loading="lazy"
            decoding="async"
          />
          <figcaption>The mask came off, and the fedora stayed exactly where it was (family rule).</figcaption>
        </figure>
      </div>

      <ol class="hw-questions">
        {questions.map((q, i) => (
          <li>
            <span class="hw-q-no" aria-hidden="true">{i + 1}</span>
            <div>
              <p class="hw-q">{q.ask}</p>
              <p class="hw-q-src">Lifts the mask on {q.name}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="hw-flash-note">
        If a vendor can answer all 10 without opening a new slide deck, that's a very good sign. If they can't, ask
        again (politely, and maybe write the first answer down so you can compare).
      </p>
    </div>
  </section>

  <!-- ================= NOT IN COSTUME ================= -->
  <section class="hw-section hw-band" id="building" aria-labelledby="hw-real-title">
    <div class="hw-wrap">
      <header class="hw-head">
        <p class="hw-eyebrow">Not in costume</p>
        <h2 class="hw-h2" id="hw-real-title">What I'm actually building, with the mask already off.</h2>
        <p class="hw-deck">
          Same tag format, so it's fair. On all 6 of these, what it claims to be and what's under it are the same
          thing, and 5 of them have a link you can check (the 6th is a D&amp;D tool you'll have to take my word for,
          which, on this particular page, I realize is a lot to ask).
        </p>
      </header>
      <ul class="hw-projects">
        {projects.map((p, i) => (
          <li class="hw-project">
            <div class="hw-project-top">
              <span class="hw-project-no">No. {i + 1}</span>
              <span class="hw-project-status">{p.status}</span>
            </div>
            <h3 class="hw-project-name">{p.name}</h3>
            <p class="hw-project-note">{p.note}</p>
            <p class="hw-project-under"><span>Under it:</span> exactly that.</p>
            {p.href ? (
              <a
                class="hw-project-link"
                href={p.href}
                {...(p.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {p.cta}
              </a>
            ) : (
              <span class="hw-project-link hw-project-link-off">{p.cta}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= ALSO OUT TONIGHT ================= -->
  <WhatsNew
    eyebrow="Spotted around the neighborhood"
    heading="Also <em>out tonight.</em>"
    deck="Interviews, press, and posts from elsewhere, for anyone who'd like a second opinion on who's in costume."
  />

  <!-- ================= TONIGHT'S QUESTION ================= -->
  <section class="hw-section hw-question" aria-labelledby="hw-q-title">
    <div class="hw-wrap hw-question-inner">
      <p class="hw-eyebrow">Tonight's question</p>
      <h2 class="hw-h2 hw-h2-big" id="hw-q-title">Is the AI you just bought wearing a costume?</h2>
      <p class="hw-copy">
        The SEC and Gartner got there before I did. In March 2024 the SEC fined 2 investment advisers a combined $400,000 for
        <a href="https://www.sec.gov/newsroom/press-releases/2024-36" target="_blank" rel="noopener noreferrer">claiming AI they didn't actually use</a>,
        which was the first "AI washing" case it ever brought. Gartner went looking at the thousands of vendors
        selling agentic AI and
        <a href="https://www.gartner.com/en/newsroom/press-releases/2025-06-25-gartner-predicts-over-40-percent-of-agentic-ai-projects-will-be-canceled-by-end-of-2027" target="_blank" rel="noopener noreferrer">counted about 130 that were the real thing</a>
        (it calls the rest "agent washing," which sounds like something you'd do to a costume on November 1).
      </p>
      <p class="hw-copy">
        The longer version, written for whoever has to sign the contract, is <a href={POST}>on the blog</a> tonight (I
        tried to leave the costumes out of it and got about as far as the vampire).
      </p>
    </div>
  </section>

  <!-- ================= THE FRONT DOOR ================= -->
  <section class="hw-door" aria-labelledby="hw-door-title">
    <div class="hw-wrap hw-door-inner">
      <div class="hw-door-frame">
        <span class="hw-door-light" aria-hidden="true"></span>
        <p class="hw-eyebrow hw-eyebrow-pinned">Ring the doorbell</p>
        <h2 class="hw-h2 hw-h2-pinned" id="hw-door-title">Trick, treat, or a keynote?</h2>
        <p class="hw-copy-pinned">
          If you'd like these 10 questions asked out loud to your leadership team, with slides and a fedora, that's
          the speaking page (keynotes from $15,000, costume not included, though I'd consider it). If you'd rather
          just talk, 13 minutes on my calendar is free! Or write me at Edward@Roske.AI and tell me which costume your
          last AI vendor showed up in.
        </p>
        <div class="hw-ctas">
          <a class="hw-btn hw-btn-candle" href="/speaking/">Book the talk</a>
          <a class="hw-btn hw-btn-ghost" href={CAL} target="_blank" rel="noopener noreferrer">Book 13 minutes</a>
          <a class="hw-btn hw-btn-ghost" href="/contact/">Write me</a>
        </div>
      </div>
      <p class="hw-disclaimer">
        Every image of Edward on this page is AI-generated from his real headshot, and he's the only person in any of
        them (the rabbit, the dummy, and the crows are not people). No AI vendor is named anywhere on this page, on
        purpose. The claims are composites of things you can read on a lot of vendor websites, and any resemblance to
        yours is between you and your vendor.
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      var sec = document.querySelector('[data-hw-flash]');
      if (!sec) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!window.matchMedia('(pointer: fine)').matches) return;
      var raf = 0;
      sec.addEventListener('pointermove', function (e) {
        if (raf) return;
        raf = requestAnimationFrame(function () {
          raf = 0;
          var r = sec.getBoundingClientRect();
          sec.style.setProperty('--hw-mx', ((e.clientX - r.left) / r.width) * 100 + '%');
          sec.style.setProperty('--hw-my', ((e.clientY - r.top) / r.height) * 100 + '%');
        });
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  /* =====================================================================
     WHAT'S UNDER THE MASK? (2026-10-31)
     Halloween. Dark mode is the haunted house at midnight; light mode is
     the trick-or-treat porch at dusk. The flashlight section and the
     front door are pinned dark in BOTH modes (you need the dark to see a
     flashlight), so every color inside them is a literal. Everything else
     reads the --hw-* vars, which flip by mode. Global on purpose:
     [data-theme] selectors are unreliable inside Astro's scoped CSS.
     All classes hw-.
     ===================================================================== */
  :root,
  [data-theme="dark"] {
    --hw-bg: #0b0709;
    --hw-surface: #16101a;
    --hw-band: #120b14;
    --hw-ink: #f4eadb;
    --hw-muted: #bbae9f;
    --hw-line: #34263a;
    --hw-candle: #ff8a1f;
    --hw-on-candle: #140a06;
    --hw-green: #b8d63a;
    --hw-purple: #c9a2e0;
    --hw-tag-bg: #efe2c8;
    --hw-tag-ink: #1c1018;
